    "Extra light uses more power, so Overbright steps back on its own. Choose how it starts." : {
      "comment" : "Welcome ▸ Defaults: body under the headline",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستهلك الضوء الإضافي طاقة أكبر، لذا يتراجع Overbright من تلقاء نفسه. اختر كيف يبدأ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La llum extra consumeix més energia, per això l’Overbright es modera tot sol quan cal. Tria com s’ha d’iniciar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Víc světla spotřebuje víc energie, proto se Overbright v případě potřeby sám pozastaví. Zvolte, jak se má spouštět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekstra lys bruger mere strøm, så Overbright skruer selv ned, når det er nødvendigt. Vælg, hvordan den skal starte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusätzliches Licht braucht mehr Energie, daher nimmt sich Overbright von selbst zurück. Wähle, wie es startet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το επιπλέον φως καταναλώνει περισσότερη ενέργεια, γι’ αυτό το Overbright υποχωρεί από μόνο του. Επιλέξτε πώς ξεκινά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luz extra consume más energía, así que Overbright se pausa automáticamente cuando hace falta. Elige cómo se inicia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisävalo kuluttaa enemmän virtaa, joten Overbright vetäytyy tarvittaessa itsestään. Valitse, miten se käynnistyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lumière supplémentaire consomme plus d’énergie : Overbright se met donc en retrait de lui-même. Choisissez comment il démarre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תוספת אור צורכת יותר חשמל, ולכן Overbright משהה את עצמו לפי הצורך. יש לבחור איך הוא יופעל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra light uses more power, so Overbright steps back on its own. Choose how it starts."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatno svjetlo troši više energije, pa se Overbright sam povlači kad treba. Odaberite kako se pokreće."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az extra fény több energiát fogyaszt, ezért az Overbright szükség esetén magától visszavesz. Válassza ki, hogyan induljon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra light uses more power, so Overbright steps back on its own. Choose how it starts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luce extra consuma più energia, quindi Overbright si mette in pausa da solo quando serve. Scegli come si avvia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra light uses more power, so Overbright steps back on its own. Choose how it starts."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra light uses more power, so Overbright steps back on its own. Choose how it starts."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra light uses more power, so Overbright steps back on its own. Choose how it starts."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekstra lys bruker mer strøm, så Overbright trapper ned av seg selv. Velg hvordan den skal starte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra licht kost meer energie, dus Overbright neemt zelf gas terug. Kies hoe het start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatkowe światło zużywa więcej energii, więc Overbright w razie potrzeby sam się wstrzymuje. Wybierz, jak ma się uruchamiać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A luz extra consome mais energia, então o Overbright pausa sozinho quando necessário. Escolha como ele inicia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A luz extra gasta mais energia, por isso o Overbright faz pausas automaticamente quando é necessário. Escolha como deve iniciar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumina suplimentară consumă mai multă energie, așa că Overbright se retrage singur când e nevoie. Alegeți cum pornește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дополнительный свет расходует больше энергии, поэтому Overbright сам приостанавливается, когда это нужно. Выберите, как он будет запускаться."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viac svetla spotrebuje viac energie, preto sa Overbright v prípade potreby automaticky pozastaví. Zvoľte, ako sa má spúšťať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Več svetlobe porabi več energije, zato se Overbright po potrebi sam začasno ustavi. Izberite, kako naj se zažene."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra ljus kräver mer ström, så Overbright drar ner av sig själv när det behövs. Välj hur den ska starta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra light uses more power, so Overbright steps back on its own. Choose how it starts."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ek ışık daha fazla güç harcar; bu yüzden Overbright gerektiğinde kendiliğinden geri çekilir. Nasıl başlayacağını seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додаткове світло витрачає більше енергії, тому Overbright сам призупиняється, коли це потрібно. Виберіть, як він запускатиметься."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra light uses more power, so Overbright steps back on its own. Choose how it starts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra light uses more power, so Overbright steps back on its own. Choose how it starts."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra light uses more power, so Overbright steps back on its own. Choose how it starts."
          }
        }
      }
    },
