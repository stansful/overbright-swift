    "It also backs off when your Mac gets warm." : {
      "comment" : "Welcome ▸ Defaults: note under the switches (extra brightness is limited by heat)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويتراجع أيضًا عندما يسخن جهاز Mac."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "També es modera quan el Mac s’escalfa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jas sníží také, když se Mac zahřeje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den skruer også ned, når din Mac bliver varm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es nimmt sich auch zurück, wenn dein Mac warm wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υποχωρεί επίσης όταν το Mac σας ζεσταίνεται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También reduce el brillo cuando el Mac se calienta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
