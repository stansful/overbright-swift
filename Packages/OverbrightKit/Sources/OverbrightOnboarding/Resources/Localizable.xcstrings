    "Overbright asks GitHub once a day. Nothing else is sent." : {
      "comment" : "Welcome ▸ Done: note under the update check switch",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل Overbright بموقع GitHub مرة واحدة يوميًا. ولا يُرسل أي شيء آخر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Overbright consulta el GitHub un cop al dia. No s’envia res més."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright se jednou denně zeptá GitHubu. Nic dalšího se neodesílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright spørger GitHub én gang om dagen. Der sendes ikke andet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright fragt einmal täglich bei GitHub an. Sonst wird nichts gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Overbright επικοινωνεί με το GitHub μία φορά την ημέρα. Δεν αποστέλλεται τίποτε άλλο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright consulta GitHub una vez al día. No se envía nada más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright kysyy GitHubilta kerran päivässä. Mitään muuta ei lähetetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright interroge GitHub une fois par jour. Rien d’autre n’est envoyé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעם ביום Overbright פונה ל-GitHub. שום דבר אחר לא נשלח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright दिन में एक बार GitHub से पूछता है। और कुछ नहीं भेजा जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright provjerava GitHub jednom dnevno. Ništa se drugo ne šalje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Overbright naponta egyszer lekérdezi a GitHubot. Semmi mást nem küld."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright menghubungi GitHub sekali sehari. Tidak ada data lain yang dikirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright contatta GitHub una volta al giorno. Non viene inviato nient’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbrightは1日に1回GitHubに問い合わせます。それ以外の情報は送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright는 하루에 한 번 GitHub에 확인합니다. 그 외에는 아무것도 전송되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright menyemak GitHub sekali sehari. Tiada apa-apa lagi yang dihantar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright spør GitHub én gang om dagen. Ingenting annet sendes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright vraagt GitHub één keer per dag om updates. Er wordt niets anders verstuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
