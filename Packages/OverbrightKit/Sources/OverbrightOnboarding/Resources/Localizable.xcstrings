          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaš zaslon može prikazati svjetlo jače od obične bijele. Overbright omogućuje svakodnevnom sadržaju da koristi tu rezervu, pa zaslon ostaje čitljiv u svijetloj prostoriji ili na suncu. Za najviše svjetla najprije povećajte svjetlinu zaslona do kraja; Overbright dodaje svjetlo povrh nje. Povucite razdjelnik za usporedbu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Your display can show light brighter than ordinary white. Overbright lets everyday content use that range, so the screen stays readable in a bright room or in sunlight. For the most light, turn your display brightness all the way up first; Overbright adds to it. Drag the divider to compare."
          }
