    "Overbright is still starting. Try again in a moment." : {
      "comment" : "Shortcuts app: error when an action runs before Overbright finished starting (5 s).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال Overbright قيد البدء. حاول مرة أخرى بعد قليل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Overbright encara s’està iniciant. Torna‑ho a provar d’aquí a un moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright se ještě spouští. Zkuste to za chvíli znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright er stadig ved at starte. Prøv igen om et øjeblik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright wird noch gestartet. Versuche es gleich noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Overbright δεν έχει ξεκινήσει ακόμα. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright todavía se está iniciando. Vuelve a intentarlo en un momento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright käynnistyy vielä. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright est encore en cours de démarrage. Réessayez dans un instant."
