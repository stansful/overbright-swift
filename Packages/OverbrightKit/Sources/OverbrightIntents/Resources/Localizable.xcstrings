    "Overbright is still starting. Try again in a moment." : {
      "comment" : "Shortcuts app: error when an action runs before Overbright finished starting (5 s).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال Overbright قيد البدء. حاول مرة أخرى بعد قليل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Overbright encara s’està iniciant. Torna‑ho a provar d’aquí a un moment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright se ještě spouští. Zkuste to za chvíli znovu."
