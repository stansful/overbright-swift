    "To show it, turn on Overbright under Allow in the Menu Bar in Menu Bar settings." : {
      "comment" : "Menu bar icon window: second sentence on macOS 26 and later",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لإظهاره، شغّل Overbright ضمن \"السماح في شريط القوائم\" في إعدادات \"شريط القوائم\"."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per mostrar‑la, activa l’Overbright a “Permet a la barra de menús”, a la secció Barra de menús de la configuració del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete‑li ji zobrazit, zapněte Overbright v seznamu Povolit v řádku nabídek v nastavení Řádek nabídek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan vise det ved at slå Overbright til under “Tillad på menulinjen” i indstillingerne til Menulinje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um es anzuzeigen, aktiviere Overbright in den Systemeinstellungen unter „Menüleiste“ bei „In Menüleiste erlauben“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να εμφανιστεί, ενεργοποιήστε το Overbright στην ενότητα «Να επιτρέπεται στη γραμμή μενού» των ρυθμίσεων «Γραμμή μενού»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mostrarlo, activa Overbright en “Permitir en la barra de menús”, en los ajustes de “Barra de menús”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat sen näkyviin laittamalla Overbrightin päälle kohdassa ”Salli valikkorivillä” Valikkorivi-asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour l’afficher, activez Overbright sous « Autoriser dans la barre des menus » dans les réglages Barre des menus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי שתוצג, יש להפעיל את Overbright תחת ״הצגה בשורת התפריטים״ בהגדרות ״שורת התפריטים״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे दिखाने के लिए, मेन्यू बार सेटिंग में “मेन्यू बार में अनुमति दें” के अंतर्गत Overbright चालू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da biste je prikazali, uključite Overbright pod “Dozvoli u traci s izbornicima” u odjeljku Traka s izbornicima u Postavkama sustava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megjelenítéséhez kapcsolja be az Overbrightot az „Engedélyezés a menüsoron” alatt a Rendszerbeállítások Menüsor részében."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menampilkannya, nyalakan Overbright di bawah “Izinkan di Bar Menu” di pengaturan Bar Menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per mostrarla, attiva Overbright in “Consenti nella barra dei menu” nelle impostazioni “Barra dei menu”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示するには、“メニューバー”設定の“メニューバーに追加することを許可”でOverbrightをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이콘을 보려면 ‘메뉴 막대’ 설정의 ‘메뉴 막대에서 허용’에서 Overbright를 켜십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menunjukkannya, hidupkan Overbright di bawah “Benarkan dalam Bar Menu” dalam seting Bar Menu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å vise det, slå på Overbright under «Tillat i menylinjen» i Menylinje-innstillingene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om het symbool te tonen, schakel je Overbright in bij ‘Sta toe in de menubalk’ in de instellingen voor ‘Menubalk’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby była widoczna, włącz Overbright na liście „Pozwalaj na pasku menu” w ustawieniach „Pasek menu”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mostrá-lo, ative o Overbright em Permitir na Barra de Menus, nos ajustes de Barra de Menus."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para o mostrar, ative o Overbright em “Permitir na barra de menus”, nas definições da Barra de menus."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a o afișa, activați Overbright la „Permiteți în bara de meniu”, în secțiunea Bară de meniu din Configurări sistem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы он появился, включите Overbright в списке «Разрешить в строке меню» в разделе «Строка меню» Системных настроек."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak ju chcete zobraziť, zapnite Overbright v časti Povoliť položky v lište v nastaveniach Lišta."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če jo želite prikazati, v nastavitvah Menijska vrstica vklopite Overbright pod »Dovoljeno v menijski vrstici«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa den genom att slå på Overbright under ”Tillåt i menyraden” i inställningarna för Menyrad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการให้แสดง ให้เปิด Overbright ใต้ “อนุญาตในแถบเมนู” ในการตั้งค่าแถบเมนู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görünmesi için Menü Çubuğu ayarlarında “Menü Çubuğunda İzin Ver” altında Overbright’ı açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб він зʼявився, увімкніть Overbright у списку «Дозволити на смузі меню» в розділі «Смуга меню» Системних параметрів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để hiển thị biểu tượng, hãy bật Overbright trong mục “Cho phép trong thanh menu” ở cài đặt Thanh menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要显示图标，请在“菜单栏”设置的“允许在菜单栏显示”中开启Overbright。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要顯示圖像，請在「選單列」設定的「在選單列中允許」下方開啟Overbright。"
          }
        }
      }
    },
