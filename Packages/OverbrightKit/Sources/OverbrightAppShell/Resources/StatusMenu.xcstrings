    "To show it, turn on Overbright under Allow in the Menu Bar in Menu Bar settings." : {
      "comment" : "Menu bar icon window: second sentence on macOS 26 and later",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To show it, turn on Overbright under Allow in the Menu Bar in Menu Bar settings."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per mostrar‑la, activa l’Overbright a “Permet a la barra de menús”, a la secció Barra de menús de la configuració del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete‑li ji zobrazit, zapněte Overbright v seznamu Povolit v řádku nabídek v nastavení Řádek nabídek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan vise det ved at slå Overbright til under “Tillad på menulinjen” i indstillingerne til Menulinje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um es anzuzeigen, aktiviere Overbright in den Systemeinstellungen unter „Menüleiste“ bei „In Menüleiste erlauben“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To show it, turn on Overbright under Allow in the Menu Bar in Menu Bar settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mostrarlo, activa Overbright en “Permitir en la barra de menús”, en los ajustes de “Barra de menús”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To show it, turn on Overbright under Allow in the Menu Bar in Menu Bar settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour l’afficher, activez Overbright sous « Autoriser dans la barre des menus » dans les réglages Barre des menus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To show it, turn on Overbright under Allow in the Menu Bar in Menu Bar settings."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To show it, turn on Overbright under Allow in the Menu Bar in Menu Bar settings."
