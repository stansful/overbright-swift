    "Overbright couldn’t be moved. Drag it to the Applications folder in Finder." : {
      "comment" : "Move to Applications alert: the move failed",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر نقل Overbright. اسحبه إلى مجلد \"التطبيقات\" في فايندر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s’ha pogut moure l’Overbright. Arrossega’l a la carpeta Apps al Finder."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright se nepodařilo přesunout. Přetáhněte ho do složky Aplikace ve Finderu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright kunne ikke flyttes. Træk appen til mappen Apps i Finder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright konnte nicht verschoben werden. Ziehe es im Finder in den Ordner „Programme“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η μετακίνηση του Overbright. Σύρετέ το στον φάκελο «Εφαρμογές» στο Finder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido mover Overbright. Arrástralo a la carpeta Aplicaciones en el Finder."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbrightia ei voitu siirtää. Vedä se Finderissa Apit-kansioon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
