    "Not calibrated. Numbers are estimates, and Overbright uses a safe default." : {
      "comment" : "Verdict advisory: the display has no valid calibration",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير معايرة. الأرقام تقديرية، ويستخدم Overbright قيمة افتراضية آمنة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sense calibrar. Els valors són estimacions i l’Overbright fa servir un valor per omissió prudent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitor není kalibrovaný. Hodnoty jsou odhady a Overbright používá bezpečné výchozí nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke kalibreret. Tallene er skøn, og Overbright bruger en sikker standardværdi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht kalibriert. Die Werte sind Schätzungen, und Overbright verwendet einen sicheren Standardwert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μη βαθμονομημένη. Οι τιμές είναι εκτιμήσεις και το Overbright χρησιμοποιεί μια ασφαλή προεπιλεγμένη τιμή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin calibrar. Los valores son estimaciones y Overbright usa un valor predeterminado prudente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei kalibroitu. Luvut ovat arvioita, ja Overbright käyttää varovaista oletusarvoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non calibré. Les valeurs sont des estimations et Overbright utilise une valeur par défaut prudente."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא מכויל. הערכים משוערים, ו-Overbright משתמש בברירת מחדל בטוחה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैलिब्रेट नहीं किया गया। संख्याएँ अनुमानित हैं, और Overbright एक सुरक्षित डिफ़ॉल्ट इस्तेमाल करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nije kalibriran. Brojke su procjene, a Overbright koristi sigurnu standardnu vrijednost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs kalibrálva. A számok becslések, és az Overbright biztonságos alapértelmezett értéket használ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum dikalibrasi. Angka hanya perkiraan, dan Overbright menggunakan default yang aman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non calibrato. I valori sono stime e Overbright usa un’impostazione predefinita prudente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャリブレーションされていません。数値は推定値で、Overbrightは安全なデフォルト値を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보정되지 않았습니다. 수치는 추정값이며 Overbright는 안전한 기본값을 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum dikalibrasi. Nombor ialah anggaran dan Overbright menggunakan lalai yang selamat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke kalibrert. Tallene er anslag, og Overbright bruker en forsiktig standardverdi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet gekalibreerd. Waarden zijn schattingen en Overbright gebruikt een veilige standaardwaarde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieskalibrowany. Wartości są szacunkowe, a Overbright używa bezpiecznej wartości domyślnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não calibrada. Os valores são estimativas, e o Overbright usa uma configuração padrão cautelosa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não calibrado. Os valores são estimativas e o Overbright usa um valor predefinido seguro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necalibrat. Valorile sunt estimări, iar Overbright folosește o valoare implicită sigură."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисплей не откалиброван. Значения приблизительные, а Overbright использует безопасную настройку по умолчанию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displej nie je kalibrovaný. Hodnoty sú odhady a Overbright používa bezpečné predvolené nastavenie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaslon ni umerjen. Vrednosti so ocene, Overbright pa uporablja varno privzeto nastavitev."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte kalibrerad. Siffrorna är uppskattningar och Overbright använder ett säkert förval."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่ได้ปรับเทียบ ตัวเลขเป็นค่าประมาณ และ Overbright ใช้ค่าเริ่มต้นที่ปลอดภัย"
