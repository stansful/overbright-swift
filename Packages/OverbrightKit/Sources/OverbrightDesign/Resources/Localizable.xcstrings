        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozastaveno, protože aplikace %@ mění barvy monitoru. Teplé světlo bez konfliktu nabízí Night Shift."
          }
        },
        "da" : {
          "stringUnit" : {
