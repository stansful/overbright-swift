    "%@ changed the colors of a display, so Overbright stopped there." : {
      "comment" : "Panel: banner after an app changed the colors of a display whose name is unknown",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غيّر التطبيق \"%@\" ألوان إحدى الشاشات، لذا توقف Overbright عليها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
