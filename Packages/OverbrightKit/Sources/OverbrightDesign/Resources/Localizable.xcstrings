    "Paused because %@ also changes display brightness. Quit it, or use Compatibility mode, which works alongside it." : {
      "comment" : "Panel: banner while another brightness app runs; the argument is its name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Paused because %@ also changes display brightness. Quit it, or use Compatibility mode, which works alongside it."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa perquè l’app %@ també canvia la brillantor de la pantalla. Surt‑ne o fes servir el mode de compatibilitat, que funciona al seu costat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozastaveno, protože aplikace %@ také mění jas monitoru. Ukončete ji, nebo použijte režim kompatibility, který s ní funguje souběžně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sat på pause, fordi %@ også ændrer skærmens lysstyrke. Slut den, eller brug kompatibilitetstilstand, som fungerer sammen med den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert, weil „%@“ ebenfalls die Displayhelligkeit ändert. Beende die App oder nutze den Kompatibilitätsmodus, der parallel dazu funktioniert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Paused because %@ also changes display brightness. Quit it, or use Compatibility mode, which works alongside it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa porque %@ también cambia el brillo de la pantalla. Ciérrala o usa el modo de compatibilidad, que funciona junto a ella."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Paused because %@ also changes display brightness. Quit it, or use Compatibility mode, which works alongside it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause, car « %@ » modifie aussi la luminosité de l’écran. Quittez cette app ou utilisez le mode de compatibilité, qui fonctionne en parallèle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Paused because %@ also changes display brightness. Quit it, or use Compatibility mode, which works alongside it."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
