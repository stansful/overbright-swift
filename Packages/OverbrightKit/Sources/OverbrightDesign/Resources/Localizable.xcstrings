    "%@ can change display colors in some modes. If it does, Overbright stops on this display." : {
      "comment" : "Panel ▸ Display card: popover of ‹App› may interfere",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يغيّر التطبيق \"%@\" ألوان الشاشة في بعض الأوضاع. وإذا حدث ذلك، يتوقف Overbright على هذه الشاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app %@ pot canviar els colors de la pantalla en alguns modes. Si ho fa, l’Overbright s’atura en aquesta pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace %@ může v některých režimech měnit barvy monitoru. Pokud to udělá, Overbright se na tomto monitoru zastaví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan ændre skærmfarverne i visse tilstande. Hvis det sker, stopper Overbright på denne skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann in manchen Modi die Displayfarben ändern. Falls das passiert, stoppt Overbright auf diesem Display."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή «%@» μπορεί να αλλάζει τα χρώματα της οθόνης σε ορισμένες λειτουργίες. Αν συμβεί αυτό, το Overbright σταματά σε αυτήν την οθόνη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ puede cambiar los colores de la pantalla en algunos modos. Si lo hace, Overbright se detendrá en esta pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appi %@ voi muuttaa näytön värejä joissakin tiloissa. Jos niin käy, Overbright pysähtyy tällä näytöllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » peut modifier les couleurs de l’écran dans certains modes. Si c’est le cas, Overbright s’arrête sur cet écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייתכן ש-%@ ישנה את צבעי הצג במצבים מסוימים. אם זה יקרה, Overbright יפסיק לפעול בצג הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ कुछ मोड में डिस्प्ले के रंग बदल सकता है। ऐसा होने पर Overbright इस डिस्प्ले पर काम करना बंद कर देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija %@ u nekim načinima rada može mijenjati boje zaslona. Ako to učini, Overbright će se zaustaviti na ovom zaslonu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ egyes módokban módosíthatja a kijelző színeit. Ha ez történik, az Overbright leáll ezen a kijelzőn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dapat mengubah warna layar dalam beberapa mode. Jika itu terjadi, Overbright berhenti di layar ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ può modificare i colori dello schermo in alcune modalità. In tal caso, Overbright si interrompe su questo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”は一部のモードでディスプレイの色を変更することがあります。その場合、Overbrightはこのディスプレイで停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’은(는) 일부 모드에서 디스플레이 색상을 변경할 수 있습니다. 이 경우 Overbright는 이 디스플레이에서 중지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ boleh menukar warna paparan dalam sesetengah mod. Jika ini berlaku, Overbright berhenti pada paparan ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan endre skjermfargene i noen moduser. Hvis det skjer, stopper Overbright på denne skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan in sommige modi de beeldschermkleuren wijzigen. Als dat gebeurt, stopt Overbright op dit beeldscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja %@ w niektórych trybach może zmieniać kolory wyświetlacza. Jeśli to zrobi, Overbright zatrzyma się na tym wyświetlaczu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app %@ pode alterar as cores da tela em alguns modos. Se isso acontecer, o Overbright será interrompido nesta tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aplicação %@ pode alterar as cores do monitor em alguns modos. Se o fizer, o Overbright para neste monitor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ poate modifica culorile afișajului în anumite moduri. Dacă se întâmplă asta, Overbright se oprește pe acest afișaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение «%@» в некоторых режимах может менять цвета дисплея. Если это произойдёт, Overbright остановится на этом дисплее."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apka %@ môže v niektorých režimoch meniť farby displeja. Ak sa to stane, Overbright sa na tomto displeji zastaví."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija %@ lahko v nekaterih načinih spreminja barve zaslona. Če se to zgodi, se Overbright na tem zaslonu ustavi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan ändra skärmfärgerna i vissa lägen. Om det händer stoppar Overbright på den här skärmen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ อาจเปลี่ยนสีจอภาพได้ในบางโหมด หากเกิดขึ้น Overbright จะหยุดทำงานบนจอภาพนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bazı modlarda ekran renklerini değiştirebilir. Değiştirirse Overbright bu ekranda durur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма «%@» у деяких режимах може змінювати кольори дисплея. Якщо це станеться, Overbright зупиниться на цьому дисплеї."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ có thể thay đổi màu màn hình ở một số chế độ. Nếu vậy, Overbright sẽ dừng trên màn hình này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”在某些模式下可能会更改显示器颜色。如果发生这种情况，Overbright会在此显示器上停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」在某些模式下可能會更改顯示器顏色。若發生這種情況，Overbright會在此顯示器上停止。"
          }
        }
      }
    },
    "%@ changed the colors of %@, so Overbright stopped there." : {
      "comment" : "Panel: banner after an app changed a display’s colors; the arguments are the app’s and the display’s names",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غيّر التطبيق \"%1$@\" ألوان الشاشة \"%2$@\"، لذا توقف Overbright عليها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app %1$@ ha canviat els colors de la pantalla %2$@ i l’Overbright s’hi ha aturat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace %1$@ změnila barvy monitoru „%2$@“, proto se na něm Overbright zastavil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ændrede farverne på %2$@, så Overbright stoppede der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ hat die Farben von „%2$@“ geändert, daher wurde Overbright dort gestoppt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η εφαρμογή «%1$@» άλλαξε τα χρώματα της οθόνης «%2$@», οπότε το Overbright σταμάτησε σε αυτήν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ changed the colors of %2$@, so Overbright stopped there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha cambiado los colores de “%2$@”, así que Overbright se ha detenido en esa pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appi %1$@ muutti näytön %2$@ värejä, joten Overbright pysähtyi kyseisellä näytöllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » a modifié les couleurs de « %2$@ », Overbright s’y est donc arrêté."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היישום %1$@ שינה את הצבעים של %2$@, ולכן Overbright הפסיק לפעול בו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ने %2$@ के रंग बदल दिए, इसलिए Overbright ने उस पर काम करना बंद कर दिया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija %1$@ promijenila je boje zaslona “%2$@”, pa se Overbright ondje zaustavio."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %1$@ módosította a(z) %2$@ kijelző színeit, ezért az Overbright ott leállt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ mengubah warna %2$@, jadi Overbright berhenti di sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha modificato i colori di “%2$@”, quindi Overbright si è interrotto su quello schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”が“%2$@”の色を変更したため、Overbrightはそのディスプレイで停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’이(가) ‘%2$@’의 색상을 변경하여 Overbright가 해당 디스플레이에서 중지되었습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ telah menukar warna %2$@, jadi Overbright berhenti di situ."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ endret fargene på %2$@, så Overbright stoppet der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ heeft de kleuren van ‘%2$@’ gewijzigd, dus Overbright is daar gestopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja %1$@ zmieniła kolory wyświetlacza „%2$@”, więc Overbright się na nim zatrzymał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app %1$@ alterou as cores de “%2$@”, então o Overbright foi interrompido nessa tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aplicação %1$@ alterou as cores do monitor “%2$@”, por isso o Overbright parou nesse monitor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a modificat culorile afișajului „%2$@”, așa că Overbright s‑a oprit acolo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение «%1$@» изменило цвета дисплея «%2$@», поэтому Overbright на нём остановлен."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apka %1$@ zmenila farby displeja „%2$@“, preto sa na ňom Overbright zastavilo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija %1$@ je spremenila barve zaslona »%2$@«, zato se je Overbright na njem ustavil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ändrade färgerna på %2$@, så Overbright stoppade där."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ เปลี่ยนสีของ %2$@ Overbright จึงหยุดทำงานบนจอนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ ekranının renklerini değiştirdiği için Overbright orada durdu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма «%1$@» змінила кольори дисплея «%2$@», тому Overbright на ньому зупинено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đã thay đổi màu của %2$@, nên Overbright đã dừng ở đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”更改了“%2$@”的颜色，因此Overbright已在该显示器上停止。"
