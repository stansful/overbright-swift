    "macOS allowed up to %@ on this display last time." : {
      "comment" : "Verdict: the largest gain macOS gave; the argument is a multiplier such as ×1.55",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سمح macOS في المرة السابقة بما يصل إلى %@ على هذه الشاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’última vegada, el macOS va permetre fins a %@ en aquesta pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minule macOS na tomto monitoru povolil až %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidste gang tillod macOS op til %@ på denne skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat auf diesem Display zuletzt bis zu %@ erlaubt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Την προηγούμενη φορά, το macOS επέτρεψε έως %@ σε αυτήν την οθόνη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La última vez, macOS permitió hasta %@ en esta pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viime kerralla macOS salli tällä näytöllä enintään %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière fois, macOS a autorisé jusqu’à %@ sur cet écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בפעם הקודמת מערכת macOS אפשרה עד %@ בצג הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछली बार macOS ने इस डिस्प्ले पर %@ तक की अनुमति दी थी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS je prošli put na ovom zaslonu dopustio do %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legutóbb a macOS legfeljebb %@ értéket engedett ezen a kijelzőn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terakhir kali, macOS mengizinkan hingga %@ di layar ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ultima volta macOS ha consentito fino a %@ su questo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回、macOSはこのディスプレイで%@まで許可しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난번에 macOS는 이 디스플레이에서 %@까지 허용했습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kali terakhir, macOS membenarkan sehingga %@ pada paparan ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS tillot opptil %@ på denne skjermen sist."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS stond de vorige keer tot %@ toe op dit beeldscherm."
          }
        },
        "pl" : {
