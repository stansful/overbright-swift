    "With Peak, up to about %@× brighter at full brightness, when macOS allows it." : {
      "comment" : "Verdict: a supported display with Peak; the argument is a gain such as 2.6",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "With Peak, up to about %@× brighter at full brightness, when macOS allows it."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb “Pic”, fins a uns %@× més brillant amb la brillantor al màxim, si el macOS ho permet."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S limitem „Špičkový“ až zhruba %@× jasnější při plném jasu, pokud to macOS dovolí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Top bliver skærmen op til ca. %@× lysere ved fuld lysstyrke, når macOS tillader det."
          }
        },
        "de" : {
