          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã tạm dừng vì %@ thay đổi màu màn hình. Night Shift cho ánh sáng ấm mà không gây xung đột."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已暂停，因为“%@”会更改显示器颜色。“夜览”可提供暖色调，且不会产生冲突。"
          }
        },
        "zh-Hant" : {
