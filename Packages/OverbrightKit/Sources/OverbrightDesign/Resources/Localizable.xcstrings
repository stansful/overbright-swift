          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS permite acum o rezervă de luminozitate mai mică. O reduce când mediul este luminos, afișajul este cald sau nivelul bateriei este scăzut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас macOS даёт меньше запаса яркости. Он уменьшается, когда вокруг светло, дисплей нагрелся или заряд аккумулятора низкий."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS teraz povoľuje menšiu rezervu jasu. Znižuje ju, keď je okolie jasné, displej je zahriaty alebo je batéria takmer vybitá."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS zdaj dovoljuje manjšo rezervo svetlosti. Zmanjša jo, ko je okolica svetla, zaslon topel ali baterija skoraj prazna."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
