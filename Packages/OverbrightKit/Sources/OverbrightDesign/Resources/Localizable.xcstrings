          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนนี้ macOS อนุญาตช่วงเพิ่มเติมน้อยลง โดยจะลดช่วงเพิ่มเติมลงเมื่อรอบตัวสว่าง จอภาพร้อน หรือแบตเตอรี่เหลือน้อย"
