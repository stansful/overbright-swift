        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिस्प्ले के लिए अतिरिक्त ब्राइटनेस बंद है। डिम करना अब भी काम करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
