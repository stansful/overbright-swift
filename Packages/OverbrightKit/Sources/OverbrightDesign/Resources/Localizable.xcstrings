    "Every setting in %@ returns to its default, including display calibration." : {
      "comment" : "Settings: message of the Displays pane’s Reset alert; the argument is the pane’s name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستعود كل الإعدادات في \"%@\" إلى قيمها الافتراضية، بما في ذلك معايرة الشاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tota la configuració de “%@” tornarà als valors per omissió, inclòs el calibratge de les pantalles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechna nastavení v sekci „%@“ se vrátí na výchozí hodnoty, včetně kalibrace monitorů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle indstillinger i %@ nulstilles til standard, inklusive skærmkalibreringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Einstellungen in „%@“ werden auf ihre Standardwerte zurückgesetzt, auch die Displaykalibrierung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι ρυθμίσεις της ενότητας «%@» επανέρχονται στις προεπιλογές τους, συμπεριλαμβανομένης της βαθμονόμησης οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los ajustes de “%@” volverán a su valor predeterminado, incluida la calibración de las pantallas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki osion %@ asetukset palautetaan oletusarvoihin, myös näyttöjen kalibrointi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les réglages de « %@ » reviennent à leur valeur par défaut, y compris le calibrage des écrans."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל ההגדרות ב״%@״ יחזרו לברירת המחדל, כולל כיול הצגים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” की हर सेटिंग अपने डिफ़ॉल्ट पर लौट आएगी, डिस्प्ले कैलिब्रेशन समेत।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve postavke odjeljka “%@” vraćaju se na standardne vrijednosti, uključujući kalibraciju zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ panel minden beállítása visszaáll az alapértelmezettre, a kijelzők kalibrálásával együtt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua pengaturan di “%@” kembali ke default, termasuk kalibrasi layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le impostazioni di “%@” torneranno ai valori predefiniti, inclusa la calibrazione degli schermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”のすべての設定が、ディスプレイのキャリブレーションも含めてデフォルトに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’의 모든 설정이 디스플레이 보정을 포함하여 기본값으로 돌아갑니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap seting dalam %@ kembali kepada lalai, termasuk kalibrasi paparan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle innstillinger i %@ settes tilbake til standardverdiene, inkludert skjermkalibreringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle instellingen in ‘%@’ worden teruggezet naar de standaardwaarde, inclusief de kalibratie van beeldschermen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie ustawienia w sekcji „%@” wrócą do wartości domyślnych, łącznie z kalibracją wyświetlaczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os ajustes de “%@” voltarão ao padrão, incluindo a calibração das telas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as definições de “%@” voltam aos valores predefinidos, incluindo a calibração dos monitores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate configurările din „%@” revin la valorile implicite, inclusiv calibrarea afișajelor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все настройки раздела «%@» вернутся к значениям по умолчанию, включая калибровку дисплеев."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky nastavenia v časti %@ sa vrátia na predvolené hodnoty vrátane kalibrácie displejov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vse nastavitve v razdelku »%@« bodo ponastavljene na privzete vrednosti, vključno z umerjanjem zaslonov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla inställningar i %@ återställs till förval, även skärmkalibreringen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตั้งค่าทั้งหมดใน “%@” จะกลับเป็นค่าเริ่มต้น รวมถึงการปรับเทียบจอภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bölümündeki tüm ayarlar, ekran kalibrasyonu dahil saptanmış değerlerine döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі параметри розділу «%@» повернуться до типових значень, включно з калібруванням дисплеїв."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi cài đặt trong mục “%@” sẽ trở về mặc định, kể cả hiệu chỉnh màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”中的所有设置都将恢复为默认值，包括显示器校准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」中的所有設定（包括顯示器校正）都會還原為預設值。"
          }
        }
      }
    },
