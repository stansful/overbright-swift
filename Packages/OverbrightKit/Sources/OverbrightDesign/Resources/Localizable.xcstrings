        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert, weil „%@“ die Displayfarben ändert. Night Shift sorgt ohne Konflikt für warmes Licht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε παύση, επειδή η εφαρμογή «%@» αλλάζει τα χρώματα της οθόνης. Το Night Shift δίνει ζεστό φως χωρίς διένεξη."
          }
        },
        "es" : {
