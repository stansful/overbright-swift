    "At full brightness this display gains less than %@. Raising the display brightness gives the same result." : {
      "comment" : "Verdict: a display that gains little; the argument is a percentage such as 10%",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "At full brightness this display gains less than %@. Raising the display brightness gives the same result."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb la brillantor al màxim, aquesta pantalla guanya menys d’un %@. Apujar la brillantor de la pantalla dona el mateix resultat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při plném jasu se tento monitor zjasní o méně než %@. Stejného výsledku dosáhnete zvýšením jasu monitoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved fuld lysstyrke bliver denne skærm mindre end %@ lysere. Du får samme resultat ved at skrue op for skærmens lysstyrke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei voller Helligkeit wird dieses Display um weniger als %@ heller. Dasselbe erreichst du, wenn du die Displayhelligkeit erhöhst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "At full brightness this display gains less than %@. Raising the display brightness gives the same result."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el brillo al máximo, esta pantalla gana menos de un %@. Subir el brillo de la pantalla da el mismo resultado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "At full brightness this display gains less than %@. Raising the display brightness gives the same result."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À pleine luminosité, cet écran gagne moins de %@. Augmenter la luminosité de l’écran donne le même résultat."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "At full brightness this display gains less than %@. Raising the display brightness gives the same result."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
