        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan endre skjermfargene i noen moduser. Hvis det skjer, stopper Overbright på denne skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan in sommige modi de beeldschermkleuren wijzigen. Als dat gebeurt, stopt Overbright op dit beeldscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja %@ w niektórych trybach może zmieniać kolory wyświetlacza. Jeśli to zrobi, Overbright zatrzyma się na tym wyświetlaczu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app %@ pode alterar as cores da tela em alguns modos. Se isso acontecer, o Overbright será interrompido nesta tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aplicação %@ pode alterar as cores do monitor em alguns modos. Se o fizer, o Overbright para neste monitor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ poate modifica culorile afișajului în anumite moduri. Dacă se întâmplă asta, Overbright se oprește pe acest afișaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение «%@» в некоторых режимах может менять цвета дисплея. Если это произойдёт, Overbright остановится на этом дисплее."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apka %@ môže v niektorých režimoch meniť farby displeja. Ak sa to stane, Overbright sa na tomto displeji zastaví."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija %@ lahko v nekaterih načinih spreminja barve zaslona. Če se to zgodi, se Overbright na tem zaslonu ustavi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan ändra skärmfärgerna i vissa lägen. Om det händer stoppar Overbright på den här skärmen."
          }
        },
        "th" : {
