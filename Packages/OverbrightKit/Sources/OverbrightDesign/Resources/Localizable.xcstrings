    "On this Mac, macOS ignores color table changes, so Overbright uses Compatibility mode." : {
      "comment" : "Verdict advisory: this Mac ignores color table changes",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على جهاز Mac هذا، يتجاهل macOS تغييرات جدول الألوان، لذا يستخدم Overbright وضع التوافق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En aquest Mac, el macOS ignora els canvis a la taula de colors, per això l’Overbright fa servir el mode de compatibilitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tomto Macu macOS ignoruje změny tabulky barev, proto Overbright používá režim kompatibility."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På denne Mac ignorerer macOS ændringer i farvetabellen, så Overbright bruger kompatibilitetstilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Mac ignoriert macOS Änderungen der Farbtabelle, daher nutzt Overbright den Kompatibilitätsmodus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε αυτό το Mac, το macOS αγνοεί τις αλλαγές στον πίνακα χρωμάτων, οπότε το Overbright χρησιμοποιεί τη λειτουργία συμβατότητας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En este Mac, macOS ignora los cambios en la tabla de colores, así que Overbright usa el modo de compatibilidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tässä Macissa macOS ohittaa väritaulukon muutokset, joten Overbright käyttää yhteensopivuustilaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur ce Mac, macOS ignore les modifications de la table des couleurs ; Overbright utilise donc le mode de compatibilité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ב-Mac זה, מערכת macOS מתעלמת משינויים בטבלת הצבעים, ולכן Overbright משתמש במצב תאימות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस Mac पर macOS रंग टेबल में किए गए बदलावों को अनदेखा करता है, इसलिए Overbright संगतता मोड इस्तेमाल करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na ovom Macu macOS zanemaruje promjene tablice boja, pa Overbright koristi način kompatibilnosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen a Macen a macOS figyelmen kívül hagyja a színtábla módosításait, ezért az Overbright kompatibilitási módot használ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di Mac ini, macOS mengabaikan perubahan tabel warna, jadi Overbright menggunakan Mode kompatibilitas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questo Mac, macOS ignora le modifiche alla tabella colori, quindi Overbright usa la modalità compatibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacではmacOSがカラーテーブルの変更を無視するため、Overbrightは互換モードを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서는 macOS가 색상 테이블 변경을 무시하므로 Overbright가 호환성 모드를 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada Mac ini, macOS mengabaikan perubahan jadual warna, jadi Overbright menggunakan Mod keserasian."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På denne Macen ignorerer macOS endringer i fargetabellen, så Overbright bruker kompatibilitetsmodus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op deze Mac negeert macOS wijzigingen in de kleurentabel, dus gebruikt Overbright de compatibiliteitsmodus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tym Macu macOS ignoruje zmiany tabeli kolorów, więc Overbright używa trybu zgodności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neste Mac, o macOS ignora alterações na tabela de cores, então o Overbright usa o Modo de Compatibilidade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neste Mac, o macOS ignora as alterações à tabela de cores, por isso o Overbright usa o modo de compatibilidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pe acest Mac, macOS ignoră modificările tabelului de culori, așa că Overbright folosește modul de compatibilitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом Mac macOS игнорирует изменения цветовой таблицы, поэтому Overbright использует режим совместимости."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tomto Macu macOS ignoruje zmeny tabuľky farieb, preto Overbright používa režim kompatibility."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tem Macu macOS prezre spremembe barvne tabele, zato Overbright uporablja način združljivosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På den här Macen ignorerar macOS ändringar i färgtabellen, så Overbright använder kompatibilitetsläge."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บน Mac เครื่องนี้ macOS จะไม่สนใจการเปลี่ยนแปลงตารางสี Overbright จึงใช้โหมดความเข้ากันได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac’te macOS renk tablosu değişikliklerini yok sayar, bu yüzden Overbright uyumluluk modunu kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На цьому Mac macOS ігнорує зміни колірної таблиці, тому Overbright використовує режим сумісності."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên máy Mac này, macOS bỏ qua thay đổi bảng màu, nên Overbright dùng Chế độ tương thích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此Mac上，macOS会忽略颜色表更改，因此Overbright使用兼容模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此Mac上，macOS會忽略色彩表的更改，因此Overbright會使用相容模式。"
          }
        }
      }
