    "Off because of the current Focus." : {
      "comment" : "Panel: banner while a Focus turned extra brightness off; “Focus” is macOS’s own name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوقفة بسبب وضع \"التركيز\" الحالي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivat pel mode de concentració actual."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnuto kvůli aktuálnímu režimu soustředění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slået fra på grund af den aktuelle fokusfunktion."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wegen des aktuellen Fokus ausgeschaltet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιπλέον φωτεινότητα είναι απενεργοποιημένη λόγω της τρέχουσας λειτουργίας «Συγκέντρωση»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado por el modo de concentración actual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pois päältä nykyisen Keskity-tilan vuoksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé en raison du mode Concentration actuel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבוי בגלל מצב הריכוז הנוכחי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा फ़ोकस के कारण बंद है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isključeno zbog trenutačnog Fokusa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kikapcsolva a jelenlegi Fókusz miatt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mati karena Fokus saat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato a causa della full immersion attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の集中モードのためオフになっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 집중 모드로 인해 꺼져 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimatikan kerana Fokus semasa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av på grunn av det gjeldende fokuset."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit vanwege de huidige focus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączono z powodu bieżącego trybu skupienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado por causa do Foco atual."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado devido ao modo de concentração atual."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivat din cauza modului de concentrare actual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключено из-за текущего режима фокусирования."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnuté kvôli aktuálnemu režimu Môjho času."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izklopljeno zaradi trenutnega fokusa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av på grund av det aktuella fokuset."
          }
        },
        "th" : {
