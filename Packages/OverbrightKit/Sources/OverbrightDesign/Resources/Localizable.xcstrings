    "Sidecar and AirPlay displays can’t be adjusted." : {
      "comment" : "Verdict: a Sidecar or AirPlay display",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن ضبط شاشات Sidecar وAirPlay."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pantalles Sidecar i AirPlay no es poden ajustar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitory Sidecar a AirPlay nelze upravovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidecar- og AirPlay-skærme kan ikke justeres."
          }
        },
        "de" : {
