    "Overbright is unlocking extra range on this display. The first time takes a few seconds." : {
      "comment" : "Panel ▸ Display card: popover of the Preparing… chip",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح Overbright هامش الإضاءة على هذه الشاشة. تستغرق المرة الأولى بضع ثوانٍ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Overbright està desbloquejant el marge extra d’aquesta pantalla. La primera vegada triga uns segons."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright na tomto monitoru zpřístupňuje rezervu jasu. Poprvé to trvá několik sekund."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright låser lysreserven op på denne skærm. Første gang tager det et par sekunder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright erschließt die Helligkeitsreserve dieses Displays. Beim ersten Mal dauert das einige Sekunden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Overbright ξεκλειδώνει το περιθώριο φωτεινότητας σε αυτήν την οθόνη. Την πρώτη φορά χρειάζονται λίγα δευτερόλεπτα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright está desbloqueando el margen de brillo de esta pantalla. La primera vez tarda unos segundos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright avaa tämän näytön kirkkausvaran. Ensimmäisellä kerralla se kestää muutaman sekunnin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright libère la marge de luminosité de cet écran. La première fois, cela prend quelques secondes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כעת Overbright פותח טווח נוסף בצג הזה. בפעם הראשונה זה לוקח כמה שניות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright इस डिस्प्ले पर अतिरिक्त रेंज खोल रहा है। पहली बार इसमें कुछ सेकंड लगते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright otključava rezervu svjetline na ovom zaslonu. Prvi put to traje nekoliko sekundi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Overbright feloldja a fényerőtartalékot ezen a kijelzőn. Első alkalommal ez néhány másodpercig tart."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright membuka rentang ekstra di layar ini. Pertama kali perlu beberapa detik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright sta sbloccando il margine di luminosità di questo schermo. La prima volta richiede qualche secondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbrightがこのディスプレイの輝度の余力を引き出しています。初回は数秒かかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright가 이 디스플레이의 여유 밝기를 활성화하는 중입니다. 처음에는 몇 초가 걸립니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright membuka julat tambahan pada paparan ini. Kali pertama perlu beberapa saat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright låser opp lysreserven på denne skjermen. Første gang tar det noen sekunder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright ontgrendelt extra bereik op dit beeldscherm. De eerste keer duurt dit een paar seconden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright odblokowuje zapas jasności na tym wyświetlaczu. Za pierwszym razem trwa to kilka sekund."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Overbright está liberando a margem de brilho desta tela. Na primeira vez, isso leva alguns segundos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Overbright está a desbloquear a margem extra deste monitor. Da primeira vez demora alguns segundos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright deblochează rezerva de luminozitate pe acest afișaj. Prima dată durează câteva secunde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright открывает запас яркости на этом дисплее. В первый раз это занимает несколько секунд."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright na tomto displeji sprístupňuje rezervu jasu. Prvýkrát to trvá pár sekúnd."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright na tem zaslonu sprošča rezervo svetlosti. Prvič to traja nekaj sekund."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright låser upp ljusreserven på den här skärmen. Första gången tar några sekunder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright กำลังปลดล็อคช่วงเพิ่มเติมบนจอภาพนี้ ครั้งแรกจะใช้เวลาไม่กี่วินาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright bu ekranda parlaklık payını açıyor. İlk seferinde birkaç saniye sürer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright відкриває запас яскравості на цьому дисплеї. Першого разу це триває кілька секунд."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright đang mở khóa dải sáng bổ sung trên màn hình này. Lần đầu sẽ mất vài giây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright正在解锁此显示器的亮度余量。首次需要几秒钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright正在解鎖此顯示器的亮度餘裕。第一次需要幾秒鐘。"
          }
        }
      }
    },
