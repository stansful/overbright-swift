    "Safe stays at the level this display can hold across the whole screen, %@ here." : {
      "comment" : "Panel ▸ Display card: Safe on an Apple XDR panel; the argument is a multiplier such as ×1.67",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى الحد \"آمن\" عند المستوى الذي تحافظ عليه هذه الشاشة على كامل سطحها: هنا %@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Segur” es manté al nivell que aquesta pantalla pot mantenir a tota la superfície, aquí %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit „Bezpečný“ odpovídá úrovni, kterou tento monitor udrží na celé obrazovce: zde %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grænsen Sikker er det niveau, skærmen kan holde over hele fladen – her %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Sicher“ bleibt auf der Stufe, die dieses Display auf dem ganzen Bildschirm halten kann, hier %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το όριο «Ασφαλές» μένει στο επίπεδο που αυτή η οθόνη μπορεί να διατηρεί σε όλη της την επιφάνεια: εδώ %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Seguro” se queda en el nivel que esta pantalla puede mantener en toda su superficie: aquí, %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Turvallinen” pysyy tasolla, jota tämä näyttö voi pitää koko alallaan, tässä %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Sécurité » reste au niveau que cet écran peut tenir sur toute sa surface : ici %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״בטוח״ נשאר ברמה שהצג הזה יכול להחזיק בכל המסך: כאן %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“सुरक्षित” उस स्तर पर रहता है जिसे यह डिस्प्ले पूरी स्क्रीन पर बनाए रख सकता है: यहाँ %@।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sigurno” ostaje na razini koju ovaj zaslon može održati na cijeloj površini, ovdje %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Biztonságos” azon a szinten marad, amelyet ez a kijelző a teljes képernyőn tartani tud: itt %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batas Aman tetap di level yang dapat ditahan layar ini di seluruh permukaannya, di sini %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sicuro” resta al livello che questo schermo può mantenere su tutta la superficie: qui %@."
