    "This preset doesn’t allow extra brightness. Choose a preset with a higher peak in Displays settings." : {
      "comment" : "Verdict: the display preset allows no extra brightness",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يسمح هذا الإعداد المسبق بإضاءة إضافية. اختر في إعدادات \"شاشات العرض\" إعدادًا مسبقًا بذروة أعلى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta preconfiguració no permet brillantor extra. Tria una preconfiguració amb una brillantor màxima més alta a la secció Pantalles de la configuració del sistema."
