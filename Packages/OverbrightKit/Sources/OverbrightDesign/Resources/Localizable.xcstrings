          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sicuro” non aggiunge luminosità extra su questo schermo, perché il suo massimo normale raggiunge già il livello che può mantenere su tutta la superficie."
          }
        },
        "ja" : {
          "stringUnit" : {
