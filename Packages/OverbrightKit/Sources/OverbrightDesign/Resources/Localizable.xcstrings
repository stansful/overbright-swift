    "With Peak, up to about %@× brighter at full brightness, when macOS allows it." : {
      "comment" : "Verdict: a supported display with Peak; the argument is a gain such as 2.6",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مع الحد \"الذروة\"، إضاءة أعلى بما يصل إلى نحو %@× عند الإضاءة الكاملة، عندما يسمح macOS بذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb “Pic”, fins a uns %@× més brillant amb la brillantor al màxim, si el macOS ho permet."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S limitem „Špičkový“ až zhruba %@× jasnější při plném jasu, pokud to macOS dovolí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Top bliver skærmen op til ca. %@× lysere ved fuld lysstyrke, når macOS tillader det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Spitze“ bei voller Helligkeit bis zu etwa %@× heller, wenn macOS es erlaubt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με το όριο «Αιχμή», έως περίπου %@× φωτεινότερη σε πλήρη φωτεινότητα, όταν το επιτρέπει το macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
