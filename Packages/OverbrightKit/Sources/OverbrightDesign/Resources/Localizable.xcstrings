        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”がディスプレイの色を変更するため、一時停止しています。Night Shiftなら競合せずに暖かい色合いにできます。"
          }
        },
        "ko" : {
