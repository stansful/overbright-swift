    "Overbright stopped on %@ to prevent flicker." : {
      "comment" : "Panel: banner after the flicker guard stopped a display; the argument is the display’s name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف Overbright على الشاشة \"%@\" لمنع الوميض."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Overbright s’ha aturat a la pantalla %@ per evitar parpelleigs."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright se na monitoru „%@“ zastavil, aby nedošlo k blikání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright stoppede på %@ for at undgå flimmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright wurde auf „%@“ gestoppt, um Flimmern zu vermeiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Overbright σταμάτησε στην οθόνη «%@» για να αποτραπεί το τρεμόπαιγμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright se ha detenido en “%@” para evitar parpadeos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright pysähtyi näytöllä %@ välkynnän estämiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright s’est arrêté sur « %@ » pour éviter le scintillement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי למנוע הבהובים, Overbright הפסיק לפעול ב-%@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "झिलमिलाहट रोकने के लिए Overbright ने %@ पर काम करना बंद कर दिया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright se zaustavio na zaslonu “%@” kako bi spriječio treperenje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Overbright a villódzás megelőzése érdekében leállt a(z) %@ kijelzőn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright berhenti di %@ untuk mencegah kedipan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright si è interrotto su “%@” per evitare lo sfarfallio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ちらつきを防ぐため、Overbrightは“%@”で停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "깜박임을 방지하기 위해 Overbright가 ‘%@’에서 중지되었습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright berhenti pada %@ untuk mengelakkan kelipan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright stoppet på %@ for å hindre flimring."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright is gestopt op ‘%@’ om flikkeren te voorkomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright zatrzymał się na wyświetlaczu „%@”, aby zapobiec migotaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Overbright foi interrompido em “%@” para evitar cintilação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Overbright parou no monitor “%@” para evitar cintilação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright s‑a oprit pe afișajul „%@” pentru a preveni pâlpâirea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright остановлен на дисплее «%@», чтобы не допустить мерцания."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright sa na displeji „%@“ zastavilo, aby nedošlo k blikaniu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright se je na zaslonu »%@« ustavil, da prepreči utripanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright stoppade på %@ för att förhindra flimmer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright หยุดทำงานบน %@ เพื่อป้องกันการกะพริบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright titremeyi önlemek için %@ ekranında durdu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright зупинено на дисплеї «%@», щоб запобігти мерехтінню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright đã dừng trên %@ để tránh nhấp nháy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为防止闪烁，Overbright已在“%@”上停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為避免閃爍，Overbright已在「%@」上停止。"
          }
        }
      }
    },
