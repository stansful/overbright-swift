            "value" : "Pauzirano jer aplikacija %@ mijenja boje zaslona. Night Shift daje toplo svjetlo bez sukoba."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szüneteltetve, mert a(z) %@ módosítja a kijelző színeit. A Night Shift ütközés nélkül ad meleg fényt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dijeda karena %@ mengubah warna layar. Night Shift memberikan cahaya hangat tanpa konflik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In pausa perché %@ modifica i colori dello schermo. Night Shift offre una luce calda senza conflitti."
