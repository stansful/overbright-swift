    "Safe stays at the level this display can hold across the whole screen, %@ here, about %lld nits." : {
      "comment" : "Panel ▸ Display card: Safe on an Apple XDR panel with a known SDR white; a multiplier such as ×1.67, then nits",
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "يبقى الحد \"آمن\" عند المستوى الذي تحافظ عليه هذه الشاشة على كامل سطحها: هنا %1$@، نحو %2$lld نيت."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "يبقى الحد \"آمن\" عند المستوى الذي تحافظ عليه هذه الشاشة على كامل سطحها: هنا %1$@، نحو %2$lld نيت."
                }
