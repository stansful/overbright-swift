          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cores dos monitores repostas. Alguns monitores foram repostos diretamente no respetivo perfil de cor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Culorile afișajelor au fost resetate. Unele afișaje au fost readuse direct la profilul lor de culoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвета дисплеев сброшены. Для некоторых дисплеев цветовой профиль восстановлен напрямую."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farby displejov boli resetované. Niektorým displejom bol farebný profil obnovený priamo."
          }
