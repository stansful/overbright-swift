    "Peak can go further when macOS allows it." : {
      "comment" : "Verdict: follows “With Safe, up to about 1.7× brighter…” until macOS has given a grant",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن يرتفع الحد \"الذروة\" أكثر عندما يسمح macOS بذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Pic” pot anar més enllà quan el macOS ho permet."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit „Špičkový“ může jít výš, když to macOS dovolí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top kan gå længere, når macOS tillader det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Spitze“ ist mehr möglich, wenn macOS es erlaubt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το όριο «Αιχμή» φτάνει πιο ψηλά όταν το επιτρέπει το macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Pico” puede llegar más lejos cuando macOS lo permite."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Huippu” voi mennä pidemmälle, kun macOS sallii sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Pic » peut aller plus loin quand macOS le permet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״שיא״ יכול להגיע רחוק יותר כשמערכת macOS מאפשרת זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब macOS अनुमति देता है, तब “पीक” और आगे जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vršno” može ići i više kad macOS to dopusti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Csúcs” ennél tovább is mehet, ha a macOS engedi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puncak dapat mencapai lebih tinggi saat macOS mengizinkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Picco” può andare oltre quando macOS lo consente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSが許可すれば、“ピーク”ではさらに明るくできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 허용하면 ‘피크’에서 더 밝게 할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puncak boleh mencapai lebih tinggi apabila macOS membenarkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Topp» kan gå lenger når macOS tillater det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Piek’ kan verder gaan als macOS dat toestaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Szczyt” pozwala na więcej, gdy macOS na to zezwala."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Pico” pode ir além quando o macOS permitir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Pico” pode ir mais longe quando o macOS o permitir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Vârf” poate merge mai departe când macOS permite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предел «Пик» даёт больше, когда это разрешает macOS."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit „Špičkový“ môže ísť vyššie, keď to macOS dovolí."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omejitev »Vrh« lahko seže višje, ko macOS to dovoli."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topp kan gå högre när macOS tillåter det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ขีดสุด” จะเพิ่มได้มากกว่านี้เมื่อ macOS อนุญาต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tepe sınırı, macOS izin verdiğinde daha da yükseğe çıkabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Межа «Пік» дає більше, коли це дозволяє macOS."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đỉnh có thể cao hơn khi macOS cho phép."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果macOS允许，“峰值”可以更亮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS允許時，「峰值」可以更亮。"
          }
        }
      }
    },
