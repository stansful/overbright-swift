    "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more." : {
      "comment" : "Panel ▸ Display card: popover of Below full brightness",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتلاشى الإضاءة الإضافية تدريجيًا كلما خفضت إضاءة الشاشة. ارفع الإضاءة للحصول على المزيد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La brillantor extra s’esvaeix a mesura que abaixes la brillantor de la pantalla. Apuja la brillantor per tenir‑ne més."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra jas slábne, když snižujete jas monitoru. Chcete‑li víc světla, zvyšte jas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den ekstra lysstyrke aftager, når du skruer ned for skærmens lysstyrke. Skru op for lysstyrken for at få mere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zusatzhelligkeit nimmt ab, wenn du die Displayhelligkeit verringerst. Erhöhe die Helligkeit, um mehr davon zu bekommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιπλέον φωτεινότητα σβήνει σταδιακά καθώς χαμηλώνετε τη φωτεινότητα της οθόνης. Για περισσότερη, αυξήστε τη φωτεινότητα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El brillo extra se desvanece a medida que bajas el brillo de la pantalla. Súbelo para obtener más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisäkirkkaus hiipuu, kun lasket näytön kirkkautta. Nosta kirkkautta, niin saat lisää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luminosité supplémentaire s’estompe quand vous baissez la luminosité de l’écran. Augmentez la luminosité pour en obtenir davantage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבהירות הנוספת דועכת ככל שמנמיכים את בהירות הצג. כדי לקבל יותר, יש להגביר את הבהירות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्प्ले की ब्राइटनेस कम करने पर अतिरिक्त ब्राइटनेस धीरे-धीरे घट जाती है। ज़्यादा के लिए ब्राइटनेस बढ़ाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatna svjetlina postupno nestaje kad smanjujete svjetlinu zaslona. Za više svjetla povećajte svjetlinu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kijelző fényerejének csökkentésével az extra fényerő fokozatosan megszűnik. Ha több fényt szeretne, növelje a fényerőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kecerahan ekstra memudar saat Anda menurunkan kecerahan layar. Naikkan kecerahan untuk menambahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luminosità extra si riduce man mano che abbassi la luminosità dello schermo. Alzala per averne di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイの輝度を下げると、追加の輝度は徐々に弱まります。さらに明るくするには輝度を上げてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이 밝기를 낮추면 추가 밝기가 점차 줄어듭니다. 더 밝게 하려면 밝기를 높이십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kecerahan tambahan semakin pudar apabila anda merendahkan kecerahan paparan. Naikkan kecerahan untuk menambahkannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekstra lysstyrke avtar når du senker lysstyrken på skjermen. Skru opp lysstyrken for å få mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra helderheid neemt geleidelijk af als je de helderheid van het beeldscherm verlaagt. Zet de helderheid hoger voor meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatkowa jasność stopniowo zanika, gdy zmniejszasz jasność wyświetlacza. Aby było jej więcej, zwiększ jasność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O brilho extra diminui conforme você abaixa o brilho da tela. Aumente o brilho para ter mais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O brilho extra diminui gradualmente à medida que baixa o brilho do monitor. Aumente o brilho para obter mais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminozitatea suplimentară scade treptat pe măsură ce reduceți luminozitatea afișajului. Pentru mai multă lumină, creșteți luminozitatea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При снижении яркости дисплея дополнительная яркость постепенно сходит на нет. Чтобы её стало больше, увеличьте яркость."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra jas slabne, keď znižujete jas displeja. Ak chcete viac svetla, zvýšte jas."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatna svetlost pojenja, ko zmanjšujete svetlost zaslona. Če želite več svetlobe, povečajte svetlost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den extra ljusstyrkan avtar när du sänker skärmens ljusstyrka. Höj ljusstyrkan för mer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความสว่างเพิ่มเติมจะค่อยๆ ลดลงเมื่อคุณลดความสว่างของจอภาพ เพิ่มความสว่างเพื่อให้สว่างขึ้นอีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran parlaklığını düşürdükçe ek parlaklık azalarak kaybolur. Daha fazlası için parlaklığı artırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли ви зменшуєте яскравість дисплея, додаткова яскравість поступово зникає. Щоб її стало більше, збільште яскравість."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ sáng bổ sung giảm dần khi bạn hạ độ sáng màn hình. Hãy tăng độ sáng để có thêm độ sáng bổ sung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调低显示器亮度时，额外亮度会逐渐减弱。若要更亮，请调高亮度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "降低顯示器亮度時，額外亮度會逐漸減弱。調高亮度即可增加。"
          }
        }
      }
    },
