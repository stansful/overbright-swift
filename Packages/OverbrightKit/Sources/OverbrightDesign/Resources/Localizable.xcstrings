    "A reference preset is active. Overbright leaves reference modes as they are." : {
      "comment" : "Verdict: a reference preset is active",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعداد مسبق مرجعي قيد الاستخدام. يترك Overbright الأوضاع المرجعية كما هي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi ha una preconfiguració de referència activa. L’Overbright deixa els modes de referència tal com estan."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je aktivní referenční předvolba. Overbright referenční režimy nemění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En referenceforindstilling er aktiv. Overbright lader referencetilstande være, som de er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Referenz-Voreinstellung ist aktiv. Overbright lässt Referenzmodi unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είναι ενεργή μια προεπιλογή αναφοράς. Το Overbright αφήνει τις λειτουργίες αναφοράς ως έχουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un preajuste de referencia activo. Overbright no modifica los modos de referencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Referenssiesiasetus on käytössä. Overbright jättää referenssitilat ennalleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un préréglage de référence est actif. Overbright ne modifie pas les modes de référence."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תצורת ייחוס פעילה. Overbright לא משנה מצבי ייחוס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक संदर्भ प्रीसेट चालू है। Overbright संदर्भ मोड को जैसे हैं वैसे ही रहने देता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivno je referentno podešenje. Overbright ne mijenja referentne načine rada."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Referencia-előbeállítás aktív. Az Overbright nem módosítja a referenciamódokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preset referensi sedang aktif. Overbright membiarkan mode referensi apa adanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È attivo un preset di riferimento. Overbright non modifica le modalità di riferimento."
          }
        },
        "ja" : {
