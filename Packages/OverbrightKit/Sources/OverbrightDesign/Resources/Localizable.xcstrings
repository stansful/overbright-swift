    "OLED display: extra brightness stays lower and pauses after %@ without input." : {
      "comment" : "Verdict advisory: OLED care; the argument is a duration such as 5 minutes",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاشة OLED: تبقى الإضاءة الإضافية أخفض وتتوقف مؤقتًا بعد %@ بلا أي إدخال."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantalla OLED: la brillantor extra es manté més baixa i es posa en pausa si no hi ha activitat durant %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitor OLED: extra jas zůstává nižší a pozastaví se po nečinnosti (%@ bez vstupu)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED-skærm: ekstra lysstyrke holdes lavere og sættes på pause efter %@ uden aktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED-Display: Die Zusatzhelligkeit bleibt niedriger und pausiert nach %@ ohne Eingabe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οθόνη OLED: η επιπλέον φωτεινότητα μένει χαμηλότερη και μπαίνει σε παύση μετά από %@ χωρίς δραστηριότητα."
          }
        },
        "es" : {
          "stringUnit" : {
