    "Display colors can be reset only from the session shown on the displays." : {
      "comment" : "Settings ▸ Advanced: result of Reset Display Colors while another user’s session is on the displays (fast user switching)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن إعادة تعيين ألوان الشاشة إلا من الجلسة المعروضة على الشاشات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els colors de les pantalles només es poden restablir des de la sessió que es mostra a les pantalles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barvy monitorů lze resetovat jen z relace, která je právě zobrazená na monitorech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmfarverne kan kun nulstilles fra den session, der vises på skærmene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displayfarben können nur in der Sitzung zurückgesetzt werden, die gerade auf den Displays angezeigt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επαναφορά των χρωμάτων οθόνης είναι δυνατή μόνο από τη συνεδρία που εμφανίζεται στις οθόνες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los colores de las pantallas solo se pueden restablecer desde la sesión que se muestra en ellas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttöjen värit voi palauttaa vain siitä istunnosta, joka näkyy näytöillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les couleurs des écrans ne peuvent être réinitialisées que depuis la session affichée sur les écrans."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן לאפס את צבעי הצגים רק מתוך החשבון שמוצג כעת בצגים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्प्ले के रंग सिर्फ़ उसी सेशन से रीसेट किए जा सकते हैं जो डिस्प्ले पर दिख रहा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boje zaslona mogu se resetirati samo iz sesije koja je prikazana na zaslonima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kijelzőszíneket csak a kijelzőkön látható munkamenetből lehet visszaállítani."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna layar hanya dapat diatur ulang dari sesi yang sedang ditampilkan di layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I colori degli schermi si possono ripristinare solo dalla sessione mostrata sugli schermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイの色は、ディスプレイに表示されているセッションからのみリセットできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이 색상은 디스플레이에 표시된 세션에서만 재설정할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna paparan hanya boleh direset daripada sesi yang sedang ditunjukkan pada paparan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjermfargene kan bare nullstilles fra økten som vises på skjermene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beeldschermkleuren kunnen alleen worden hersteld vanuit de sessie die op de beeldschermen wordt getoond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolory wyświetlaczy można wyzerować tylko z sesji widocznej na wyświetlaczach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cores das telas só podem ser redefinidas na sessão exibida nas telas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só é possível repor as cores dos monitores a partir da sessão apresentada nos monitores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Culorile afișajelor pot fi resetate doar din sesiunea care apare pe afișaje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбросить цвета дисплеев можно только из сеанса, который сейчас показан на дисплеях."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farby displejov sa dajú resetovať len z relácie, ktorá je práve zobrazená na displejoch."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barve zaslonov je mogoče ponastaviti le iz seje, ki je trenutno prikazana na zaslonih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skärmfärgerna kan bara återställas från den session som visas på skärmarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รีเซ็ตสีจอภาพได้จากเซสชันที่แสดงบนจอภาพอยู่เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran renkleri yalnızca ekranlarda gösterilen oturumdan sıfırlanabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скинути кольори дисплеїв можна лише із сеансу, який зараз показано на дисплеях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ có thể đặt lại màu màn hình từ phiên đang hiển thị trên màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能从显示器上当前显示的会话中重置显示器颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能從顯示器上正在顯示的工作階段重置顯示器顏色。"
          }
        }
      }
    },
