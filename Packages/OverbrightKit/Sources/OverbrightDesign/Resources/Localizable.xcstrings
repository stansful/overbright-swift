        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barve zaslonov so ponastavljene. Nekaterim zaslonom je bil barvni profil obnovljen neposredno."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skärmfärgerna har återställts. Vissa skärmar fick tillbaka sin färgprofil direkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รีเซ็ตสีจอภาพแล้ว จอภาพบางจอถูกตั้งกลับเป็นโปรไฟล์สีโดยตรง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran renkleri sıfırlandı. Bazı ekranlar doğrudan renk profillerine döndürüldü."
          }
