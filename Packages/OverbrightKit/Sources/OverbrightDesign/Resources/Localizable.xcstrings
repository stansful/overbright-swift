        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby używać dodatkowej jasności, włącz „Szeroki zakres tonalny” dla tego wyświetlacza w ustawieniach „Wyświetlacze”. Na niektórych wyświetlaczach zmienia to wygląd codziennych treści. W każdej chwili możesz to ponownie wyłączyć."
          }
        },
        "pt-BR" : {
