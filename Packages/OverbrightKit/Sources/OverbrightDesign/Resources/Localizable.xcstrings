          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หยุดพักอยู่เนื่องจาก %@ เปลี่ยนสีจอภาพ Night Shift ให้แสงโทนอุ่นได้โดยไม่ขัดแย้งกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
