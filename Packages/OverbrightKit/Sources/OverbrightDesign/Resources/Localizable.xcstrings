            "value" : "متوقف مؤقتًا لأن التطبيق \"%@\" يغيّر ألوان الشاشة. تمنحك \"الإضاءة الدافئة\" ضوءًا دافئًا دون أي تعارض."
          }
        },
        "ca" : {
          "stringUnit" : {
