    "Paused because Low Power Mode is on." : {
      "comment" : "Panel: banner in Low Power Mode; “Low Power Mode” is macOS’s own name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوقف مؤقتًا لأن \"نمط الطاقة المنخفضة\" قيد التشغيل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa perquè el mode de baix consum està activat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozastaveno, protože je zapnutý režim nízké spotřeby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sat på pause, fordi Energibesparende funktion er slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert, weil der Stromsparmodus aktiv ist."
          }
        },
        "el" : {
          "stringUnit" : {
