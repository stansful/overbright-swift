    "At full brightness this display gains less than %@. Raising the display brightness gives the same result." : {
      "comment" : "Verdict: a display that gains little; the argument is a percentage such as 10%",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإضاءة الكاملة، تزيد إضاءة هذه الشاشة بأقل من %@. ورفع إضاءة الشاشة يعطي النتيجة نفسها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb la brillantor al màxim, aquesta pantalla guanya menys d’un %@. Apujar la brillantor de la pantalla dona el mateix resultat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při plném jasu se tento monitor zjasní o méně než %@. Stejného výsledku dosáhnete zvýšením jasu monitoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved fuld lysstyrke bliver denne skærm mindre end %@ lysere. Du får samme resultat ved at skrue op for skærmens lysstyrke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei voller Helligkeit wird dieses Display um weniger als %@ heller. Dasselbe erreichst du, wenn du die Displayhelligkeit erhöhst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε πλήρη φωτεινότητα, αυτή η οθόνη γίνεται φωτεινότερη κατά λιγότερο από %@. Το ίδιο αποτέλεσμα έχει και η αύξηση της φωτεινότητας της οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el brillo al máximo, esta pantalla gana menos de un %@. Subir el brillo de la pantalla da el mismo resultado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täydellä kirkkaudella tämä näyttö kirkastuu vähemmän kuin %@. Saman tuloksen saa nostamalla näytön kirkkautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À pleine luminosité, cet écran gagne moins de %@. Augmenter la luminosité de l’écran donne le même résultat."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בבהירות מלאה הצג הזה מתבהר בפחות מ-%@. הגברת הבהירות של הצג תיתן אותה תוצאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरी ब्राइटनेस पर इस डिस्प्ले को %@ से कम बढ़त मिलती है। डिस्प्ले की ब्राइटनेस बढ़ाने से भी यही नतीजा मिलता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri punoj svjetlini ovaj zaslon dobiva manje od %@. Povećanje svjetline zaslona daje isti rezultat."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teljes fényerőn ez a kijelző kevesebb mint %@ többletet nyer. A kijelző fényerejének növelése ugyanezt az eredményt adja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada kecerahan penuh, layar ini bertambah terang kurang dari %@. Menaikkan kecerahan layar memberikan hasil yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla massima luminosità questo schermo guadagna meno del %@. Aumentare la luminosità dello schermo dà lo stesso risultato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このディスプレイは、輝度を最大にしても%@未満しか明るくなりません。ディスプレイの輝度を上げても同じ結果になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 디스플레이는 최대 밝기에서 %@ 미만으로 밝아집니다. 디스플레이 밝기를 높여도 같은 결과를 얻을 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada kecerahan penuh, paparan ini bertambah cerah kurang daripada %@. Menaikkan kecerahan paparan memberikan hasil yang sama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved full lysstyrke blir denne skjermen mindre enn %@ lysere. Å skru opp lysstyrken på skjermen gir samme resultat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op volle helderheid wordt dit beeldscherm minder dan %@ helderder. Hetzelfde resultaat krijg je door de helderheid van het beeldscherm te verhogen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy pełnej jasności ten wyświetlacz zyskuje mniej niż %@. Ten sam efekt daje zwiększenie jasności wyświetlacza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o brilho no máximo, esta tela ganha menos de %@. Aumentar o brilho da tela dá o mesmo resultado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o brilho no máximo, este monitor ganha menos de %@. Aumentar o brilho do monitor dá o mesmo resultado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luminozitate maximă, acest afișaj câștigă mai puțin de %@. Creșterea luminozității afișajului dă același rezultat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На полной яркости этот дисплей становится ярче менее чем на %@. Того же результата можно добиться, просто повысив яркость дисплея."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri plnom jase sa tento displej zjasní o menej než %@. Rovnaký výsledok dosiahnete zvýšením jasu displeja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri polni svetlosti se ta zaslon posvetli za manj kot %@. Enak učinek dosežete, če povečate svetlost zaslona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid full ljusstyrka blir den här skärmen mindre än %@ ljusare. Att höja skärmens ljusstyrka ger samma resultat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่ความสว่างเต็มที่ จอภาพนี้สว่างขึ้นได้น้อยกว่า %@ การเพิ่มความสว่างของจอภาพจะให้ผลเหมือนกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam parlaklıkta bu ekran %@ değerinden daha az parlaklaşır. Ekran parlaklığını artırmak da aynı sonucu verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На повній яскравості цей дисплей стає яскравішим менш ніж на %@. Того самого результату можна досягти, просто збільшивши яскравість дисплея."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở độ sáng tối đa, màn hình này chỉ sáng thêm chưa đến %@. Tăng độ sáng màn hình cũng cho kết quả tương tự."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此显示器在最高亮度下提升不到%@。调高显示器亮度即可获得相同效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在最高亮度下，此顯示器的增亮幅度少於%@。調高顯示器亮度也能達到相同效果。"
          }
        }
      }
    },
