    "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more." : {
      "comment" : "Panel ▸ Display card: popover of Below full brightness",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La brillantor extra s’esvaeix a mesura que abaixes la brillantor de la pantalla. Apuja la brillantor per tenir‑ne més."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra jas slábne, když snižujete jas monitoru. Chcete‑li víc světla, zvyšte jas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den ekstra lysstyrke aftager, når du skruer ned for skærmens lysstyrke. Skru op for lysstyrken for at få mere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zusatzhelligkeit nimmt ab, wenn du die Displayhelligkeit verringerst. Erhöhe die Helligkeit, um mehr davon zu bekommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El brillo extra se desvanece a medida que bajas el brillo de la pantalla. Súbelo para obtener más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luminosité supplémentaire s’estompe quand vous baissez la luminosité de l’écran. Augmentez la luminosité pour en obtenir davantage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatna svjetlina postupno nestaje kad smanjujete svjetlinu zaslona. Za više svjetla povećajte svjetlinu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La luminosità extra si riduce man mano che abbassi la luminosità dello schermo. Alzala per averne di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekstra lysstyrke avtar når du senker lysstyrken på skjermen. Skru opp lysstyrken for å få mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra helderheid neemt geleidelijk af als je de helderheid van het beeldscherm verlaagt. Zet de helderheid hoger voor meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatkowa jasność stopniowo zanika, gdy zmniejszasz jasność wyświetlacza. Aby było jej więcej, zwiększ jasność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O brilho extra diminui conforme você abaixa o brilho da tela. Aumente o brilho para ter mais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O brilho extra diminui gradualmente à medida que baixa o brilho do monitor. Aumente o brilho para obter mais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminozitatea suplimentară scade treptat pe măsură ce reduceți luminozitatea afișajului. Pentru mai multă lumină, creșteți luminozitatea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При снижении яркости дисплея дополнительная яркость постепенно сходит на нет. Чтобы её стало больше, увеличьте яркость."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra jas slabne, keď znižujete jas displeja. Ak chcete viac svetla, zvýšte jas."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatna svetlost pojenja, ko zmanjšujete svetlost zaslona. Če želite več svetlobe, povečajte svetlost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den extra ljusstyrkan avtar när du sänker skärmens ljusstyrka. Höj ljusstyrkan för mer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли ви зменшуєте яскравість дисплея, додаткова яскравість поступово зникає. Щоб її стало більше, збільште яскравість."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness fades out as you lower the display brightness. Turn the brightness up for more."
          }
        }
      }
    },
    "Extra brightness is allowed from %@ to %@." : {
      "comment" : "Panel: banner outside the set hours; the arguments are times of day",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Extra brightness is allowed from %1$@ to %2$@."
          }
        },
        "ca" : {
