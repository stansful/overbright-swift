    "Safe stays at %@ here, about what this display can hold across the whole screen." : {
      "comment" : "Panel ▸ Display card: Safe on an HDR external display; the argument is a multiplier such as ×1.40",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى الحد \"آمن\" هنا عند %@، أي نحو ما تحافظ عليه هذه الشاشة على كامل سطحها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Segur” es manté aquí a %@, aproximadament el que aquesta pantalla pot mantenir a tota la superfície."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit „Bezpečný“ je zde %@, zhruba tolik, kolik tento monitor udrží na celé obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ligger grænsen Sikker på %@, omtrent det niveau, skærmen kan holde over hele fladen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Sicher“ bleibt hier bei %@ – etwa so viel, wie dieses Display auf dem ganzen Bildschirm halten kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εδώ το όριο «Ασφαλές» μένει στο %@, περίπου όσο μπορεί να διατηρεί αυτή η οθόνη σε όλη της την επιφάνεια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí, “Seguro” se queda en %@, más o menos lo que esta pantalla puede mantener en toda su superficie."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Turvallinen” pysyy tässä tasolla %@, eli suunnilleen siinä, mitä tämä näyttö voi pitää koko alallaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Sécurité » reste ici à %@, soit environ ce que cet écran peut tenir sur toute sa surface."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כאן ״בטוח״ עומד על %@, בערך מה שהצג הזה יכול להחזיק בכל המסך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ “सुरक्षित” %@ पर रहता है, लगभग उतना जितना यह डिस्प्ले पूरी स्क्रीन पर बनाए रख सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sigurno” ovdje ostaje na %@, otprilike koliko ovaj zaslon može održati na cijeloj površini."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Biztonságos” itt %@ – nagyjából ennyit tud ez a kijelző a teljes képernyőn tartani."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batas Aman tetap di %@ di sini, kira-kira level yang dapat ditahan layar ini di seluruh permukaannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui “Sicuro” resta a %@, circa quanto questo schermo può mantenere su tutta la superficie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでは“安全”は%@で、このディスプレイが画面全体で維持できるおおよそのレベルです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 ‘안전’ 한도는 %@입니다. 이 디스플레이가 전체 화면에서 유지할 수 있는 수준과 비슷합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Had Selamat kekal pada %@ di sini, kira-kira tahap yang boleh dikekalkan paparan ini di seluruh skrin."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Trygg» holder seg på %@ her, omtrent det denne skjermen kan holde over hele skjermflaten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Veilig’ blijft hier op %@, ongeveer wat dit beeldscherm over het hele scherm kan vasthouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj limit „Bezpieczny” to %@ – mniej więcej tyle, ile ten wyświetlacz może utrzymać na całym ekranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui, “Seguro” fica em %@, mais ou menos o que esta tela consegue manter em toda a superfície."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui, “Seguro” fica em %@, aproximadamente o que este monitor consegue manter em todo o ecrã."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aici, „Sigur” rămâne la %@, cam cât poate menține acest afișaj pe tot ecranul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь предел «Безопасно» — %@: примерно столько этот дисплей может держать на всём экране."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit „Bezpečný“ je tu %@, približne toľko, koľko tento displej udrží na celej obrazovke."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omejitev »Varno« je tukaj %@, približno toliko, kolikor ta zaslon vzdrži na celotni površini."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Här ligger gränsen Säker på %@, ungefär vad skärmen kan hålla över hela ytan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ที่นี่ “ปลอดภัย” อยู่ที่ %@ ซึ่งประมาณเท่าที่จอภาพนี้แสดงได้ทั่วทั้งหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada Güvenli sınırı %@ düzeyinde kalır; bu, ekranın tüm yüzeyde koruyabileceği düzeye yakındır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тут межа «Безпечно» — %@: приблизно стільки цей дисплей може тримати на всьому екрані."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giới hạn An toàn ở đây là %@, khoảng mức mà màn hình này giữ được trên toàn bộ diện tích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此处“安全”保持在%@，约为此显示器可在整个屏幕上保持的水平。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此處「安全」維持在%@，約為此顯示器能在整個螢幕上維持的亮度。"
          }
        }
      }
    },
