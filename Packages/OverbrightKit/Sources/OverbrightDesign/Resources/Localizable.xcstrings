    "Display colors reset. Some displays were set back to their color profile directly." : {
      "comment" : "Settings ▸ Advanced: result of Reset Display Colors when macOS’s own reset failed for some displays and Overbright wrote their profile",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت إعادة تعيين ألوان الشاشة. وأُعيدت بعض الشاشات مباشرةً إلى ملف تعريف اللون الخاص بها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’han restablert els colors de les pantalles. El perfil de color d’algunes pantalles s’ha restablert directament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barvy monitorů byly resetovány. U některých monitorů byl barevný profil obnoven přímo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmfarverne er nulstillet. Nogle skærme blev sat direkte tilbage til deres farveprofil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displayfarben zurückgesetzt. Einige Displays wurden direkt auf ihr Farbprofil zurückgesetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έγινε επαναφορά των χρωμάτων οθόνης. Σε ορισμένες οθόνες επαναφέρθηκε απευθείας το προφίλ χρωμάτων τους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colores de pantalla restablecidos. Algunas pantallas han recuperado su perfil de color directamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttöjen värit palautettu. Joidenkin näyttöjen väriprofiili palautettiin suoraan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleurs des écrans réinitialisées. Certains écrans ont été remis directement à leur profil de couleur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צבעי הצגים אופסו. חלק מהצגים הוחזרו ישירות לפרופיל הצבעים שלהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्प्ले के रंग रीसेट हो गए। कुछ डिस्प्ले को सीधे उनकी रंग प्रोफ़ाइल पर वापस सेट किया गया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boje zaslona su resetirane. Za neke je zaslone profil boje vraćen izravno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kijelzőszínek visszaállítva. Néhány kijelzőnél az Overbright közvetlenül állította vissza a színprofilt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna layar telah diatur ulang. Beberapa layar dikembalikan langsung ke profil warnanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colori degli schermi ripristinati. Ad alcuni schermi è stato riapplicato direttamente il loro profilo colore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイの色をリセットしました。一部のディスプレイは、カラープロファイルを直接適用して元に戻しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이 색상이 재설정되었습니다. 일부 디스플레이는 색상 프로필로 직접 되돌렸습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna paparan telah direset. Sesetengah paparan telah dikembalikan terus kepada profil warnanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjermfargene er nullstilt. Noen skjermer ble satt direkte tilbake til fargeprofilen sin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beeldschermkleuren zijn hersteld. Sommige beeldschermen zijn rechtstreeks teruggezet naar hun kleurenprofiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyzerowano kolory wyświetlaczy. Niektórym wyświetlaczom przywrócono profil kolorów bezpośrednio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
