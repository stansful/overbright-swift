        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לכייל את הצג הזה כרגע. אפשר לבדוק את ההערכה שלו ב״הגדרות״ > ״צגים״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिस्प्ले को अभी कैलिब्रेट नहीं किया जा सकता। सेटिंग ▸ डिस्प्ले में इसका आकलन देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj zaslon trenutačno nije moguće kalibrirati. Provjerite njegov status u odjeljku Postavke ▸ Zasloni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a kijelző most nem kalibrálható. Ellenőrizze az értékelését a Beállítások ▸ Kijelzők részben."
