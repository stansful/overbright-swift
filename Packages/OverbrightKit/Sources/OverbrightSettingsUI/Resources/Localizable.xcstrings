    "Automatic finds the lightest way to unlock extra range on each display and remembers it." : {
      "comment" : "Settings ▸ Advanced: note under the trigger methods",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatic finds the lightest way to unlock extra range on each display and remembers it."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Automàtic” troba la manera més lleugera de desbloquejar el marge extra de cada pantalla i la recorda."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volba Automaticky najde na každém monitoru nejšetrnější způsob, jak zpřístupnit rezervu jasu, a zapamatuje si ho."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Automatisk” finder den mest skånsomme måde at låse lysreserven op på hver skærm og husker den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch“ findet für jedes Display den schonendsten Weg, die Helligkeitsreserve zu erschließen, und merkt ihn sich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιλογή «Αυτόματα» βρίσκει τον πιο ήπιο τρόπο για να ξεκλειδώσει το περιθώριο φωτεινότητας σε κάθε οθόνη και τον θυμάται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Automático” encuentra la forma menos invasiva de desbloquear el margen de brillo en cada pantalla y la recuerda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Automaattinen” etsii kevyimmän tavan avata kunkin näytön kirkkausvara ja muistaa sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Automatique » trouve la méthode la plus légère pour libérer la marge de luminosité de chaque écran et la mémorise."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatic finds the lightest way to unlock extra range on each display and remembers it."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatic finds the lightest way to unlock extra range on each display and remembers it."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcija “Automatski” pronalazi najblaži način otključavanja rezerve svjetline na svakom zaslonu i pamti ga."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az „Automatikus” megkeresi a legkíméletesebb módot a fényerőtartalék feloldására minden kijelzőn, és megjegyzi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatic finds the lightest way to unlock extra range on each display and remembers it."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Automatico” trova il modo meno invasivo per sbloccare il margine di luminosità su ogni schermo e lo ricorda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatic finds the lightest way to unlock extra range on each display and remembers it."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatic finds the lightest way to unlock extra range on each display and remembers it."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatic finds the lightest way to unlock extra range on each display and remembers it."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Automatisk» finner den skånsomste måten å låse opp lysreserven på hver skjerm, og husker den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Automatisch’ zoekt per beeldscherm de lichtste manier om extra bereik te ontgrendelen en onthoudt die."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcja „Automatycznie” znajduje najlżejszy sposób odblokowania zapasu jasności na każdym wyświetlaczu i go zapamiętuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Automático” encontra a forma menos invasiva de liberar a margem de brilho em cada tela e a memoriza."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Automático” encontra a forma mais leve de desbloquear a margem extra em cada monitor e memoriza‑a."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automat” găsește cea mai blândă metodă de a debloca rezerva de luminozitate pe fiecare afișaj și o reține."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вариант «Автоматически» находит самый щадящий способ открыть запас яркости на каждом дисплее и запоминает его."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možnosť Automaticky nájde na každom displeji najšetrnejší spôsob, ako sprístupniť rezervu jasu, a zapamätá si ho."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možnost »Samodejno« na vsakem zaslonu poišče najbolj prizanesljiv način za sprostitev rezerve svetlosti in si ga zapomni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Automatiskt” hittar det skonsammaste sättet att låsa upp ljusreserven på varje skärm och kommer ihåg det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatic finds the lightest way to unlock extra range on each display and remembers it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik seçeneği, her ekranda parlaklık payını açmanın en hafif yolunu bulur ve hatırlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Варіант «Автоматично» знаходить найощадливіший спосіб відкрити запас яскравості на кожному дисплеї й запамʼятовує його."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatic finds the lightest way to unlock extra range on each display and remembers it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatic finds the lightest way to unlock extra range on each display and remembers it."
          }
        },
