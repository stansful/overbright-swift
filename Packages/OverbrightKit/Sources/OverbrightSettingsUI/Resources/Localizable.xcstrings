    "Peak goes up to what macOS allows; it uses more power, and macOS may lower it when the display gets warm." : {
      "comment" : "Settings ▸ Displays: second sentence of the Limit footnote, after the Safe sentence",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Peak goes up to what macOS allows; it uses more power, and macOS may lower it when the display gets warm."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Peak goes up to what macOS allows; it uses more power, and macOS may lower it when the display gets warm."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit „Špičkový“ jde až na úroveň, kterou macOS dovolí; spotřebuje víc energie a macOS ho může snížit, když se monitor zahřeje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top går op til det, macOS tillader – den bruger mere strøm, og macOS kan sænke den, når skærmen bliver varm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Spitze“ reicht bis zum von macOS erlaubten Wert; das braucht mehr Energie, und macOS kann ihn senken, wenn das Display warm wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Peak goes up to what macOS allows; it uses more power, and macOS may lower it when the display gets warm."
          }
        },
        "es" : {
