          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi schermi tornano a Standard. Apri di nuovo Overbright dal Finder o da Spotlight."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
