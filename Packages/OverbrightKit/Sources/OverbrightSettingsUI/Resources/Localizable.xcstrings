    "Counts from when you turn Overbright on." : {
      "comment" : "Settings ▸ Automations: footnote of Turn off after",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ العد من لحظة تشغيل Overbright."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es compta des que actives l’Overbright."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítá se od chvíle, kdy Overbright zapnete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tæller fra, når du slår Overbright til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt ab dem Einschalten von Overbright."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετρά από τη στιγμή που ενεργοποιείτε το Overbright."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta desde que activas Overbright."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasketaan siitä, kun laitat Overbrightin päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte à partir de l’activation d’Overbright."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
