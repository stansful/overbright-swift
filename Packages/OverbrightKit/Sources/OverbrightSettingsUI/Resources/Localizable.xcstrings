    "Did the screen get brighter when the label said Brighter?" : {
      "comment" : "Calibration: question of step 1",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أصبحت الشاشة أكثر إضاءة عندما كانت التسمية \"إضاءة أعلى\"؟"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla s’ha fet més brillant quan l’etiqueta deia “Més brillant”?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zjasnila se obrazovka, když štítek ukazoval „Jasněji“?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blev skærmen lysere, da der stod “Lysere” på etiketten?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wurde der Bildschirm heller, als „Heller“ angezeigt wurde?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έγινε η οθόνη φωτεινότερη όταν η ετικέτα έγραφε «Φωτεινότερα»;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿La pantalla ganó brillo cuando la etiqueta decía “Más brillo”?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirkastuiko näyttö, kun merkinnässä luki ”Kirkkaampi”?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran est-il devenu plus lumineux lorsque l’étiquette indiquait « Plus lumineux » ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האם המסך נעשה בהיר יותר כשבתווית נכתב ״בהיר יותר״?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब लेबल पर “ज़्यादा ब्राइट” लिखा था, तब क्या स्क्रीन ज़्यादा ब्राइट हुई?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je li zaslon postao svjetliji kad je oznaka glasila “Svjetlije”?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Világosabb lett a képernyő, amikor a felirat „Világosabb” volt?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah layar menjadi lebih terang saat label bertuliskan “Lebih Cerah”?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo schermo è diventato più luminoso quando l’etichetta diceva “Più luminoso”?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ラベルが“より明るい”のとき、画面は明るくなりましたか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이블이 ‘더 밝게’일 때 화면이 밝아졌습니까?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adakah skrin menjadi lebih cerah apabila label menyatakan “Lebih Cerah”?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ble skjermen lysere da etiketten viste «Lysere»?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werd het scherm helderder toen het label ‘Helderder’ aangaf?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy ekran stał się jaśniejszy, gdy etykieta pokazywała „Jaśniej”?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tela ficou mais clara quando a etiqueta dizia “Mais Brilho”?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ecrã ficou mais brilhante quando a etiqueta indicava “Mais brilho”?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A devenit ecranul mai luminos când eticheta arăta „Mai luminos”?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экран стал ярче, когда на метке было написано «Ярче»?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zjasnila sa obrazovka, keď štítok ukazoval „Jasnejšie“?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali je zaslon postal svetlejši, ko je oznaka kazala »Svetleje«?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blev skärmen ljusare när etiketten visade ”Ljusare”?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน้าจอสว่างขึ้นหรือไม่เมื่อป้ายแสดงว่า “สว่างขึ้น”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etikette “Daha Parlak” yazarken ekran parlaklaştı mı?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи став екран яскравішим, коли на мітці було написано «Яскравіше»?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màn hình có sáng hơn khi nhãn ghi “Sáng hơn” không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签显示“更亮”时，屏幕是否变亮了？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標籤顯示「更亮」時，螢幕是否變亮了？"
          }
        }
      }
    },
    "Dimming below the minimum works either way." : {
      "comment" : "Settings ▸ Displays: footnote of Use extra brightness on this display",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل التعتيم دون الحد الأدنى في الحالتين."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’atenuació per sota del mínim funciona igualment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ztmavení pod minimum funguje v obou případech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dæmpning under minimum virker under alle omstændigheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abdunkeln unter das Minimum funktioniert in jedem Fall."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το χαμήλωμα κάτω από το ελάχιστο λειτουργεί σε κάθε περίπτωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La atenuación por debajo del mínimo funciona en ambos casos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Himmennys alle minimin toimii joka tapauksessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assombrissement sous le minimum fonctionne dans tous les cas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עמעום מתחת למינימום פועל בכל מקרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "न्यूनतम से नीचे डिम करना दोनों ही स्थितियों में काम करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatamnjenje ispod minimuma radi u svakom slučaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A minimum alatti sötétítés mindkét esetben működik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peredupan di bawah minimum tetap berfungsi dalam kedua kasus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’oscuramento sotto il minimo funziona in ogni caso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最小輝度以下の減光は、どちらの場合でも機能します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최소 밝기 이하로 어둡게 하기는 어느 경우에나 작동합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemalapan di bawah minimum berfungsi dalam kedua-dua keadaan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demping under minimum fungerer uansett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmen onder het minimum werkt hoe dan ook."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyciemnianie poniżej minimum działa w obu przypadkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escurecimento abaixo do mínimo funciona de qualquer forma."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escurecimento abaixo do mínimo funciona em qualquer caso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Întunecarea sub minim funcționează în orice caz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затемнение ниже минимума работает в любом случае."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stmavenie pod minimum funguje v oboch prípadoch."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatemnitev pod minimum deluje v obeh primerih."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedtoning under minimum fungerar i båda fallen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การหรี่แสงต่ำกว่าค่าต่ำสุดใช้งานได้ทั้งสองกรณี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimumun altına karartma her durumda çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затемнення нижче мінімуму працює в будь-якому разі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm tối dưới mức tối thiểu vẫn hoạt động trong cả hai trường hợp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论如何，调暗至最低亮度以下都可以使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無論如何，調暗至最低亮度以下都能使用。"
          }
        }
      }
    },
    "Dims every display to your last dim level, or brings them back." : {
      "comment" : "Settings ▸ Shortcuts: footnote of Dim Below Minimum On or Off",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعتّم كل الشاشات إلى آخر مستوى تعتيم استخدمته، أو يعيدها كما كانت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenua totes les pantalles fins a l’últim nivell d’atenuació o les torna al seu nivell."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ztmaví všechny monitory na poslední úroveň ztmavení, nebo je vrátí zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dæmper alle skærme til dit seneste dæmpningsniveau eller sætter dem tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dunkelt alle Displays auf deine letzte Abdunkelstufe ab oder hebt die Abdunklung wieder auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χαμηλώνει όλες τις οθόνες στο τελευταίο σας επίπεδο χαμηλώματος ή τις επαναφέρει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenúa todas las pantallas a tu último nivel de atenuación o las devuelve a su nivel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Himmentää kaikki näytöt viimeisimpään himmennystasoon tai palauttaa ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assombrit tous les écrans à votre dernier niveau d’assombrissement, ou les rétablit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעמעם את כל הצגים לרמת העמעום האחרונה, או מחזיר אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी डिस्प्ले को आपके पिछले डिम स्तर पर ले जाता है, या उन्हें वापस लाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatamnjuje sve zaslone na posljednju razinu zatamnjenja ili ih vraća."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden kijelzőt a legutóbbi sötétítési szintre sötétít, vagy visszaállítja őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meredupkan semua layar ke level redup terakhir Anda, atau mengembalikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscura tutti gli schermi all’ultimo livello di oscuramento o li riporta al loro livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのディスプレイを前回の減光レベルまで暗くするか、元に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 디스플레이를 마지막으로 사용한 레벨로 어둡게 하거나 원래대로 되돌립니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memalapkan setiap paparan ke tahap malap terakhir anda, atau mengembalikannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demper alle skjermer til det siste dempenivået, eller setter dem tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimt alle beeldschermen tot je laatste dimniveau, of zet ze terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyciemnia wszystkie wyświetlacze do ostatniego poziomu przyciemnienia lub przywraca ich jasność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escurece todas as telas até o último nível de escurecimento ou as traz de volta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escurece todos os monitores até ao último nível de escurecimento ou repõe‑nos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Întunecă toate afișajele la ultimul nivel de întunecare sau le readuce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затемняет все дисплеи до последнего уровня затемнения или убирает затемнение."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stmaví všetky displeje na poslednú úroveň stmavenia alebo ich vráti späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatemni vse zaslone na zadnjo raven zatemnitve ali jih vrne nazaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonar ned alla skärmar till din senaste nedtoningsnivå eller återställer dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หรี่แสงจอภาพทั้งหมดไปยังระดับที่หรี่ไว้ล่าสุด หรือคืนกลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm ekranları son karartma düzeyinize karartır ya da eski hâline getirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затемнює всі дисплеї до останнього рівня затемнення або прибирає затемнення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm tối mọi màn hình xuống mức làm tối gần nhất, hoặc đưa chúng trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将所有显示器调暗至上次的调暗级别，或将其恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將所有顯示器調暗至你上次的調暗等級，或將其恢復。"
          }
        }
      }
    },
