    "Moving one slider moves the others. Each display still stops at its own limit." : {
      "comment" : "Settings ▸ Displays: footnote of Same level on all displays",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moving one slider moves the others. Each display still stops at its own limit."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En moure un regulador, es mouen els altres. Cada pantalla continua aturant‑se al seu propi límit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posunutím jednoho jezdce se posunou i ostatní. Každý monitor se ale zastaví na svém vlastním limitu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du flytter én skyder, flytter de andre sig også. Hver skærm stopper stadig ved sin egen grænse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Regler bewegst, bewegen sich die anderen mit. Dabei hält jedes Display weiterhin seine eigene Grenze ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μετακίνηση ενός ρυθμιστικού μετακινεί και τα υπόλοιπα. Κάθε οθόνη ωστόσο σταματά στο δικό της όριο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al mover un regulador se mueven los demás. Cada pantalla sigue deteniéndose en su propio límite."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhden liukusäätimen siirtäminen siirtää muitakin. Kukin näyttö pysähtyy silti omaan rajaansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacer un curseur déplace les autres. Chaque écran s’arrête toujours à sa propre limite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moving one slider moves the others. Each display still stops at its own limit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moving one slider moves the others. Each display still stops at its own limit."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomicanje jednog klizača pomiče i ostale. Svaki se zaslon i dalje zaustavlja na vlastitoj granici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy csúszka mozgatása a többit is mozgatja. Minden kijelző továbbra is a saját határánál áll meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moving one slider moves the others. Each display still stops at its own limit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostando un cursore si spostano anche gli altri. Ogni schermo si ferma comunque al proprio limite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moving one slider moves the others. Each display still stops at its own limit."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moving one slider moves the others. Each display still stops at its own limit."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moving one slider moves the others. Each display still stops at its own limit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du flytter én skyveknapp, flyttes de andre også. Hver skjerm stopper fortsatt ved sin egen grense."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je één schuifknop verplaatst, bewegen de andere mee. Elk beeldscherm stopt nog steeds bij zijn eigen limiet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesunięcie jednego suwaka przesuwa pozostałe. Każdy wyświetlacz nadal zatrzymuje się na własnym limicie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover um controle deslizante move os outros. Cada tela continua parando no próprio limite."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover um nivelador move os outros. Cada monitor continua a parar no seu próprio limite."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutarea unui glisor le mută și pe celelalte. Fiecare afișaj se oprește în continuare la propria limită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ползунки всех дисплеев двигаются вместе. Каждый дисплей по-прежнему останавливается на своём пределе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posunutím jedného posuvníka sa posunú aj ostatné. Každý displej sa však zastaví na svojom vlastnom limite."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premik enega drsnika premakne tudi druge. Vsak zaslon se še vedno ustavi pri svoji omejitvi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du flyttar ett reglage flyttas de andra också. Varje skärm stannar ändå vid sin egen gräns."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moving one slider moves the others. Each display still stops at its own limit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sürgüyü hareket ettirmek diğerlerini de hareket ettirir. Her ekran yine de kendi sınırında durur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повзунки всіх дисплеїв рухаються разом. Кожен дисплей і далі зупиняється на своїй межі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moving one slider moves the others. Each display still stops at its own limit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moving one slider moves the others. Each display still stops at its own limit."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Moving one slider moves the others. Each display still stops at its own limit."
          }
        }
      }
    },
