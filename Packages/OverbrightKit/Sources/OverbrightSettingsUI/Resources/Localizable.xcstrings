    "Lights your face on video calls with a glowing frame around the screen." : {
      "comment" : "Settings ▸ Fill Light: footnote of the Fill Light switch",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيء وجهك أثناء مكالمات الفيديو بإطار متوهج حول الشاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il·lumina la teva cara a les videotrucades amb un marc lluminós al voltant de la pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při videohovorech vám osvětlí obličej zářícím rámečkem kolem obrazovky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyser dit ansigt op under videoopkald med en lysende ramme rundt om skærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beleuchtet bei Videoanrufen dein Gesicht mit einem leuchtenden Rahmen um den Bildschirm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φωτίζει το πρόσωπό σας στις βιντεοκλήσεις με ένα φωτεινό πλαίσιο γύρω από την οθόνη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilumina tu cara en las videollamadas con un marco luminoso alrededor de la pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valaisee kasvosi videopuheluissa hehkuvalla kehyksellä näytön reunoilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éclaire votre visage pendant les appels vidéo grâce à un cadre lumineux autour de l’écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאיר את הפנים בשיחות וידאו בעזרת מסגרת זוהרת סביב המסך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वीडियो कॉल के दौरान स्क्रीन के चारों ओर एक चमकते फ़्रेम से आपके चेहरे को रोशन करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osvjetljava vaše lice tijekom videopoziva svjetlećim okvirom oko zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A képernyő körüli világító kerettel megvilágítja az arcát videohívások közben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menerangi wajah Anda saat panggilan video dengan bingkai bercahaya di sekeliling layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illumina il tuo viso durante le videochiamate con una cornice luminosa intorno allo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオ通話中、画面の周囲に光る枠を表示して顔を照らします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영상 통화 중에 화면 가장자리에 빛나는 테두리를 표시하여 얼굴을 비춥니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menerangi wajah anda semasa panggilan video dengan bingkai bercahaya di sekeliling skrin."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyser opp ansiktet ditt i videosamtaler med en lysende ramme rundt skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlicht je gezicht tijdens videogesprekken met een gloeiende rand rond het scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oświetla Twoją twarz podczas rozmów wideo świecącą ramką wokół ekranu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilumina seu rosto em videochamadas com uma moldura luminosa ao redor da tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilumina o seu rosto nas videochamadas com uma moldura luminosa à volta do ecrã."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vă luminează fața în apelurile video cu un cadru luminos în jurul ecranului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освещает лицо во время видеозвонков светящейся рамкой по краям экрана."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri videohovoroch vám osvetlí tvár žiariacim rámčekom okolo obrazovky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med videoklici vam osvetli obraz s svetlečim okvirjem okoli zaslona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyser upp ditt ansikte i videosamtal med en lysande ram runt skärmen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่องสว่างใบหน้าของคุณระหว่างการโทรวิดีโอด้วยกรอบเรืองแสงรอบหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüntülü görüşmelerde ekranın çevresindeki parlak bir çerçeveyle yüzünüzü aydınlatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освітлює обличчя під час відеодзвінків світлою рамкою по краях екрана."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiếu sáng khuôn mặt bạn trong cuộc gọi video bằng một khung phát sáng quanh màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频通话时，在屏幕四周显示发光边框来照亮你的脸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在視訊通話時，以螢幕周圍的發光邊框照亮你的臉。"
          }
        }
      }
    },
