    "Your displays return to Standard. Open Overbright again from Finder or Spotlight." : {
      "comment" : "Settings ▸ General: footnote of Quit Overbright",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود شاشاتك إلى المستوى القياسي. افتح Overbright مرة أخرى من فايندر أو الباحث."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pantalles tornen a Estàndard. Torna a obrir l’Overbright des del Finder o l’Spotlight."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitory se vrátí na standardní jas. Overbright znovu otevřete z Finderu nebo pomocí Spotlightu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine skærme vender tilbage til Standard. Åbn Overbright igen fra Finder eller Spotlight."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Displays kehren zu Standard zurück. Öffne Overbright erneut über den Finder oder Spotlight."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι οθόνες σας επιστρέφουν στο Τυπικό. Ανοίξτε ξανά το Overbright από το Finder ή το Spotlight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus pantallas vuelven a Estándar. Vuelve a abrir Overbright desde el Finder o Spotlight."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytöt palaavat vakiotasolle. Avaa Overbright uudelleen Finderista tai Spotlightista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos écrans reviennent au niveau Standard. Rouvrez Overbright depuis le Finder ou Spotlight."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגים יחזרו ל״סטנדרט״. אפשר לפתוח שוב את Overbright מ-Finder או מ-Spotlight."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके डिस्प्ले मानक पर लौट आते हैं। Overbright को Finder या Spotlight से फिर से खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaši se zasloni vraćaju na razinu “Standardno”. Overbright ponovno otvorite iz Findera ili Spotlighta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kijelzők visszaállnak alapszintre. Az Overbrightot újra megnyithatja a Finderből vagy a Spotlightból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar Anda kembali ke Standar. Buka Overbright lagi dari Finder atau Spotlight."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi schermi tornano a Standard. Apri di nuovo Overbright dal Finder o da Spotlight."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイは標準に戻ります。OverbrightはFinderまたはSpotlightから再度開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이가 표준으로 돌아갑니다. Finder 또는 Spotlight에서 Overbright를 다시 열 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paparan anda kembali kepada Standard. Buka Overbright semula daripada Finder atau Spotlight."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjermene går tilbake til Standard. Åpne Overbright igjen fra Finder eller Spotlight."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je beeldschermen gaan terug naar ‘Standaard’. Open Overbright opnieuw vanuit de Finder of Spotlight."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlacze wrócą do poziomu „Standard”. Overbright możesz ponownie otworzyć z Findera lub ze Spotlight."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas telas voltam ao Padrão. Abra o Overbright de novo pelo Finder ou pelo Spotlight."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os monitores voltam a “Padrão”. Pode voltar a abrir o Overbright a partir do Finder ou do Spotlight."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișajele revin la Standard. Deschideți din nou Overbright din Finder sau Spotlight."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисплеи вернутся к уровню «Стандарт». Снова открыть Overbright можно из Finder или Spotlight."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displeje sa vrátia na štandardný jas. Overbright znova otvoríte z Findera alebo zo Spotlightu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasloni se vrnejo na standardno svetlost. Overbright znova odprete iz Finderja ali Spotlighta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina skärmar återgår till Standard. Öppna Overbright igen från Finder eller Spotlight."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จอภาพของคุณจะกลับสู่มาตรฐาน เปิด Overbright อีกครั้งได้จาก Finder หรือ Spotlight"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranlarınız Standart’a döner. Overbright’ı Finder’dan veya Spotlight’tan yeniden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисплеї повернуться до рівня «Стандарт». Знову відкрити Overbright можна з Finder або Spotlight."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màn hình của bạn trở về mức Tiêu chuẩn. Mở lại Overbright từ Finder hoặc Spotlight."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的显示器将恢复为标准。可从访达或聚焦再次打开Overbright。"
          }
        },
        "zh-Hant" : {
