    "Use this if colors look wrong after another app quit." : {
      "comment" : "Settings ▸ Advanced: footnote of Reset Display Colors",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Use this if colors look wrong after another app quit."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes servir això si els colors es veuen malament després que s’hagi tancat una altra app."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte, pokud barvy po ukončení jiné aplikace nevypadají správně."
          }
        },
        "da" : {
