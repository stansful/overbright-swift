          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บนแทร็คแพด Force Touch ที่ระดับมาตรฐานและที่ระดับที่ตั้งไว้ล่วงหน้าแต่ละระดับ"
