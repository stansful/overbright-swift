            "value" : "Wyłącza się kilka sekund po wyłączeniu kamery."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É desativada alguns segundos depois que a câmera deixa de ser usada."
          }
        },
        "pt-PT" : {
