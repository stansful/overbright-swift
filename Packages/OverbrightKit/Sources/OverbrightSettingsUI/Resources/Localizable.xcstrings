        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert trykk på «Lysere» eller «Mindre lyst» endrer lyset med omtrent en femtedel («Vanlig») eller omtrent %@ («Fin»)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke druk op ‘Helderder’ of ‘Minder helder’ verandert het licht met ongeveer een vijfde (‘Normaal’) of ongeveer %@ (‘Fijn’)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde naciśnięcie „Jaśniej” lub „Mniej jasno” zmienia światło o około jedną piątą („Zwykły”) lub o około %@ („Drobny”)."
          }
