          }
        }
      }
    },
    "Type Shortcut" : {
      "comment" : "Settings ▸ Shortcuts: the recorder button while it waits for keys (title case)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب الاختصار"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prem la drecera"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte zkratku"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på tastaturgenvej"
          }
        },
        "de" : {
