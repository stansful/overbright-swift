    "Uses the display’s extra range when it has one, so the light can be brighter than white." : {
      "comment" : "Settings ▸ Fill Light: footnote of Brightness",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uses the display’s extra range when it has one, so the light can be brighter than white."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa servir el marge extra de la pantalla quan en té, perquè la llum pugui ser més brillant que el blanc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Využívá rezervu jasu monitoru, pokud ji má, takže světlo může být jasnější než bílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger skærmens lysreserve, når den har en, så lyset kan blive lysere end hvid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzt die Helligkeitsreserve des Displays, falls vorhanden, sodass das Licht heller als Weiß sein kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιεί το περιθώριο φωτεινότητας της οθόνης, αν υπάρχει, ώστε το φως να είναι φωτεινότερο από το λευκό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el margen de brillo de la pantalla cuando lo tiene, así que la luz puede ser más brillante que el blanco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttää näytön kirkkausvaraa, jos sellainen on, joten valo voi olla valkoista kirkkaampaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise la marge de luminosité de l’écran lorsqu’il en a une, pour que la lumière puisse être plus vive que le blanc."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uses the display’s extra range when it has one, so the light can be brighter than white."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uses the display’s extra range when it has one, so the light can be brighter than white."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi rezervu svjetline zaslona kad postoji, pa svjetlo može biti jače od bijele."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha van, a kijelző fényerőtartalékát használja, így a fény a fehérnél is világosabb lehet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uses the display’s extra range when it has one, so the light can be brighter than white."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il margine di luminosità dello schermo quando c’è, così la luce può essere più intensa del bianco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uses the display’s extra range when it has one, so the light can be brighter than white."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uses the display’s extra range when it has one, so the light can be brighter than white."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uses the display’s extra range when it has one, so the light can be brighter than white."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruker skjermens lysreserve når den har en, så lyset kan bli lysere enn hvitt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt het extra bereik van het beeldscherm als dat er is, zodat het licht feller kan zijn dan wit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykorzystuje zapas jasności wyświetlacza, jeśli jest dostępny, więc światło może być jaśniejsze niż biel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa a margem de brilho da tela quando ela existe, então a luz pode ser mais clara que o branco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa a margem extra do monitor, se existir, para que a luz possa ser mais brilhante do que o branco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește rezerva de luminozitate a afișajului, dacă există, astfel încât lumina poate fi mai puternică decât albul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует запас яркости дисплея, если он есть, поэтому свет может быть ярче белого."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Využíva rezervu jasu displeja, ak ju má, takže svetlo môže byť jasnejšie než biela."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporablja rezervo svetlosti zaslona, če jo ima, zato je lahko svetloba svetlejša od bele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använder skärmens ljusreserv när den finns, så att ljuset kan bli ljusare än vitt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uses the display’s extra range when it has one, so the light can be brighter than white."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranın parlaklık payı varsa onu kullanır; böylece ışık beyazdan daha parlak olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовує запас яскравості дисплея, якщо він є, тож світло може бути яскравішим за білий."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
