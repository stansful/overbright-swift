    "Add extra brightness only near full brightness" : {
      "comment" : "Settings ▸ Displays: switch (extra brightness fades out as the display brightness goes down)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إضافة الإضاءة الإضافية فقط قرب الإضاءة الكاملة"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix brillantor extra només a prop de la brillantor màxima"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidávat extra jas jen při téměř plném jasu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj kun ekstra lysstyrke nær fuld lysstyrke"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusatzhelligkeit nur nahe voller Helligkeit hinzufügen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθήκη επιπλέον φωτεινότητας μόνο κοντά στην πλήρη φωτεινότητα"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir brillo extra solo cerca del brillo máximo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä lisäkirkkautta vain lähes täydellä kirkkaudella"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’ajouter de la luminosité supplémentaire que près du maximum"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוספת בהירות נוספת רק סמוך לבהירות מלאה"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ पूरी ब्राइटनेस के पास अतिरिक्त ब्राइटनेस जोड़ें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatna svjetlina samo blizu pune svjetline"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra fényerő csak teljes fényerő közelében"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan kecerahan ekstra hanya mendekati kecerahan penuh"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi luminosità extra solo vicino alla luminosità massima"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大輝度付近でのみ追加の輝度を加える"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 밝기 근처에서만 추가 밝기 더하기"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berikan kecerahan tambahan hanya berhampiran kecerahan penuh"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til ekstra lysstyrke bare nær full lysstyrke"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg alleen extra helderheid toe bij bijna volle helderheid"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodawaj dodatkową jasność tylko blisko pełnej jasności"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar brilho extra só perto do brilho máximo"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar brilho extra só perto do brilho máximo"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luminozitate suplimentară doar aproape de maxim"
