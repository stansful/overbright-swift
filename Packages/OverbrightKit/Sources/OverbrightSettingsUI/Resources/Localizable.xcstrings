    "Outside these hours Overbright stays at Standard. Dimming still works." : {
      "comment" : "Settings ▸ Automations: footnote of the schedule switch",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Outside these hours Overbright stays at Standard. Dimming still works."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fora d’aquestes hores, l’Overbright es manté a Estàndard. L’atenuació continua funcionant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mimo tuto dobu zůstává Overbright na standardním jasu. Ztmavení dál funguje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden for dette tidsrum forbliver Overbright på Standard. Dæmpning virker stadig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außerhalb dieser Zeiten bleibt Overbright bei Standard. Abdunkeln funktioniert weiterhin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτός αυτών των ωρών, το Overbright μένει στο Τυπικό. Το χαμήλωμα εξακολουθεί να λειτουργεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuera de este horario, Overbright se queda en Estándar. La atenuación sigue funcionando."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näiden aikojen ulkopuolella Overbright pysyy vakiotasolla. Himmennys toimii edelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En dehors de ces horaires, Overbright reste au niveau Standard. L’assombrissement fonctionne toujours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Outside these hours Overbright stays at Standard. Dimming still works."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Outside these hours Overbright stays at Standard. Dimming still works."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvan tog vremena Overbright ostaje na razini “Standardno”. Zatamnjenje i dalje radi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen időszakon kívül az Overbright alapszinten marad. A sötétítés továbbra is működik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Outside these hours Overbright stays at Standard. Dimming still works."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al di fuori di questi orari Overbright resta a Standard. L’oscuramento funziona comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Outside these hours Overbright stays at Standard. Dimming still works."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Outside these hours Overbright stays at Standard. Dimming still works."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Outside these hours Overbright stays at Standard. Dimming still works."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utenfor disse tidene holder Overbright seg på Standard. Demping fungerer fortsatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buiten deze tijden blijft Overbright op ‘Standaard’. Dimmen werkt nog steeds."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poza tymi godzinami Overbright pozostaje na poziomie „Standard”. Przyciemnianie nadal działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
