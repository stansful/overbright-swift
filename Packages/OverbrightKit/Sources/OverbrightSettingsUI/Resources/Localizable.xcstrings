        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spajanje sitnog okidača za rezervu svjetline zaslona sa skaliranjem tablice boja. Kod nije kopiran."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
