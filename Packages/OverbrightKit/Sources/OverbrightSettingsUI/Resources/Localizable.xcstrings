    "“While playing” pauses while the app keeps your Mac awake for video." : {
      "comment" : "Settings ▸ Automations: note under the app list about the While playing mode",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف الخيار \"أثناء التشغيل\" مؤقتًا ما دام التطبيق يُبقي جهاز Mac في وضع التنبيه لتشغيل فيديو."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Durant la reproducció” posa en pausa mentre l’app manté el Mac actiu per reproduir vídeo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volba „Při přehrávání“ pozastavuje, dokud aplikace kvůli videu brání Macu v uspání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Under afspilning” sætter ekstra lysstyrke på pause, mens appen holder din Mac vågen for at afspille video."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bei Wiedergabe“ pausiert, solange die App deinen Mac für ein Video wach hält."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιλογή «Κατά την αναπαραγωγή» θέτει σε παύση όσο η εφαρμογή κρατά το Mac σας ξύπνιο για βίντεο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Al reproducir” pausa mientras la app mantiene el Mac activo para reproducir vídeo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Toiston aikana” pitää tauon, kun appi pitää Macin hereillä videota varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Pendant la lecture » met en pause tant que l’app garde votre Mac éveillé pour une vidéo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״בזמן ניגון״ משהה כל עוד היישום משאיר את ה-Mac ער לצורך וידאו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“चलाते समय” तब पॉज़ करता है जब ऐप वीडियो के लिए आपके Mac को जगाए रखता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Tijekom reprodukcije” pauzira dok aplikacija drži Mac budnim radi videa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Lejátszás közben” akkor szüneteltet, amikor az app videó miatt ébren tartja a Macet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Saat memutar” menjeda selama app membuat Mac Anda tetap aktif untuk video."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Durante la riproduzione” mette in pausa mentre l’app tiene attivo il Mac per riprodurre video."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“再生中”を選択すると、Appがビデオ再生のためにMacをスリープさせないようにしている間、一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘재생 중’은 앱이 비디오 재생을 위해 Mac을 깨어 있게 하는 동안 일시 정지합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Semasa memainkan” menjeda semasa app memastikan Mac anda berjaga untuk video."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Under avspilling» setter ekstra lysstyrke på pause mens appen holder Macen våken for video."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Tijdens afspelen’ pauzeert zolang de app je Mac wakker houdt voor video."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcja „Podczas odtwarzania” wstrzymuje, gdy aplikacja nie pozwala Macowi przejść w stan uśpienia, aby odtwarzać wideo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Durante a reprodução” pausa enquanto o app mantém o Mac ativo para vídeo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Durante a reprodução” coloca em pausa enquanto a aplicação mantém o Mac ativo para reproduzir vídeo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„În timpul redării” pune pe pauză cât timp aplicația menține Mac‑ul activ pentru video."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вариант «Во время воспроизведения» ставит паузу, пока приложение воспроизводит видео и не даёт Mac уйти в режим сна."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možnosť „Pri prehrávaní“ pozastavuje, kým apka kvôli videu bráni Macu v uspaní."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možnost »Med predvajanjem« začasno ustavi, dokler aplikacija zaradi videa preprečuje Macu preklop v mirovanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Vid uppspelning” pausar medan appen håller din Mac vaken för video."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ขณะเล่น” จะหยุดพักขณะที่แอปทำให้ Mac ไม่เข้าสู่โหมดพักเครื่องเพื่อเล่นวิดีโอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Oynatırken”, uygulama video için Mac’inizi uyanık tuttuğu sürece duraklatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Варіант «Під час відтворення» ставить паузу, поки програма відтворює відео й не дає Mac перейти в режим сну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Khi đang phát” tạm dừng khi ứng dụng giữ máy Mac thức để phát video."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“播放时”后，当App为播放视频而使Mac保持唤醒时会暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「播放時」會在App為播放影片而讓你的Mac保持喚醒時暫停。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}