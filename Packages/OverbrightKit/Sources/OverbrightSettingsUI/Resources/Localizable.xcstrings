          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur ändringar i färgtabellen beter sig i skärmavbilder. Ingen kod kopierades."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลักษณะของการเปลี่ยนแปลงตารางสีในภาพหน้าจอ ไม่มีการคัดลอกโค้ด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renk tablosu değişikliklerinin ekran resimlerinde nasıl davrandığı. Hiçbir kod kopyalanmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як зміни колірної таблиці виглядають на знімках екрана. Код не копіювався."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cách các thay đổi bảng màu thể hiện trong ảnh chụp màn hình. Không sao chép mã nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜色表更改在截屏中的表现。未拷贝任何代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色彩表更改在截圖中的表現方式。未拷貝任何程式碼。"
          }
        }
      }
    },
