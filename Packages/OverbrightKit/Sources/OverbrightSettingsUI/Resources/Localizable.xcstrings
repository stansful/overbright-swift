    "When it’s hidden, open Overbright from Finder or Spotlight to see Settings." : {
      "comment" : "Settings ▸ General: footnote of Show menu bar icon",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "When it’s hidden, open Overbright from Finder or Spotlight to see Settings."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan està oculta, obre l’Overbright des del Finder o l’Spotlight per veure la configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je skrytá, otevřete Overbright z Finderu nebo pomocí Spotlightu a zobrazí se Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når det er skjult, kan du åbne Overbright fra Finder eller Spotlight for at se indstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es ausgeblendet ist, öffne Overbright über den Finder oder Spotlight, um die Einstellungen zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι κρυφό, ανοίξτε το Overbright από το Finder ή το Spotlight για να δείτε τις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está oculto, abre Overbright desde el Finder o Spotlight para ver los ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun se on kätkettynä, avaa Overbright Finderista tai Spotlightista, niin näet asetukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu’elle est masquée, ouvrez Overbright depuis le Finder ou Spotlight pour afficher les réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
