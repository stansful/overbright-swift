    "Turns Overbright off at once, from anywhere. Your levels are kept for next time." : {
      "comment" : "Settings ▸ Shortcuts: footnote of Back to Standard",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف Overbright فورًا من أي مكان. وتُحفظ مستوياتك للمرة القادمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva l’Overbright a l’instant, des de qualsevol lloc. Els teus nivells es conserven per a la propera vegada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okamžitě vypne Overbright, ať jste kdekoli. Úrovně zůstanou uložené na příště."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår Overbright fra med det samme, uanset hvor du er. Dine niveauer gemmes til næste gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet Overbright sofort aus, egal wo du bist. Deine Stufen bleiben für das nächste Mal erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποιεί αμέσως το Overbright, από οπουδήποτε. Τα επίπεδά σας διατηρούνται για την επόμενη φορά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva Overbright al instante, desde cualquier lugar. Tus niveles se conservan para la próxima vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laittaa Overbrightin heti pois päältä mistä tahansa. Tasosi säilyvät seuraavaa kertaa varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactive Overbright immédiatement, où que vous soyez. Vos niveaux sont conservés pour la prochaine fois."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מכבה את Overbright מיד, מכל מקום. הרמות נשמרות לפעם הבאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright को कहीं से भी तुरंत बंद करता है। आपके स्तर अगली बार के लिए बने रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmah isključuje Overbright, bilo gdje. Vaše razine čuvaju se za sljedeći put."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bárhonnan azonnal kikapcsolja az Overbrightot. A szintek megmaradnak a következő alkalomra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsung mematikan Overbright, dari mana saja. Level Anda disimpan untuk lain kali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva subito Overbright, da qualsiasi app. I tuoi livelli vengono conservati per la prossima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこからでもすぐにOverbrightをオフにします。レベルは次回のために保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어디에서든 즉시 Overbright를 끕니다. 레벨은 다음을 위해 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mematikan Overbright serta-merta, dari mana-mana sahaja. Tahap anda disimpan untuk lain kali."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår av Overbright med en gang, fra hvor som helst. Nivåene dine tas vare på til neste gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakelt Overbright meteen uit, waar je ook bent. Je niveaus worden bewaard voor de volgende keer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od razu wyłącza Overbright, z dowolnego miejsca. Poziomy zostają zachowane na następny raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativa o Overbright imediatamente, de qualquer lugar. Seus níveis são mantidos para a próxima vez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativa o Overbright de imediato, a partir de qualquer lado. Os níveis são guardados para a próxima vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivează imediat Overbright, de oriunde. Nivelurile dvs. sunt păstrate pentru data viitoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сразу выключает Overbright из любого приложения. Уровни сохраняются до следующего раза."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okamžite vypne Overbright, nech ste kdekoľvek. Úrovne zostanú uložené na budúce."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takoj izklopi Overbright, kjer koli ste. Ravni se ohranijo za naslednjič."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stänger av Overbright direkt, var du än är. Dina nivåer sparas till nästa gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิด Overbright ทันทีจากทุกที่ ระดับของคุณจะถูกเก็บไว้สำหรับครั้งถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright’ı her yerden hemen kapatır. Düzeyleriniz bir sonraki sefer için korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одразу вимикає Overbright з будь-якої програми. Рівні зберігаються до наступного разу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt Overbright ngay lập tức, từ bất cứ đâu. Các mức của bạn được giữ cho lần sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随时随地立即关闭Overbright。你的级别会保留到下次使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隨時隨地立即關閉Overbright。你的等級會保留到下次使用。"
          }
        }
      }
    },
    "Turns off a few seconds after the camera stops." : {
      "comment" : "Settings ▸ Fill Light: footnote of Turn on while a camera is in use",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف بعد بضع ثوانٍ من توقف الكاميرا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es desactiva uns segons després que s’aturi la càmera."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypne se několik sekund po vypnutí kamery."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slås fra et par sekunder, efter at kameraet er stoppet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet sich einige Sekunden nach dem Ausschalten der Kamera aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποιείται λίγα δευτερόλεπτα αφού σταματήσει η κάμερα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desactiva unos segundos después de que la cámara deje de usarse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammuu muutaman sekunnin kuluttua siitä, kun kamera pysähtyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se désactive quelques secondes après l’arrêt de la caméra."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נכבה כמה שניות אחרי שהמצלמה מפסיקה לפעול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैमरा रुकने के कुछ सेकंड बाद बंद हो जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isključuje se nekoliko sekundi nakon što se kamera zaustavi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Néhány másodperccel a kamera leállása után kikapcsol."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mati beberapa detik setelah kamera berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si disattiva qualche secondo dopo che la fotocamera si spegne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラが停止してから数秒後にオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라가 꺼지고 몇 초 후에 꺼집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
