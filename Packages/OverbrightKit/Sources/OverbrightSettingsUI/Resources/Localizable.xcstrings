          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slås av noen sekunder etter at kameraet stopper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaat een paar seconden nadat de camera stopt uit."
          }
        },
        "pl" : {
          "stringUnit" : {
