    "Press to record new keys." : {
      "comment" : "VoiceOver: hint of a shortcut recorder in Settings",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط لتسجيل مفاتيح جديدة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prem per gravar tecles noves."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stisknutím nahrajete nové klávesy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at optage nye taster."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken, um neue Tasten aufzunehmen."
          }
        },
        "el" : {
          "stringUnit" : {
