          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myšlenka, na které stojí režim kompatibility: překryvná vrstva na celou obrazovku, která násobí obraz. Žádný kód nebyl zkopírován."
          }
        },
        "da" : {
          "stringUnit" : {
