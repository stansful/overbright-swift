            "state" : "translated",
            "value" : "Brug dette, hvis farverne ser forkerte ud, efter at en anden app er afsluttet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende dies, wenn die Farben nach dem Beenden einer anderen App falsch aussehen."
