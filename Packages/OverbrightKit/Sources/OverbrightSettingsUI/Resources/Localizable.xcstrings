    "Adds headroom samples to the system log for troubleshooting." : {
      "comment" : "Settings ▸ Advanced: footnote of Detailed logging (“headroom” is allowed in Advanced)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف عينات headroom إلى سجل النظام لاستكشاف الأخطاء وإصلاحها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix mostres de headroom al registre del sistema per resoldre problemes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro řešení potíží zapisuje do systémového protokolu vzorky rezervy jasu (headroom)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjer målinger af lysreserven (headroom) i systemloggen til fejlfinding."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt Headroom-Messwerte zur Fehlersuche ins Systemprotokoll."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέτει δείγματα headroom στο αρχείο καταγραφής του συστήματος για την αντιμετώπιση προβλημάτων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade al registro del sistema muestras del margen de brillo (headroom) para solucionar problemas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää headroom-mittauksia järjestelmälokiin vianmääritystä varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute des mesures de headroom au journal système pour le dépannage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסיף דגימות headroom ליומן המערכת לצורך פתרון בעיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समस्या निवारण के लिए सिस्टम लॉग में headroom के सैंपल जोड़ता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje uzorke rezerve svjetline (headroom) u zapisnik sustava radi rješavanja problema."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hibaelhárításhoz headroom-mintákat (fényerőtartalék) ír a rendszernaplóba."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan sampel rentang ekstra (headroom) ke log sistem untuk pemecahan masalah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge al log di sistema campioni del margine di luminosità (headroom) per la risoluzione dei problemi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラブルシューティングのため、ヘッドルームの測定値をシステムログに追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문제 해결을 위해 헤드룸 샘플을 시스템 로그에 추가합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambah sampel julat tambahan (headroom) pada log sistem untuk penyelesaian masalah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger til headroom-målinger i systemloggen for feilsøking."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt headroommetingen toe aan het systeemlogboek om problemen op te lossen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje do dziennika systemowego próbki zapasu jasności (headroom) w celu rozwiązywania problemów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona ao registro do sistema amostras da margem de brilho (headroom) para solucionar problemas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona amostras da margem extra (headroom) ao registo do sistema para resolução de problemas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă în jurnalul sistemului eșantioane de rezervă (headroom) pentru depanare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет в системный журнал замеры запаса яркости (headroom) для устранения неполадок."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na riešenie problémov zapisuje do systémového denníka vzorky rezervy jasu (headroom)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za odpravljanje težav v sistemski dnevnik dodaja vzorce rezerve svetlosti (headroom)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till mätvärden för ljusreserven (headroom) i systemloggen för felsökning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มตัวอย่างค่า headroom ลงในบันทึกระบบเพื่อใช้แก้ไขปัญหา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorun gidermek için sistem günlüğüne headroom örnekleri ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає до системного журналу заміри запасу яскравості (headroom) для усунення неполадок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm các mẫu đo dải sáng bổ sung (headroom) vào nhật ký hệ thống để khắc phục sự cố."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将亮度余量（headroom）采样写入系统日志，用于故障排除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將亮度餘裕（headroom）取樣加入系統記錄以便排除問題。"
          }
        }
      }
    },
