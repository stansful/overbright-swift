          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "OLED displays get a lower Safe limit and pause extra brightness when idle."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "OLED displays get a lower Safe limit and pause extra brightness when idle."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED-skjermer får en lavere «Trygg»-grense og setter ekstra lysstyrke på pause når de ikke er i bruk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED-beeldschermen krijgen een lagere limiet ‘Veilig’ en pauzeren extra helderheid als ze inactief zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlacze OLED mają niższy limit „Bezpieczny” i wstrzymują dodatkową jasność podczas bezczynności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telas OLED têm um limite “Seguro” mais baixo e pausam o brilho extra quando ficam inativas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os monitores OLED têm um limite “Seguro” mais baixo e colocam o brilho extra em pausa quando estão inativos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișajele OLED au o limită „Sigur” mai mică și pun pe pauză luminozitatea suplimentară când sunt inactive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У OLED-дисплеев предел «Безопасно» ниже, а при простое дополнительная яркость приостанавливается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displeje OLED majú nižší limit „Bezpečný“ a pri nečinnosti sa extra jas pozastaví."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasloni OLED imajo nižjo omejitev »Varno«, ob nedejavnosti pa se dodatna svetlost začasno ustavi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På OLED-skärmar är gränsen Säker lägre och extra ljusstyrka pausas vid inaktivitet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
