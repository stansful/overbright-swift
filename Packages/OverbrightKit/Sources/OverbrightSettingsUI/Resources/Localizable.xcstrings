    "macOS didn’t make extra range available on this display, so the check couldn’t run." : {
      "comment" : "Calibration: why the check ended early",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُتح macOS هامش الإضاءة على هذه الشاشة، لذا تعذر إجراء الفحص."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El macOS no ha proporcionat marge extra en aquesta pantalla, per això no s’ha pogut fer la comprovació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS na tomto monitoru nezpřístupnil rezervu jasu, takže kontrolu nebylo možné provést."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS gjorde ingen lysreserve tilgængelig på denne skærm, så tjekket kunne ikke køre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat auf diesem Display keine Helligkeitsreserve bereitgestellt, daher konnte die Prüfung nicht ausgeführt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το macOS δεν διέθεσε περιθώριο φωτεινότητας σε αυτήν την οθόνη, οπότε ο έλεγχος δεν μπόρεσε να εκτελεστεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no ha ofrecido margen de brillo en esta pantalla, así que no se ha podido hacer la comprobación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ei antanut tämän näytön kirkkausvaraa käyttöön, joten tarkistusta ei voitu suorittaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’a pas fourni de marge de luminosité sur cet écran, la vérification n’a donc pas pu avoir lieu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מערכת macOS לא סיפקה טווח נוסף בצג הזה, ולכן לא ניתן היה להריץ את הבדיקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ने इस डिस्प्ले पर अतिरिक्त रेंज उपलब्ध नहीं कराई, इसलिए जाँच नहीं चल सकी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nije omogućio rezervu svjetline na ovom zaslonu, pa provjera nije mogla započeti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A macOS nem biztosított fényerőtartalékot ezen a kijelzőn, ezért az ellenőrzés nem futhatott le."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS tidak menyediakan rentang ekstra di layar ini, jadi pemeriksaan tidak dapat dijalankan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non ha reso disponibile il margine di luminosità su questo schermo, quindi non è stato possibile eseguire il controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSがこのディスプレイで輝度の余力を提供しなかったため、確認を実行できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 이 디스플레이에서 여유 밝기를 제공하지 않아 확인을 실행할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS tidak menyediakan julat tambahan pada paparan ini, jadi semakan tidak dapat dijalankan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS gjorde ingen lysreserve tilgjengelig på denne skjermen, så kontrollen kunne ikke kjøres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS heeft op dit beeldscherm geen extra bereik beschikbaar gemaakt, dus de controle kon niet worden uitgevoerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nie udostępnił zapasu jasności na tym wyświetlaczu, więc nie można było przeprowadzić kontroli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não disponibilizou margem de brilho nesta tela, então não foi possível fazer a verificação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não disponibilizou margem extra neste monitor, por isso não foi possível fazer a verificação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nu a oferit rezervă de luminozitate pe acest afișaj, așa că verificarea nu a putut rula."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS не предоставила запас яркости на этом дисплее, поэтому проверку не удалось выполнить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS na tomto displeji nesprístupnil rezervu jasu, takže kontrolu nebolo možné vykonať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS na tem zaslonu ni sprostil rezerve svetlosti, zato preverjanja ni bilo mogoče izvesti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS gjorde ingen ljusreserv tillgänglig på den här skärmen, så kontrollen kunde inte köras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ไม่ได้ให้ช่วงเพิ่มเติมบนจอภาพนี้ จึงไม่สามารถเรียกใช้การตรวจสอบได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS bu ekranda parlaklık payı sağlamadığı için denetim yapılamadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS не надала запасу яскравості на цьому дисплеї, тому перевірку не вдалося виконати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS không cung cấp dải sáng bổ sung trên màn hình này, nên không thể chạy quá trình kiểm tra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS未在此显示器上提供亮度余量，因此无法运行检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS沒有在此顯示器上提供亮度餘裕，因此無法執行檢查。"
          }
        }
      }
    },
    "macOS may be hiding it, or the menu bar is too full to show it. You can still open Overbright from Finder or Spotlight." : {
      "comment" : "Settings ▸ General: explanation of the icon warning when the on/off shortcut is cleared",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما يخفيه macOS، أو أن شريط القوائم ممتلئ فلا يتسع له. لا يزال بإمكانك فتح Overbright من فايندر أو الباحث."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pot ser que el macOS l’amagui o que la barra de menús sigui massa plena per mostrar‑la. Encara pots obrir l’Overbright des del Finder o l’Spotlight."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možná ji skrývá macOS nebo je řádek nabídek příliš zaplněný. Overbright můžete i nadále otevřít z Finderu nebo pomocí Spotlightu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS skjuler det måske, eller også er der ikke plads til det på menulinjen. Du kan stadig åbne Overbright fra Finder eller Spotlight."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS blendet es möglicherweise aus, oder die Menüleiste ist zu voll. Du kannst Overbright weiterhin über den Finder oder Spotlight öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ίσως το κρύβει το macOS ή δεν χωράει στη γραμμή μενού επειδή είναι πολύ γεμάτη. Μπορείτε πάντως να ανοίξετε το Overbright από το Finder ή το Spotlight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que macOS lo esté ocultando o que la barra de menús esté demasiado llena para mostrarlo. Aun así, puedes abrir Overbright desde el Finder o Spotlight."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS saattaa piilottaa sen tai valikkorivi on liian täynnä sen näyttämiseen. Voit silti avata Overbrightin Finderista tai Spotlightista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS la masque peut-être, ou la barre des menus est trop pleine pour l’afficher. Vous pouvez toujours ouvrir Overbright depuis le Finder ou Spotlight."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייתכן שמערכת macOS מסתירה אותה, או ששורת התפריטים מלאה מדי. עדיין אפשר לפתוח את Overbright מ-Finder או מ-Spotlight."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
