    "Right-click or Control-click the icon for the menu." : {
      "comment" : "Settings ▸ General: footnote of Clicking the icon",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Right-click or Control-click the icon for the menu."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per obrir el menú, fes clic amb el botó dret a la icona o fes‑hi clic mentre mantens premuda la tecla de control."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabídku otevřete kliknutím na ikonu pravým tlačítkem nebo se stisknutou klávesou Control."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højreklik eller ctrl-klik på symbolet for at åbne menuen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke mit der rechten Maustaste oder bei gedrückter Control-Taste auf das Symbol, um das Menü zu öffnen."
