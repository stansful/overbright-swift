    "Each press of Brighter or Less Bright changes the light by about a fifth (Regular) or about %@ (Fine)." : {
      "comment" : "Settings ▸ Shortcuts: footnote of Step size; the argument is a percentage such as 6%",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Each press of Brighter or Less Bright changes the light by about a fifth (Regular) or about %@ (Fine)."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pulsació de “Més brillant” o “Menys brillant” canvia la llum aproximadament una cinquena part (“Normal”) o aproximadament un %@ (“Precís”)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé stisknutí „Jasněji“ nebo „Méně jasně“ změní světlo zhruba o pětinu („Běžný“) nebo zhruba o %@ („Jemný“)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert tryk på Lysere eller Mørkere ændrer lyset med ca. en femtedel (Normal) eller ca. %@ (Lille)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Drücken von „Heller“ oder „Weniger hell“ ändert das Licht um etwa ein Fünftel („Normal“) oder um etwa %@ („Fein“)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε πάτημα του «Φωτεινότερα» ή του «Λιγότερο φωτεινά» αλλάζει το φως κατά περίπου ένα πέμπτο («Κανονικό») ή κατά περίπου %@ («Μικρό»)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pulsación de “Más brillo” o “Menos brillo” cambia la luz en aproximadamente una quinta parte (“Normal”) o un %@ (“Fino”)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukin painallus (”Lisää kirkkautta” tai ”Vähennä kirkkautta”) muuttaa valoa noin viidenneksen (”Normaali”) tai noin %@ (”Tarkka”)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque pression sur « Plus lumineux » ou « Moins lumineux » change la lumière d’environ un cinquième (« Normal ») ou d’environ %@ (« Fin »)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Each press of Brighter or Less Bright changes the light by about a fifth (Regular) or about %@ (Fine)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Each press of Brighter or Less Bright changes the light by about a fifth (Regular) or about %@ (Fine)."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki pritisak na “Svjetlije” ili “Manje svijetlo” mijenja svjetlo za otprilike petinu (“Obično”) ili otprilike %@ (“Fino”)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Világosabb” vagy a „Kevésbé világos” minden lenyomása nagyjából egyötödével („Normál”) vagy nagyjából %@ értékkel („Finom”) változtat a fényen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Each press of Brighter or Less Bright changes the light by about a fifth (Regular) or about %@ (Fine)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni pressione di “Più luminoso” o “Meno luminoso” cambia la luce di circa un quinto (“Normale”) o di circa il %@ (“Piccolo”)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Each press of Brighter or Less Bright changes the light by about a fifth (Regular) or about %@ (Fine)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Each press of Brighter or Less Bright changes the light by about a fifth (Regular) or about %@ (Fine)."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Each press of Brighter or Less Bright changes the light by about a fifth (Regular) or about %@ (Fine)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert trykk på «Lysere» eller «Mindre lyst» endrer lyset med omtrent en femtedel («Vanlig») eller omtrent %@ («Fin»)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke druk op ‘Helderder’ of ‘Minder helder’ verandert het licht met ongeveer een vijfde (‘Normaal’) of ongeveer %@ (‘Fijn’)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde naciśnięcie „Jaśniej” lub „Mniej jasno” zmienia światło o około jedną piątą („Zwykły”) lub o około %@ („Drobny”)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que você pressiona “Mais Brilho” ou “Menos Brilho”, a luz muda cerca de um quinto (“Normal”) ou cerca de %@ (“Pequeno”)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que prime “Mais brilho” ou “Menos brilho”, a luz muda cerca de um quinto (“Normal”) ou cerca de %@ (“Fino”)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare apăsare pe „Mai luminos” sau „Mai puțin luminos” schimbă lumina cu aproximativ o cincime („Normal”) sau cu aproximativ %@ („Fin”)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое нажатие «Ярче» или «Менее ярко» меняет свет примерно на пятую часть («Обычный») или примерно на %@ («Мелкий»)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé stlačenie „Jasnejšie“ alebo „Menej jasne“ zmení svetlo približne o pätinu („Bežný“) alebo približne o %@ („Jemný“)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsak pritisk na »Svetleje« ali »Manj svetlo« spremeni svetlobo za približno petino (»Običajno«) ali za približno %@ (»Fino«)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje tryck på Ljusare eller Mörkare ändrar ljuset med ungefär en femtedel (Normal) eller ungefär %@ (Liten)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Each press of Brighter or Less Bright changes the light by about a fifth (Regular) or about %@ (Fine)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Daha Parlak” veya “Daha Az Parlak” kestirmesine her basıldığında ışık yaklaşık beşte bir (Normal) ya da yaklaşık %@ (Hassas) değişir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожне натискання «Яскравіше» або «Менш яскраво» змінює світло приблизно на пʼяту частину («Звичайний») або приблизно на %@ («Дрібний»)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Each press of Brighter or Less Bright changes the light by about a fifth (Regular) or about %@ (Fine)."
          }
        },
