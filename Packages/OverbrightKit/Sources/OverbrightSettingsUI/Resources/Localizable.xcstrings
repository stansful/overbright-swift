    "On a Force Touch trackpad, at Standard and at each preset." : {
      "comment" : "Settings ▸ General: footnote of Haptic feedback",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على لوحة تعقب Force Touch، عند المستوى القياسي وعند كل مستوى جاهز."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un trackpad Force Touch, a Estàndard i a cada nivell predefinit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na trackpadu Force Touch při standardním jasu a u každé přednastavené úrovně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På et Force Touch-pegefelt, ved Standard og ved hvert forindstillet niveau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einem Force Touch-Trackpad, bei Standard und bei jeder voreingestellten Stufe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε επιφάνεια αφής Force Touch, στο Τυπικό και σε κάθε προκαθορισμένο επίπεδο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un trackpad Force Touch, en Estándar y en cada nivel predefinido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
