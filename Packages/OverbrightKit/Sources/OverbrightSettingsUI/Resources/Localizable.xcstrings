    "macOS needs your approval in Login Items settings." : {
      "comment" : "Settings ▸ General: the login item waits for approval; “Login Items” is macOS’s own name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج macOS إلى موافقتك في إعدادات \"عناصر تسجيل الدخول\"."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El macOS necessita la teva aprovació a la secció Ítems d’inici de sessió de la configuració del sistema."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS vyžaduje vaše schválení v nastavení položek přihlášení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS skal have din godkendelse i indstillingerne til Loginemner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS benötigt deine Zustimmung in den Systemeinstellungen unter „Anmeldeobjekte & Erweiterungen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
