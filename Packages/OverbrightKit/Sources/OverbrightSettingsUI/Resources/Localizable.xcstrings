    "Checks how each display responds. About a minute per display." : {
      "comment" : "Settings ▸ Advanced: footnote of Run Self-Test…",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحقق من استجابة كل شاشة. نحو دقيقة واحدة لكل شاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprova com respon cada pantalla. Aproximadament un minut per pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ověří, jak každý monitor reaguje. Zhruba minuta na monitor."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjekker, hvordan hver skærm reagerer. Ca. et minut pr. skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft, wie jedes Display reagiert. Etwa eine Minute pro Display."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγχει πώς αποκρίνεται κάθε οθόνη. Περίπου ένα λεπτό ανά οθόνη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba cómo responde cada pantalla. Aproximadamente un minuto por pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkistaa, miten kukin näyttö reagoi. Noin minuutti näyttöä kohden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie comment chaque écran réagit. Environ une minute par écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בודק איך כל צג מגיב. כדקה לכל צג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जाँचता है कि हर डिस्प्ले कैसे प्रतिक्रिया देता है। हर डिस्प्ले के लिए लगभग एक मिनट।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjerava kako svaki zaslon reagira. Oko minute po zaslonu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellenőrzi, hogyan reagálnak a kijelzők. Kijelzőnként körülbelül egy perc."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memeriksa respons setiap layar. Sekitar satu menit per layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica come risponde ciascuno schermo. Circa un minuto per schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ディスプレイの反応を確認します。ディスプレイ1台につき約1分かかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 디스플레이의 반응을 확인합니다. 디스플레이당 약 1분이 걸립니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyemak cara setiap paparan bertindak balas. Kira-kira seminit bagi setiap paparan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekker hvordan hver skjerm reagerer. Omtrent ett minutt per skjerm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleert hoe elk beeldscherm reageert. Ongeveer een minuut per beeldscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdza, jak reaguje każdy wyświetlacz. Około minuty na wyświetlacz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica como cada tela responde. Cerca de um minuto por tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica como cada monitor responde. Cerca de um minuto por monitor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifică modul în care răspunde fiecare afișaj. Aproximativ un minut per afișaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяет, как реагирует каждый дисплей. Около минуты на дисплей."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overí, ako každý displej reaguje. Približne minúta na displej."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preveri, kako se odziva vsak zaslon. Približno minuta na zaslon."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollerar hur varje skärm reagerar. Ungefär en minut per skärm."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบว่าจอภาพแต่ละจอตอบสนองอย่างไร ประมาณหนึ่งนาทีต่อจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ekranın nasıl yanıt verdiğini denetler. Ekran başına yaklaşık bir dakika."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевіряє, як реагує кожен дисплей. Близько хвилини на дисплей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra cách từng màn hình phản hồi. Khoảng một phút cho mỗi màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查每台显示器的响应情况。每台显示器约需一分钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查每台顯示器的反應。每台顯示器約一分鐘。"
          }
        }
      }
    },
    "Choose what Overbright does in each Focus in Focus settings: leave it alone, turn it off, or turn it on at a level." : {
      "comment" : "Settings ▸ Automations: the Focus note; “Focus” is macOS’s own name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر في إعدادات \"التركيز\" ما يفعله Overbright في كل وضع تركيز: تركه كما هو، أو إيقافه، أو تشغيله عند مستوى معيّن."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A la secció Modes de concentració de la configuració del sistema, tria què fa l’Overbright en cada mode: deixar‑lo com està, desactivar‑lo o activar‑lo a un nivell."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nastavení Soustředění zvolte, co Overbright v jednotlivých režimech soustředění udělá: nechá vše být, vypne se, nebo se zapne na zvolené úrovni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg i indstillingerne til Fokus, hvad Overbright gør i hver fokusfunktion: lader den være, slår den fra eller slår den til på et bestemt niveau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege in den Systemeinstellungen unter „Fokus“ fest, was Overbright in jedem Fokus tut: nichts ändern, ausschalten oder mit einer bestimmten Stufe einschalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στις ρυθμίσεις «Συγκέντρωση», επιλέξτε τι κάνει το Overbright σε κάθε λειτουργία συγκέντρωσης: να μένει ως έχει, να απενεργοποιείται ή να ενεργοποιείται σε ένα επίπεδο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué hace Overbright en cada modo de concentración en los ajustes de “Modos de concentración”: no hacer nada, desactivarse o activarse a un nivel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse Keskity-tila-asetuksissa, mitä Overbright tekee kussakin Keskity-tilassa: ei tee mitään, sammuu tai käynnistyy tietylle tasolle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les réglages Concentration, choisissez ce que fait Overbright dans chaque mode Concentration : ne rien changer, le désactiver ou l’activer à un niveau donné."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בהגדרות ״ריכוז״ אפשר לבחור מה Overbright יעשה בכל מצב ריכוז: לא לשנות דבר, לכבות אותו או להפעיל אותו ברמה מסוימת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोकस सेटिंग में चुनें कि हर फ़ोकस में Overbright क्या करे: उसे वैसे ही रहने दे, बंद करे, या किसी स्तर पर चालू करे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U odjeljku Fokus u Postavkama sustava odaberite što Overbright radi u svakom Fokusu: ne mijenja se, isključuje se ili se uključuje na odabranoj razini."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Rendszerbeállítások Fókusz részében minden Fókuszhoz megadhatja, mit tegyen az Overbright: maradjon változatlan, kapcsoljon ki, vagy kapcsoljon be egy adott szinten."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih apa yang dilakukan Overbright di setiap Fokus di pengaturan Fokus: biarkan, matikan, atau nyalakan pada level tertentu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli cosa fa Overbright in ciascuna full immersion nelle impostazioni “Full immersion”: lasciare tutto com’è, disattivarsi o attivarsi a un livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“集中モード”設定で、各集中モードでのOverbrightの動作を選択できます: 変更しない、オフにする、または指定したレベルでオンにする。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘집중 모드’ 설정에서 각 집중 모드에서의 Overbright 동작을 선택하십시오. 그대로 두기, 끄기 또는 특정 레벨로 켜기 중에서 선택할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih apa yang Overbright lakukan dalam setiap Fokus dalam seting Fokus: biarkan, matikan atau hidupkan pada satu tahap."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Fokus-innstillingene velger du hva Overbright gjør i hvert fokus: lar den være, slår den av eller slår den på med et bestemt nivå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies in de instellingen voor ‘Focus’ wat Overbright doet in elke focus: niets wijzigen, uitschakelen of inschakelen op een niveau."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W ustawieniach „Tryb skupienia” wybierz, co Overbright ma robić w każdym trybie skupienia: nic nie zmieniać, wyłączać się lub włączać na wybranym poziomie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o que o Overbright faz em cada Foco nos ajustes de Foco: deixar como está, desativar ou ativar em um nível."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nas definições de Concentração, escolha o que o Overbright faz em cada modo de concentração: não alterar, desativar ou ativar num nível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În secțiunea Concentrare din Configurări sistem, alegeți ce face Overbright în fiecare mod de concentrare: rămâne neschimbat, se dezactivează sau se activează la un anumit nivel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В разделе «Фокусирование» Системных настроек можно выбрать, что Overbright делает в каждом режиме фокусирования: ничего не меняет, выключается или включается на заданном уровне."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nastaveniach Môjho času zvoľte, čo Overbright v jednotlivých režimoch Môjho času urobí: nechá všetko tak, vypne sa alebo sa zapne na zvolenej úrovni."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nastavitvah Fokus izberite, kaj naj Overbright naredi v posameznem fokusu: naj ostane nespremenjen, se izklopi ali se vklopi na izbrani ravni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj i inställningarna för Fokus vad Overbright gör i varje fokus: låter den vara, stänger av den eller slår på den på en viss nivå."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกสิ่งที่ Overbright จะทำในแต่ละโฟกัสได้ในการตั้งค่าโฟกัส: ไม่เปลี่ยนแปลง ปิด หรือเปิดที่ระดับที่กำหนด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odak ayarlarında Overbright’ın her Odak modunda ne yapacağını seçin: olduğu gibi bırakılması, kapatılması ya da bir düzeyde açılması."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У розділі «Зосередження» Системних параметрів можна вибрати, що Overbright робить у кожному режимі зосередження: нічого не змінює, вимикається чи вмикається на заданому рівні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn việc Overbright làm trong từng chế độ Tập trung ở cài đặt Tập trung: giữ nguyên, tắt hoặc bật ở một mức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“专注模式”设置中，为每个专注模式选择Overbright的行为：不更改、关闭，或以指定级别开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「專注模式」設定中選擇Overbright在每個「專注模式」下的動作：維持不變、關閉，或以特定等級開啟。"
          }
        }
      }
    },
