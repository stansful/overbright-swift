    "After a restart, nothing gets brighter until you turn Overbright on, unless you choose the first option." : {
      "comment" : "Settings ▸ General: footnote of When you log in",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "After a restart, nothing gets brighter until you turn Overbright on, unless you choose the first option."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Després de reiniciar, res no es fa més brillant fins que actives l’Overbright, tret que triïs la primera opció."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud nezvolíte první možnost, po restartu se nic nezjasní, dokud Overbright nezapnete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter en genstart bliver intet lysere, før du slår Overbright til, medmindre du vælger den første mulighed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einem Neustart wird nichts heller, bis du Overbright einschaltest, außer du wählst die erste Option."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά από επανεκκίνηση, τίποτα δεν γίνεται φωτεινότερο μέχρι να ενεργοποιήσετε το Overbright, εκτός αν διαλέξετε την πρώτη επιλογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras reiniciar, nada tendrá más brillo hasta que actives Overbright, salvo que elijas la primera opción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudelleenkäynnistyksen jälkeen mikään ei kirkastu ennen kuin laitat Overbrightin päälle, ellet valitse ensimmäistä vaihtoehtoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après un redémarrage, rien ne devient plus lumineux tant que vous n’activez pas Overbright, sauf si vous choisissez la première option."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "After a restart, nothing gets brighter until you turn Overbright on, unless you choose the first option."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "After a restart, nothing gets brighter until you turn Overbright on, unless you choose the first option."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakon ponovnog pokretanja ništa neće postati svjetlije dok ne uključite Overbright, osim ako odaberete prvu opciju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Újraindítás után semmi sem lesz világosabb, amíg be nem kapcsolja az Overbrightot, kivéve, ha az első lehetőséget választja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "After a restart, nothing gets brighter until you turn Overbright on, unless you choose the first option."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo un riavvio, nulla diventa più luminoso finché non attivi Overbright, a meno che tu non scelga la prima opzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "After a restart, nothing gets brighter until you turn Overbright on, unless you choose the first option."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "After a restart, nothing gets brighter until you turn Overbright on, unless you choose the first option."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "After a restart, nothing gets brighter until you turn Overbright on, unless you choose the first option."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter en omstart blir ingenting lysere før du slår på Overbright, med mindre du velger det første alternativet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na een herstart wordt niets helderder totdat je Overbright inschakelt, tenzij je de eerste optie kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po ponownym uruchomieniu nic nie stanie się jaśniejsze, dopóki nie włączysz Overbright, chyba że wybierzesz pierwszą opcję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de reiniciar, nada fica mais claro até você ativar o Overbright, a menos que escolha a primeira opção."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após um reinício, nada fica mais brilhante até ativar o Overbright, a menos que escolha a primeira opção."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După repornire, nimic nu devine mai luminos până nu activați Overbright, cu excepția cazului în care alegeți prima opțiune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После перезагрузки ничего не станет ярче, пока вы не включите Overbright, если только не выбран первый вариант."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak nezvolíte prvú možnosť, po reštarte sa nič nezjasní, kým Overbright nezapnete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če ne izberete prve možnosti, se po ponovnem zagonu nič ne posvetli, dokler ne vklopite aplikacije Overbright."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter en omstart blir ingenting ljusare förrän du slår på Overbright, om du inte väljer det första alternativet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "After a restart, nothing gets brighter until you turn Overbright on, unless you choose the first option."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden başlattıktan sonra, ilk seçeneği seçmediğiniz sürece Overbright’ı açana kadar hiçbir şey parlaklaşmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після перезавантаження ніщо не стане яскравішим, доки ви не ввімкнете Overbright, якщо тільки не вибрано перший варіант."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
