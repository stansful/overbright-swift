    "These limits stop extra brightness only. Dimming below the minimum always works, because it saves power." : {
      "comment" : "Settings ▸ Automations: note under the power rows",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "These limits stop extra brightness only. Dimming below the minimum always works, because it saves power."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquests límits només aturen la brillantor extra. L’atenuació per sota del mínim sempre funciona, perquè estalvia energia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato omezení zastavují jen extra jas. Ztmavení pod minimum funguje vždy, protože šetří energii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse grænser stopper kun ekstra lysstyrke. Dæmpning under minimum virker altid, fordi det sparer strøm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Grenzen stoppen nur die Zusatzhelligkeit. Abdunkeln unter das Minimum funktioniert immer, weil es Energie spart."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτά τα όρια σταματούν μόνο την επιπλέον φωτεινότητα. Το χαμήλωμα κάτω από το ελάχιστο λειτουργεί πάντα, επειδή εξοικονομεί ενέργεια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos límites solo detienen el brillo extra. La atenuación por debajo del mínimo siempre funciona, porque ahorra energía."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä rajoitukset pysäyttävät vain lisäkirkkauden. Himmennys alle minimin toimii aina, koska se säästää virtaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces limites n’arrêtent que la luminosité supplémentaire. L’assombrissement sous le minimum fonctionne toujours, car il économise de l’énergie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "These limits stop extra brightness only. Dimming below the minimum always works, because it saves power."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "These limits stop extra brightness only. Dimming below the minimum always works, because it saves power."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova ograničenja zaustavljaju samo dodatnu svjetlinu. Zatamnjenje ispod minimuma uvijek radi jer štedi energiju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek a korlátok csak az extra fényerőt állítják le. A minimum alatti sötétítés mindig működik, mert energiát takarít meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "These limits stop extra brightness only. Dimming below the minimum always works, because it saves power."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi limiti fermano solo la luminosità extra. L’oscuramento sotto il minimo funziona sempre, perché fa risparmiare energia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "These limits stop extra brightness only. Dimming below the minimum always works, because it saves power."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "These limits stop extra brightness only. Dimming below the minimum always works, because it saves power."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "These limits stop extra brightness only. Dimming below the minimum always works, because it saves power."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse grensene stopper bare ekstra lysstyrke. Demping under minimum fungerer alltid, fordi det sparer strøm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze limieten stoppen alleen extra helderheid. Dimmen onder het minimum werkt altijd, omdat het energie bespaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ograniczenia dotyczą tylko dodatkowej jasności. Przyciemnianie poniżej minimum działa zawsze, ponieważ oszczędza energię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses limites param apenas o brilho extra. O escurecimento abaixo do mínimo sempre funciona, porque economiza energia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes limites só afetam o brilho extra. O escurecimento abaixo do mínimo funciona sempre, porque poupa energia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceste limite opresc doar luminozitatea suplimentară. Întunecarea sub minim funcționează întotdeauna, deoarece economisește energie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти ограничения касаются только дополнительной яркости. Затемнение ниже минимума работает всегда, ведь оно экономит энергию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieto obmedzenia zastavujú len extra jas. Stmavenie pod minimum funguje vždy, pretože šetrí energiu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te omejitve ustavijo le dodatno svetlost. Zatemnitev pod minimum deluje vedno, ker varčuje z energijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De här gränserna stoppar bara extra ljusstyrka. Nedtoning under minimum fungerar alltid, eftersom det sparar ström."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "These limits stop extra brightness only. Dimming below the minimum always works, because it saves power."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sınırlar yalnızca ek parlaklığı durdurur. Minimumun altına karartma güç tasarrufu sağladığı için her zaman çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці обмеження стосуються лише додаткової яскравості. Затемнення нижче мінімуму працює завжди, адже воно заощаджує енергію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "These limits stop extra brightness only. Dimming below the minimum always works, because it saves power."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "These limits stop extra brightness only. Dimming below the minimum always works, because it saves power."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "These limits stop extra brightness only. Dimming below the minimum always works, because it saves power."
          }
        }
      }
    },
