        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies in de instellingen voor ‘Focus’ wat Overbright doet in elke focus: niets wijzigen, uitschakelen of inschakelen op een niveau."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W ustawieniach „Tryb skupienia” wybierz, co Overbright ma robić w każdym trybie skupienia: nic nie zmieniać, wyłączać się lub włączać na wybranym poziomie."
          }
        },
