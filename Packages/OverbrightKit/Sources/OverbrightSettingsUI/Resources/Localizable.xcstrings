          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera virtual dan kamera iPhone dihitung sebagai “Kamera apa pun”."
          }
        },
        "it" : {
          "stringUnit" : {
