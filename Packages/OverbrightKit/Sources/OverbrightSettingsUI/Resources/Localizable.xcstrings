    "macOS seems to ignore color table changes on this Mac. Use Compatibility mode on this display?" : {
      "comment" : "Calibration: question after the screen did not get brighter",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS seems to ignore color table changes on this Mac. Use Compatibility mode on this display?"
