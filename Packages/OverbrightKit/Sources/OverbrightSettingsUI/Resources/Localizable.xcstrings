          }
        }
      }
    },
    "The two squares on the right usually merge before this point. Keep going?" : {
      "comment" : "Calibration: question when the sweep pauses",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عادةً ما يندمج المربعان على اليمين قبل هذه النقطة. هل تريد المتابعة؟"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalment, els dos quadrats de la dreta es confonen abans d’aquest punt. Vols continuar?"
