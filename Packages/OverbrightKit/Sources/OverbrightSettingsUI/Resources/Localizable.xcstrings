    "Video that keeps your Mac awake doesn’t count as no input." : {
      "comment" : "Settings ▸ Automations: footnote of the OLED idle pause",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُعد الفيديو الذي يُبقي جهاز Mac في وضع التنبيه غيابًا للإدخال."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vídeo que manté el Mac actiu no compta com a inactivitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video, které brání Macu v uspání, se za nečinnost nepovažuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video, der holder din Mac vågen, tæller ikke som inaktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos, die deinen Mac wach halten, zählen nicht als Inaktivität."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το βίντεο που κρατά το Mac σας ξύπνιο δεν θεωρείται αδράνεια."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vídeo que mantiene el Mac activo no cuenta como inactividad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videota, joka pitää Macin hereillä, ei lasketa käyttämättömyydeksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une vidéo qui garde votre Mac éveillé ne compte pas comme de l’inactivité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "וידאו שמשאיר את ה-Mac ער לא נחשב כהיעדר קלט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो वीडियो आपके Mac को जगाए रखता है, उसे निष्क्रियता नहीं माना जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video koji drži Mac budnim ne računa se kao razdoblje bez unosa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Macet ébren tartó videó nem számít tétlenségnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video yang membuat Mac Anda tetap aktif tidak dihitung sebagai tanpa input."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un video che tiene attivo il Mac non conta come inattività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macをスリープさせないビデオの再生中は、無操作とはみなされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac이 잠자기 상태가 되지 않도록 하는 비디오는 입력 없음으로 간주되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video yang memastikan Mac anda berjaga tidak dikira sebagai tiada input."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video som holder Macen våken, regnes ikke som inaktivitet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video die je Mac wakker houdt, telt niet als geen invoer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wideo, które nie pozwala Macowi przejść w stan uśpienia, nie jest traktowane jako bezczynność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeos que mantêm o Mac ativo não contam como inatividade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um vídeo que mantém o Mac ativo não conta como inatividade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un video care menține Mac‑ul activ nu este considerat inactivitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видео, которое не даёт Mac уйти в режим сна, не считается простоем."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video, ktoré bráni Macu v uspaní, sa za nečinnosť nepovažuje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video, ki Macu preprečuje preklop v mirovanje, se ne šteje za nedejavnost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video som håller din Mac vaken räknas inte som inaktivitet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิดีโอที่ทำให้ Mac ไม่เข้าสู่โหมดพักเครื่องจะไม่นับว่าไม่มีการป้อนข้อมูล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac’inizi uyanık tutan video, giriş yokluğu sayılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відео, яке не дає Mac перейти в режим сну, не вважається простоєм."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video giữ máy Mac thức không được tính là không có thao tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使Mac保持唤醒的视频不算作无输入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓你的Mac保持喚醒的影片不算作無操作。"
          }
        }
      }
    },
    "Virtual cameras and iPhone cameras count as Any camera." : {
      "comment" : "Settings ▸ Fill Light: footnote of Cameras; “Any camera” is the first choice",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحتسب الكاميرات الافتراضية وكاميرات iPhone ضمن \"أي كاميرا\"."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les càmeres virtuals i les de l’iPhone compten com a “Qualsevol càmera”."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtuální kamery a kamery iPhonu spadají pod volbu Libovolná kamera."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtuelle kameraer og iPhone-kameraer tæller som “Alle kameraer”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtuelle Kameras und iPhone-Kameras zählen als „Jede Kamera“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι εικονικές κάμερες και οι κάμερες iPhone θεωρούνται «Οποιαδήποτε κάμερα»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cámaras virtuales y las del iPhone cuentan como “Cualquier cámara”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtuaalikamerat ja iPhonen kamerat kuuluvat kohtaan ”Mikä tahansa kamera”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les caméras virtuelles et celles de l’iPhone comptent comme « N’importe quelle caméra »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
