    "Each press of Brighter or Less Bright changes the light by about a fifth (Regular) or about %@ (Fine)." : {
      "comment" : "Settings ▸ Shortcuts: footnote of Step size; the argument is a percentage such as 6%",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر كل ضغطة على \"إضاءة أعلى\" أو \"إضاءة أقل\" الضوء بنحو الخُمس (\"عادي\") أو بنحو %@ (\"دقيق\")."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pulsació de “Més brillant” o “Menys brillant” canvia la llum aproximadament una cinquena part (“Normal”) o aproximadament un %@ (“Precís”)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé stisknutí „Jasněji“ nebo „Méně jasně“ změní světlo zhruba o pětinu („Běžný“) nebo zhruba o %@ („Jemný“)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert tryk på Lysere eller Mørkere ændrer lyset med ca. en femtedel (Normal) eller ca. %@ (Lille)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Drücken von „Heller“ oder „Weniger hell“ ändert das Licht um etwa ein Fünftel („Normal“) oder um etwa %@ („Fein“)."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε πάτημα του «Φωτεινότερα» ή του «Λιγότερο φωτεινά» αλλάζει το φως κατά περίπου ένα πέμπτο («Κανονικό») ή κατά περίπου %@ («Μικρό»)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pulsación de “Más brillo” o “Menos brillo” cambia la luz en aproximadamente una quinta parte (“Normal”) o un %@ (“Fino”)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukin painallus (”Lisää kirkkautta” tai ”Vähennä kirkkautta”) muuttaa valoa noin viidenneksen (”Normaali”) tai noin %@ (”Tarkka”)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque pression sur « Plus lumineux » ou « Moins lumineux » change la lumière d’environ un cinquième (« Normal ») ou d’environ %@ (« Fin »)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל הקשה על ״בהיר יותר״ או ״פחות בהיר״ משנה את האור בכחמישית (״רגיל״) או בכ-%@ (״עדין״)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ज़्यादा ब्राइट” या “कम ब्राइट” को हर बार दबाने पर रोशनी लगभग पाँचवें हिस्से (“सामान्य”) या लगभग %@ (“बारीक”) तक बदलती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki pritisak na “Svjetlije” ili “Manje svijetlo” mijenja svjetlo za otprilike petinu (“Obično”) ili otprilike %@ (“Fino”)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Világosabb” vagy a „Kevésbé világos” minden lenyomása nagyjából egyötödével („Normál”) vagy nagyjából %@ értékkel („Finom”) változtat a fényen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap tekanan “Lebih Cerah” atau “Kurang Cerah” mengubah cahaya sekitar seperlima (Normal) atau sekitar %@ (Halus)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni pressione di “Più luminoso” o “Meno luminoso” cambia la luce di circa un quinto (“Normale”) o di circa il %@ (“Piccolo”)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“輝度を上げる”または“輝度を下げる”を1回押すごとに、光が約5分の1（通常）または約%@（微調整）変化します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘더 밝게’ 또는 ‘덜 밝게’를 한 번 누를 때마다 빛이 약 5분의 1(보통) 또는 약 %@(미세)만큼 바뀝니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap tekanan “Lebih Cerah” atau “Kurang Cerah” mengubah cahaya kira-kira satu perlima (Biasa) atau kira-kira %@ (Halus)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert trykk på «Lysere» eller «Mindre lyst» endrer lyset med omtrent en femtedel («Vanlig») eller omtrent %@ («Fin»)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke druk op ‘Helderder’ of ‘Minder helder’ verandert het licht met ongeveer een vijfde (‘Normaal’) of ongeveer %@ (‘Fijn’)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde naciśnięcie „Jaśniej” lub „Mniej jasno” zmienia światło o około jedną piątą („Zwykły”) lub o około %@ („Drobny”)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que você pressiona “Mais Brilho” ou “Menos Brilho”, a luz muda cerca de um quinto (“Normal”) ou cerca de %@ (“Pequeno”)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada vez que prime “Mais brilho” ou “Menos brilho”, a luz muda cerca de um quinto (“Normal”) ou cerca de %@ (“Fino”)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare apăsare pe „Mai luminos” sau „Mai puțin luminos” schimbă lumina cu aproximativ o cincime („Normal”) sau cu aproximativ %@ („Fin”)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое нажатие «Ярче» или «Менее ярко» меняет свет примерно на пятую часть («Обычный») или примерно на %@ («Мелкий»)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé stlačenie „Jasnejšie“ alebo „Menej jasne“ zmení svetlo približne o pätinu („Bežný“) alebo približne o %@ („Jemný“)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsak pritisk na »Svetleje« ali »Manj svetlo« spremeni svetlobo za približno petino (»Običajno«) ali za približno %@ (»Fino«)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje tryck på Ljusare eller Mörkare ändrar ljuset med ungefär en femtedel (Normal) eller ungefär %@ (Liten)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การกด “สว่างขึ้น” หรือ “สว่างน้อยลง” แต่ละครั้งจะเปลี่ยนแสงประมาณหนึ่งในห้า (“ปกติ”) หรือประมาณ %@ (“ละเอียด”)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Daha Parlak” veya “Daha Az Parlak” kestirmesine her basıldığında ışık yaklaşık beşte bir (Normal) ya da yaklaşık %@ (Hassas) değişir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожне натискання «Яскравіше» або «Менш яскраво» змінює світло приблизно на пʼяту частину («Звичайний») або приблизно на %@ («Дрібний»)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi lần nhấn “Sáng hơn” hoặc “Bớt sáng” sẽ thay đổi ánh sáng khoảng một phần năm (Thường) hoặc khoảng %@ (Nhỏ)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每按一次“提高亮度”或“降低亮度”，亮度约变化五分之一（常规）或约%@（精细）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每按一次「更亮」或「更暗」，光線約變化五分之一（一般）或約%@（精細）。"
          }
        }
      }
    },
    "Every Overbright setting returns to its default, including display calibration." : {
      "comment" : "Settings ▸ Advanced: confirmation message of Reset All",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستعود كل إعدادات Overbright إلى قيمها الافتراضية، بما في ذلك معايرة الشاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tota la configuració de l’Overbright tornarà als valors per omissió, inclòs el calibratge de les pantalles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechna nastavení aplikace Overbright se vrátí na výchozí hodnoty, včetně kalibrace monitorů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle indstillinger i Overbright nulstilles til standard, inklusive skærmkalibreringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Overbright-Einstellungen werden auf ihre Standardwerte zurückgesetzt, auch die Displaykalibrierung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι ρυθμίσεις του Overbright επανέρχονται στις προεπιλογές τους, συμπεριλαμβανομένης της βαθμονόμησης οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los ajustes de Overbright volverán a su valor predeterminado, incluida la calibración de las pantallas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki Overbrightin asetukset palautetaan oletusarvoihin, myös näyttöjen kalibrointi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les réglages d’Overbright reviennent à leur valeur par défaut, y compris le calibrage des écrans."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל ההגדרות של Overbright יחזרו לברירת המחדל, כולל כיול הצגים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright की हर सेटिंग अपने डिफ़ॉल्ट पर लौट आएगी, डिस्प्ले कैलिब्रेशन समेत।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve postavke aplikacije Overbright vraćaju se na standardne vrijednosti, uključujući kalibraciju zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Overbright minden beállítása visszaáll az alapértelmezettre, a kijelzők kalibrálásával együtt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua pengaturan Overbright kembali ke default, termasuk kalibrasi layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le impostazioni di Overbright torneranno ai valori predefiniti, inclusa la calibrazione degli schermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイのキャリブレーションを含め、Overbrightのすべての設定がデフォルトに戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이 보정을 포함하여 Overbright의 모든 설정이 기본값으로 돌아갑니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap seting Overbright kembali kepada lalai, termasuk kalibrasi paparan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle innstillinger i Overbright settes tilbake til standardverdiene, inkludert skjermkalibreringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle instellingen van Overbright worden teruggezet naar de standaardwaarde, inclusief de kalibratie van beeldschermen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie ustawienia Overbright wrócą do wartości domyślnych, łącznie z kalibracją wyświetlaczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os ajustes do Overbright voltarão ao padrão, incluindo a calibração das telas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as definições do Overbright voltam aos valores predefinidos, incluindo a calibração dos monitores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate configurările Overbright revin la valorile implicite, inclusiv calibrarea afișajelor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все настройки Overbright вернутся к значениям по умолчанию, включая калибровку дисплеев."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky nastavenia apky Overbright sa vrátia na predvolené hodnoty vrátane kalibrácie displejov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vse nastavitve aplikacije Overbright bodo ponastavljene na privzete vrednosti, vključno z umerjanjem zaslonov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla inställningar i Overbright återställs till förval, även skärmkalibreringen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตั้งค่าทั้งหมดของ Overbright จะกลับเป็นค่าเริ่มต้น รวมถึงการปรับเทียบจอภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm Overbright ayarları, ekran kalibrasyonu dahil saptanmış değerlerine döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі параметри Overbright повернуться до типових значень, включно з калібруванням дисплеїв."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi cài đặt Overbright sẽ trở về mặc định, kể cả hiệu chỉnh màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright的所有设置都将恢复为默认值，包括显示器校准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有Overbright設定（包括顯示器校正）都會還原為預設值。"
          }
        }
      }
    },
    "Every display goes back to its color profile. This also clears changes made by other color apps." : {
      "comment" : "Settings ▸ Advanced: text of the question before Reset Display Colors",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود كل شاشة إلى ملف تعريف اللون الخاص بها. ويؤدي ذلك أيضًا إلى مسح التغييرات التي أجرتها تطبيقات الألوان الأخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totes les pantalles tornen al seu perfil de color. Això també elimina els canvis fets per altres apps de color."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny monitory se vrátí ke svému barevnému profilu. Tím se zruší i změny provedené jinými aplikacemi pro barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle skærme vender tilbage til deres farveprofil. Det rydder også ændringer, som andre farveapps har lavet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Display kehrt zu seinem Farbprofil zurück. Dadurch werden auch Änderungen anderer Farb-Apps entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε οθόνη επιστρέφει στο προφίλ χρωμάτων της. Έτσι διαγράφονται επίσης οι αλλαγές που έκαναν άλλες εφαρμογές χρωμάτων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pantalla volverá a su perfil de color. Esto también borra los cambios hechos por otras apps de color."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki näytöt palaavat väriprofiiliinsa. Tämä poistaa myös muiden väriappien tekemät muutokset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque écran revient à son profil de couleur. Cela efface aussi les modifications faites par d’autres apps de couleur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל הצגים יחזרו לפרופיל הצבעים שלהם. פעולה זו גם מנקה שינויים שביצעו יישומי צבע אחרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर डिस्प्ले अपनी रंग प्रोफ़ाइल पर लौट आएगा। इससे रंग के दूसरे ऐप्स के किए बदलाव भी हट जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki se zaslon vraća na svoj profil boje. Time se brišu i promjene koje su napravile druge aplikacije za boje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden kijelző visszaáll a saját színprofiljára. Ez a más színkezelő appok által végzett módosításokat is törli."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap layar kembali ke profil warnanya. Ini juga menghapus perubahan yang dibuat oleh app warna lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni schermo tornerà al proprio profilo colore. Vengono annullate anche le modifiche fatte da altre app per i colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのディスプレイがカラープロファイルの状態に戻ります。ほかのカラー調整Appによる変更も消去されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 디스플레이가 색상 프로필로 돌아갑니다. 다른 색상 앱이 변경한 내용도 지워집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap paparan kembali kepada profil warnanya. Ini juga mengosongkan perubahan yang dibuat oleh app warna lain."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle skjermer går tilbake til fargeprofilen sin. Dette fjerner også endringer gjort av andre fargeapper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk beeldscherm gaat terug naar zijn kleurenprofiel. Hiermee worden ook wijzigingen van andere kleurenapps gewist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy wyświetlacz wróci do swojego profilu kolorów. Usunie to również zmiany wprowadzone przez inne aplikacje do kolorów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tela voltará ao seu perfil de cores. Isso também desfaz alterações feitas por outros apps de cor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os monitores voltam ao respetivo perfil de cor. Isto também elimina alterações feitas por outras aplicações de cor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare afișaj revine la profilul său de culoare. Se șterg și modificările făcute de alte aplicații pentru culori."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все дисплеи вернутся к своим цветовым профилям. Изменения, внесённые другими приложениями для настройки цвета, тоже будут сброшены."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetky displeje sa vrátia k svojmu farebnému profilu. Zrušia sa tým aj zmeny, ktoré urobili iné apky na úpravu farieb."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vsi zasloni se vrnejo na svoj barvni profil. S tem se počistijo tudi spremembe drugih aplikacij za barve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla skärmar återgår till sin färgprofil. Det rensar också ändringar som andra färgappar har gjort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จอภาพทุกจอจะกลับไปใช้โปรไฟล์สีของตัวเอง การดำเนินการนี้จะล้างการเปลี่ยนแปลงที่แอปปรับสีอื่นทำไว้ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ekran kendi renk profiline döner. Bu, diğer renk uygulamalarının yaptığı değişiklikleri de temizler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі дисплеї повернуться до своїх колірних профілів. Зміни, внесені іншими програмами для налаштування кольору, теж буде скинуто."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi màn hình sẽ trở về cấu hình màu của nó. Thao tác này cũng xóa các thay đổi do ứng dụng màu khác tạo ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有显示器都将恢复为其颜色描述文件。这也会清除其他颜色App所做的更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有顯示器都會還原為其色彩描述。這也會清除其他色彩App所做的更改。"
          }
        }
      }
    },
    "Every display will find its method again." : {
