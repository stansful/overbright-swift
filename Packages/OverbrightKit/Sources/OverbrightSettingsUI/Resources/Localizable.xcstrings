        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oba čtverce vpravo obvykle splynou už dřív. Pokračovat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De to firkanter til højre smelter som regel sammen før dette punkt. Vil du fortsætte?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die beiden rechten Quadrate verschmelzen normalerweise schon vorher. Weitermachen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δύο τετράγωνα στα δεξιά συνήθως συγχωνεύονται πριν από αυτό το σημείο. Να συνεχιστεί;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dos cuadrados de la derecha suelen fundirse antes de este punto. ¿Seguir?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
