        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembla que el macOS ignora els canvis a la taula de colors en aquest Mac. Vols fer servir el mode de compatibilitat en aquesta pantalla?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdá se, že macOS na tomto Macu ignoruje změny tabulky barev. Použít pro tento monitor režim kompatibility?"
