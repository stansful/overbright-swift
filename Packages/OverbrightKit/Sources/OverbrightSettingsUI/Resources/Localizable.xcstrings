    "Every setting in %@ returns to its default, including display calibration." : {
      "comment" : "Settings ▸ Displays: confirmation message of the pane reset; the argument is the pane name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستعود كل الإعدادات في \"%@\" إلى قيمها الافتراضية، بما في ذلك معايرة الشاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tota la configuració de “%@” tornarà als valors per omissió, inclòs el calibratge de les pantalles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechna nastavení v sekci „%@“ se vrátí na výchozí hodnoty, včetně kalibrace monitorů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle indstillinger i %@ nulstilles til standard, inklusive skærmkalibreringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Einstellungen in „%@“ werden auf ihre Standardwerte zurückgesetzt, auch die Displaykalibrierung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι ρυθμίσεις της ενότητας «%@» επανέρχονται στις προεπιλογές τους, συμπεριλαμβανομένης της βαθμονόμησης οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los ajustes de “%@” volverán a su valor predeterminado, incluida la calibración de las pantallas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki osion %@ asetukset palautetaan oletusarvoihin, myös näyttöjen kalibrointi."
