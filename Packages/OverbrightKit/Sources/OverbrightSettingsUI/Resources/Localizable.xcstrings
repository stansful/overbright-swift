    "Stops at Standard first; press again to dim below it." : {
      "comment" : "Settings ▸ Shortcuts: footnote of Less Bright",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stops at Standard first; press again to dim below it."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primer s’atura a Estàndard; torna a prémer per atenuar per sota."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív se zastaví na standardním jasu; dalším stisknutím ztmavíte pod něj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopper først ved Standard – tryk igen for at dæmpe under det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält zuerst bei Standard an; drücke erneut, um darunter abzudunkeln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σταματά πρώτα στο Τυπικό. Πατήστε ξανά για χαμήλωμα κάτω από αυτό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero se detiene en Estándar; vuelve a pulsar para atenuar por debajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pysähtyy ensin vakiotasolle; paina uudelleen, niin näyttö himmenee sen alle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’arrête d’abord au niveau Standard ; appuyez à nouveau pour assombrir en dessous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stops at Standard first; press again to dim below it."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stops at Standard first; press again to dim below it."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprije se zaustavlja na razini “Standardno”; pritisnite ponovno za zatamnjenje ispod nje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Először az alapszinten áll meg; nyomja meg újra, ha ez alá szeretné sötétíteni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stops at Standard first; press again to dim below it."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima si ferma a Standard; premi di nuovo per oscurare sotto questo livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stops at Standard first; press again to dim below it."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stops at Standard first; press again to dim below it."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stops at Standard first; press again to dim below it."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopper først på Standard; trykk igjen for å dempe under det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopt eerst bij ‘Standaard’; druk nogmaals om verder te dimmen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw zatrzymuje się na poziomie „Standard”; naciśnij ponownie, aby przyciemnić bardziej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro ele para no Padrão; pressione de novo para escurecer abaixo dele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para primeiro em “Padrão”; prima novamente para escurecer abaixo desse nível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se oprește mai întâi la Standard; apăsați din nou pentru a întuneca sub acest nivel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала останавливается на уровне «Стандарт»; нажмите ещё раз, чтобы затемнить сильнее."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprv sa zastaví na štandardnom jase; ďalším stlačením stmavíte pod neho."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprej se ustavi pri standardni svetlosti; znova pritisnite, da zatemnite pod njo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stannar först vid Standard – tryck igen för att tona ned under den nivån."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stops at Standard first; press again to dim below it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce Standart’ta durur; altına karartmak için yeniden basın."
