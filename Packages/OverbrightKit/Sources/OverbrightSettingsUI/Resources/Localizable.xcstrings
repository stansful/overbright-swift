            "value" : "Πατήστε για να καταγράψετε νέα πλήκτρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa para grabar nuevas teclas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina, niin voit tallentaa uudet näppäimet."
          }
