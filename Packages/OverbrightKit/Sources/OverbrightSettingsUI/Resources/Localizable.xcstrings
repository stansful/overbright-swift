    "Overbright can’t run next to another brightness app on the color table. Use Compatibility mode on a display to run alongside it." : {
      "comment" : "Settings ▸ Advanced: note under a running brightness app",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright can’t run next to another brightness app on the color table. Use Compatibility mode on a display to run alongside it."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Overbright no pot funcionar amb la taula de colors al costat d’una altra app de brillantor. Fes servir el mode de compatibilitat en una pantalla per funcionar al seu costat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright nemůže pracovat s tabulkou barev souběžně s jinou aplikací pro jas. Chcete‑li je používat zároveň, zapněte na monitoru režim kompatibility."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright kan ikke køre via farvetabellen sammen med en anden lysstyrkeapp. Brug kompatibilitetstilstand på en skærm for at køre side om side med den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright kann nicht gleichzeitig mit einer anderen Helligkeits-App über die Farbtabelle arbeiten. Nutze auf einem Display den Kompatibilitätsmodus, um parallel dazu zu arbeiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Overbright δεν μπορεί να λειτουργεί μέσω του πίνακα χρωμάτων παράλληλα με άλλη εφαρμογή φωτεινότητας. Χρησιμοποιήστε τη λειτουργία συμβατότητας σε μια οθόνη για να λειτουργεί μαζί της."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright no puede funcionar junto a otra app de brillo con la tabla de colores. Usa el modo de compatibilidad en una pantalla para funcionar junto a ella."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright ei voi toimia väritaulukon kautta toisen kirkkausapin rinnalla. Käytä näytöllä yhteensopivuustilaa, niin Overbright toimii sen rinnalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright ne peut pas utiliser la table des couleurs en même temps qu’une autre app de luminosité. Utilisez le mode de compatibilité sur un écran pour fonctionner à ses côtés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright can’t run next to another brightness app on the color table. Use Compatibility mode on a display to run alongside it."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright can’t run next to another brightness app on the color table. Use Compatibility mode on a display to run alongside it."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright ne može raditi preko tablice boja uz drugu aplikaciju za svjetlinu. Za rad uz nju uključite način kompatibilnosti na zaslonu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Overbright a színtáblán nem tud egy másik fényerő-szabályozó app mellett működni. Ha vele együtt szeretné használni, kapcsolja be a kijelzőn a kompatibilitási módot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright can’t run next to another brightness app on the color table. Use Compatibility mode on a display to run alongside it."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright non può funzionare con la tabella colori insieme a un’altra app per la luminosità. Usa la modalità compatibilità su uno schermo per funzionare insieme a essa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright can’t run next to another brightness app on the color table. Use Compatibility mode on a display to run alongside it."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright can’t run next to another brightness app on the color table. Use Compatibility mode on a display to run alongside it."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright can’t run next to another brightness app on the color table. Use Compatibility mode on a display to run alongside it."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright kan ikke bruke fargetabellen samtidig med en annen lysstyrkeapp. Bruk kompatibilitetsmodus på en skjerm for å kjøre side om side med den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright kan niet via de kleurentabel werken naast een andere helderheidsapp. Gebruik de compatibiliteitsmodus op een beeldscherm om ermee samen te werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright nie może działać przez tabelę kolorów równocześnie z inną aplikacją do jasności. Aby działać razem z nią, użyj na wyświetlaczu trybu zgodności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Overbright não pode funcionar pela tabela de cores junto com outro app de brilho. Use o Modo de Compatibilidade em uma tela para funcionar junto com ele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Overbright não pode funcionar com a tabela de cores ao mesmo tempo que outra aplicação de brilho. Use o modo de compatibilidade num monitor para funcionar em conjunto com ela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright nu poate funcționa prin tabelul de culori alături de o altă aplicație pentru luminozitate. Pentru a funcționa împreună cu aceasta, folosiți modul de compatibilitate pe afișaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright не может работать через цветовую таблицу одновременно с другим приложением для настройки яркости. Чтобы работать вместе с ним, включите на дисплее режим совместимости."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright nemôže pracovať s tabuľkou farieb súčasne s inou apkou na úpravu jasu. Ak ich chcete používať zároveň, zapnite na displeji režim kompatibility."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright ne more delovati prek barvne tabele hkrati z drugo aplikacijo za svetlost. Če želite, da delujeta skupaj, na zaslonu uporabite način združljivosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright kan inte köras via färgtabellen samtidigt med en annan ljusstyrkeapp. Använd kompatibilitetsläge på en skärm för att köra tillsammans med den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright can’t run next to another brightness app on the color table. Use Compatibility mode on a display to run alongside it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright, renk tablosu üzerinden başka bir parlaklık uygulamasıyla birlikte çalışamaz. Onunla birlikte çalışmak için bir ekranda uyumluluk modunu kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright не може працювати через колірну таблицю одночасно з іншою програмою для налаштування яскравості. Щоб працювати разом із нею, увімкніть на дисплеї режим сумісності."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright can’t run next to another brightness app on the color table. Use Compatibility mode on a display to run alongside it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright can’t run next to another brightness app on the color table. Use Compatibility mode on a display to run alongside it."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright can’t run next to another brightness app on the color table. Use Compatibility mode on a display to run alongside it."
          }
        }
      }
    },
    "Overbright collects nothing and needs no permissions. It connects to the internet only to check GitHub for updates, and only if you turn that on." : {
      "comment" : "Settings ▸ About: the privacy statement",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright collects nothing and needs no permissions. It connects to the internet only to check GitHub for updates, and only if you turn that on."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Overbright no recopila res i no necessita cap permís. Només es connecta a internet per cercar actualitzacions al GitHub, i només si ho actives."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright nic neshromažďuje a nepotřebuje žádná oprávnění. K internetu se připojuje jen kvůli kontrole aktualizací na GitHubu, a to jen tehdy, když ji zapnete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright indsamler intet og kræver ingen tilladelser. Den opretter kun forbindelse til internettet for at søge efter opdateringer på GitHub, og kun hvis du slår det til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright sammelt keine Daten und benötigt keine Berechtigungen. Es verbindet sich nur mit dem Internet, um auf GitHub nach Updates zu suchen, und nur, wenn du das aktivierst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Overbright δεν συλλέγει τίποτα και δεν χρειάζεται άδειες. Συνδέεται στο Διαδίκτυο μόνο για να ελέγξει για ενημερώσεις στο GitHub, και μόνο αν το ενεργοποιήσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright no recopila nada y no necesita permisos. Solo se conecta a internet para buscar actualizaciones en GitHub, y solo si lo activas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright ei kerää mitään eikä tarvitse lupia. Se muodostaa internetyhteyden vain tarkistaakseen päivitykset GitHubista, ja vain jos olet laittanut tämän päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright ne collecte rien et ne demande aucune autorisation. Il ne se connecte à Internet que pour rechercher des mises à jour sur GitHub, et seulement si vous l’activez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright collects nothing and needs no permissions. It connects to the internet only to check GitHub for updates, and only if you turn that on."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright collects nothing and needs no permissions. It connects to the internet only to check GitHub for updates, and only if you turn that on."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright ništa ne prikuplja i ne treba nikakve dozvole. Na internet se spaja samo radi provjere ažuriranja na GitHubu, i to samo ako to uključite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Overbright semmilyen adatot nem gyűjt, és nincs szüksége engedélyekre. Csak a GitHubon elérhető frissítések kereséséhez csatlakozik az internethez, és csak akkor, ha ezt bekapcsolja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright collects nothing and needs no permissions. It connects to the internet only to check GitHub for updates, and only if you turn that on."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright non raccoglie nulla e non richiede autorizzazioni. Si connette a internet solo per verificare gli aggiornamenti su GitHub, e solo se lo attivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright collects nothing and needs no permissions. It connects to the internet only to check GitHub for updates, and only if you turn that on."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright collects nothing and needs no permissions. It connects to the internet only to check GitHub for updates, and only if you turn that on."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright collects nothing and needs no permissions. It connects to the internet only to check GitHub for updates, and only if you turn that on."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright samler ikke inn noe og trenger ingen tillatelser. Den kobler seg til internett bare for å se etter oppdateringer på GitHub, og bare hvis du slår det på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright verzamelt niets en heeft geen toestemmingen nodig. Het maakt alleen verbinding met internet om op GitHub naar updates te zoeken, en alleen als je dat inschakelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright niczego nie zbiera i nie potrzebuje żadnych uprawnień. Łączy się z Internetem tylko po to, aby sprawdzić uaktualnienia w serwisie GitHub, i tylko jeśli to włączysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Overbright não coleta nada e não precisa de permissões. Ele só se conecta à internet para buscar atualizações no GitHub, e só se você ativar essa opção."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Overbright não recolhe nada e não precisa de permissões. Só se liga à internet para procurar atualizações no GitHub, e apenas se ativar essa opção."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright nu colectează nimic și nu are nevoie de permisiuni. Se conectează la internet doar pentru a căuta actualizări pe GitHub și doar dacă activați această opțiune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright ничего не собирает и не требует разрешений. Он подключается к интернету только для проверки обновлений на GitHub и только если вы это включили."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright nič nezhromažďuje a nepotrebuje žiadne povolenia. K internetu sa pripája len kvôli kontrole aktualizácií na GitHube, a to len vtedy, ak ju zapnete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright ne zbira ničesar in ne potrebuje nobenih dovoljenj. Z internetom se poveže le zato, da na GitHubu preveri posodobitve, in še to samo, če to možnost vklopite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright samlar inte in något och behöver inga behörigheter. Den ansluter bara till internet för att leta efter uppdateringar på GitHub, och bara om du slår på det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright collects nothing and needs no permissions. It connects to the internet only to check GitHub for updates, and only if you turn that on."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright hiçbir şey toplamaz ve hiçbir izin gerektirmez. İnternete yalnızca GitHub’da güncellemeleri denetlemek için ve yalnızca siz bunu açarsanız bağlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright нічого не збирає й не потребує дозволів. Він підключається до інтернету лише для перевірки оновлень на GitHub і лише якщо ви це ввімкнули."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright collects nothing and needs no permissions. It connects to the internet only to check GitHub for updates, and only if you turn that on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright collects nothing and needs no permissions. It connects to the internet only to check GitHub for updates, and only if you turn that on."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright collects nothing and needs no permissions. It connects to the internet only to check GitHub for updates, and only if you turn that on."
          }
        }
