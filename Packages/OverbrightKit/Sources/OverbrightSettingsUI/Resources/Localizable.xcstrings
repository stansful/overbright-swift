    "All settings were reset. Undo is available until you close Settings." : {
      "comment" : "VoiceOver: announcement after Reset All Settings",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت إعادة تعيين كل الإعدادات. يمكنك التراجع إلى أن تغلق الإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ha restablert tota la configuració. Pots desfer‑ho fins que tanquis la configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechna nastavení byla resetována. Akci můžete odvolat, dokud nezavřete Nastavení."
