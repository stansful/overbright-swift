          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporabite, če so barve po zaprtju druge aplikacije videti napačne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd det här om färgerna ser fel ut efter att en annan app har avslutats."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ตัวเลือกนี้หากสีดูผิดปกติหลังจากแอปอื่นปิดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir uygulama kapandıktan sonra renkler yanlış görünüyorsa bunu kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте, якщо після завершення іншої програми кольори виглядають неправильно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng tùy chọn này nếu màu trông không đúng sau khi một ứng dụng khác thoát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果在其他App退出后颜色显示异常，请使用此功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果其他App結束後顏色看起來不正確，請使用此功能。"
          }
        }
      }
    },
    "Uses the display’s extra range when it has one, so the light can be brighter than white." : {
      "comment" : "Settings ▸ Fill Light: footnote of Brightness",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم هامش إضاءة الشاشة إن وُجد، لذا يمكن أن يكون الضوء أكثر إشراقًا من الأبيض."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa servir el marge extra de la pantalla quan en té, perquè la llum pugui ser més brillant que el blanc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Využívá rezervu jasu monitoru, pokud ji má, takže světlo může být jasnější než bílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger skærmens lysreserve, når den har en, så lyset kan blive lysere end hvid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzt die Helligkeitsreserve des Displays, falls vorhanden, sodass das Licht heller als Weiß sein kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιεί το περιθώριο φωτεινότητας της οθόνης, αν υπάρχει, ώστε το φως να είναι φωτεινότερο από το λευκό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el margen de brillo de la pantalla cuando lo tiene, así que la luz puede ser más brillante que el blanco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttää näytön kirkkausvaraa, jos sellainen on, joten valo voi olla valkoista kirkkaampaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise la marge de luminosité de l’écran lorsqu’il en a une, pour que la lumière puisse être plus vive que le blanc."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משתמש בטווח הנוסף של הצג, אם יש לו, כך שהאור יכול להיות בהיר יותר מלבן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्प्ले में अतिरिक्त रेंज हो, तो उसका इस्तेमाल करता है, ताकि रोशनी सफ़ेद से भी ज़्यादा ब्राइट हो सके।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi rezervu svjetline zaslona kad postoji, pa svjetlo može biti jače od bijele."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha van, a kijelző fényerőtartalékát használja, így a fény a fehérnél is világosabb lehet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan rentang ekstra layar jika ada, sehingga cahaya bisa lebih terang dari putih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il margine di luminosità dello schermo quando c’è, così la luce può essere più intensa del bianco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイに輝度の余力がある場合はそれを使用するため、白よりも明るい光にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이에 여유 밝기가 있으면 이를 사용하므로 흰색보다 밝은 빛을 낼 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan julat tambahan paparan jika ada, supaya cahaya boleh lebih cerah daripada putih."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruker skjermens lysreserve når den har en, så lyset kan bli lysere enn hvitt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt het extra bereik van het beeldscherm als dat er is, zodat het licht feller kan zijn dan wit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykorzystuje zapas jasności wyświetlacza, jeśli jest dostępny, więc światło może być jaśniejsze niż biel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa a margem de brilho da tela quando ela existe, então a luz pode ser mais clara que o branco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa a margem extra do monitor, se existir, para que a luz possa ser mais brilhante do que o branco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește rezerva de luminozitate a afișajului, dacă există, astfel încât lumina poate fi mai puternică decât albul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует запас яркости дисплея, если он есть, поэтому свет может быть ярче белого."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Využíva rezervu jasu displeja, ak ju má, takže svetlo môže byť jasnejšie než biela."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uporablja rezervo svetlosti zaslona, če jo ima, zato je lahko svetloba svetlejša od bele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använder skärmens ljusreserv när den finns, så att ljuset kan bli ljusare än vitt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ช่วงเพิ่มเติมของจอภาพหากมี แสงจึงสว่างกว่าสีขาวได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranın parlaklık payı varsa onu kullanır; böylece ışık beyazdan daha parlak olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовує запас яскравості дисплея, якщо він є, тож світло може бути яскравішим за білий."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng dải sáng bổ sung của màn hình khi có, nên ánh sáng có thể sáng hơn màu trắng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果显示器有亮度余量，就会加以利用，使光线比白色更亮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示器有亮度餘裕時會加以使用，讓光線可以比白色更亮。"
          }
        }
      }
    },
