    "Overbright limits extra brightness when your Mac gets warm and turns it off when it gets hot. This can’t be turned off." : {
      "comment" : "Settings ▸ Automations: the heat note",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright limits extra brightness when your Mac gets warm and turns it off when it gets hot. This can’t be turned off."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Overbright limita la brillantor extra quan el Mac s’escalfa i la desactiva quan s’escalfa massa. Això no es pot desactivar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright omezí extra jas, když se Mac zahřeje, a vypne ho, když je přehřátý. Tuto ochranu nelze vypnout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright begrænser ekstra lysstyrke, når din Mac bliver varm, og slår den fra, når Mac’en bliver for varm. Det kan ikke slås fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright begrenzt die Zusatzhelligkeit, wenn dein Mac warm wird, und schaltet sie aus, wenn er heiß wird. Das lässt sich nicht deaktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Overbright περιορίζει την επιπλέον φωτεινότητα όταν το Mac σας ζεσταίνεται και την απενεργοποιεί όταν υπερθερμαίνεται. Αυτό δεν μπορεί να απενεργοποιηθεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright limita el brillo extra cuando el Mac se calienta y lo desactiva cuando está muy caliente. Esta protección no se puede desactivar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright rajoittaa lisäkirkkautta, kun Mac lämpenee, ja laittaa sen pois päältä, kun Mac kuumenee. Tätä ei voi laittaa pois päältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright limite la luminosité supplémentaire quand votre Mac chauffe et la désactive quand il devient trop chaud. Ce comportement ne peut pas être désactivé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright limits extra brightness when your Mac gets warm and turns it off when it gets hot. This can’t be turned off."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright limits extra brightness when your Mac gets warm and turns it off when it gets hot. This can’t be turned off."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright ograničava dodatnu svjetlinu kad se Mac zagrije i isključuje je kad se pregrije. To se ne može isključiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Overbright korlátozza az extra fényerőt, ha a Mac felmelegszik, és kikapcsolja, ha túlmelegszik. Ez nem kapcsolható ki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright limits extra brightness when your Mac gets warm and turns it off when it gets hot. This can’t be turned off."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright limita la luminosità extra quando il Mac si scalda e la disattiva quando diventa troppo caldo. Questa protezione non può essere disattivata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright limits extra brightness when your Mac gets warm and turns it off when it gets hot. This can’t be turned off."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright limits extra brightness when your Mac gets warm and turns it off when it gets hot. This can’t be turned off."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright limits extra brightness when your Mac gets warm and turns it off when it gets hot. This can’t be turned off."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright begrenser ekstra lysstyrke når Macen blir varm, og slår den av når Macen blir for varm. Dette kan ikke slås av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright beperkt extra helderheid als je Mac warm wordt en schakelt die uit als hij heet wordt. Dit kan niet worden uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright ogranicza dodatkową jasność, gdy Mac się nagrzewa, i wyłącza ją, gdy Mac staje się gorący. Tego nie można wyłączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Overbright limita o brilho extra quando o Mac esquenta e o desativa quando fica muito quente. Essa proteção não pode ser desativada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Overbright limita o brilho extra quando o Mac aquece e desativa‑o quando fica quente. Não é possível desativar este comportamento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright limitează luminozitatea suplimentară când Mac‑ul se încălzește și o dezactivează când devine fierbinte. Acest lucru nu poate fi dezactivat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright ограничивает дополнительную яркость, когда Mac нагревается, и выключает её, когда он перегревается. Это нельзя отключить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright obmedzí extra jas, keď sa Mac zahreje, a vypne ho, keď je prehriaty. Túto ochranu nie je možné vypnúť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright omeji dodatno svetlost, ko se Mac segreje, in jo izklopi, ko se pregreje. Tega ni mogoče izklopiti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright begränsar extra ljusstyrka när din Mac blir varm och stänger av den när datorn blir för varm. Det här går inte att stänga av."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright limits extra brightness when your Mac gets warm and turns it off when it gets hot. This can’t be turned off."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright, Mac’iniz ısındığında ek parlaklığı sınırlar, çok ısındığında kapatır. Bu kapatılamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright обмежує додаткову яскравість, коли Mac нагрівається, і вимикає її, коли він перегрівається. Це не можна вимкнути."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright limits extra brightness when your Mac gets warm and turns it off when it gets hot. This can’t be turned off."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright limits extra brightness when your Mac gets warm and turns it off when it gets hot. This can’t be turned off."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Overbright limits extra brightness when your Mac gets warm and turns it off when it gets hot. This can’t be turned off."
          }
        }
