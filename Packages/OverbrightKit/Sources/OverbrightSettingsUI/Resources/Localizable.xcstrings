    "Outside these hours Overbright stays at Standard. Dimming still works." : {
      "comment" : "Settings ▸ Automations: footnote of the schedule switch",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خارج هذه الساعات، يبقى Overbright عند المستوى القياسي. ولا يزال التعتيم يعمل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fora d’aquestes hores, l’Overbright es manté a Estàndard. L’atenuació continua funcionant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mimo tuto dobu zůstává Overbright na standardním jasu. Ztmavení dál funguje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden for dette tidsrum forbliver Overbright på Standard. Dæmpning virker stadig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außerhalb dieser Zeiten bleibt Overbright bei Standard. Abdunkeln funktioniert weiterhin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτός αυτών των ωρών, το Overbright μένει στο Τυπικό. Το χαμήλωμα εξακολουθεί να λειτουργεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuera de este horario, Overbright se queda en Estándar. La atenuación sigue funcionando."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näiden aikojen ulkopuolella Overbright pysyy vakiotasolla. Himmennys toimii edelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En dehors de ces horaires, Overbright reste au niveau Standard. L’assombrissement fonctionne toujours."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחוץ לשעות האלה Overbright נשאר ב״סטנדרט״. העמעום עדיין פועל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन घंटों के बाहर Overbright मानक पर रहता है। डिम करना अब भी काम करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvan tog vremena Overbright ostaje na razini “Standardno”. Zatamnjenje i dalje radi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen időszakon kívül az Overbright alapszinten marad. A sötétítés továbbra is működik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di luar jam ini, Overbright tetap di Standar. Peredupan tetap berfungsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al di fuori di questi orari Overbright resta a Standard. L’oscuramento funziona comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この時間帯以外は、Overbrightは標準のままです。減光は引き続き機能します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 시간 외에는 Overbright가 표준으로 유지됩니다. 어둡게 하기는 계속 작동합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di luar waktu ini, Overbright kekal pada Standard. Pemalapan masih berfungsi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utenfor disse tidene holder Overbright seg på Standard. Demping fungerer fortsatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buiten deze tijden blijft Overbright op ‘Standaard’. Dimmen werkt nog steeds."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poza tymi godzinami Overbright pozostaje na poziomie „Standard”. Przyciemnianie nadal działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fora desses horários, o Overbright fica no Padrão. O escurecimento continua funcionando."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fora deste horário, o Overbright fica em “Padrão”. O escurecimento continua a funcionar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În afara acestor ore, Overbright rămâne la Standard. Întunecarea funcționează în continuare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В остальное время Overbright остаётся на уровне «Стандарт». Затемнение по-прежнему работает."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mimo tohto času zostáva Overbright na štandardnom jase. Stmavenie naďalej funguje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zunaj teh ur Overbright ostane pri standardni svetlosti. Zatemnitev še vedno deluje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utanför dessa tider stannar Overbright på Standard. Nedtoning fungerar ändå."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นอกช่วงเวลานี้ Overbright จะอยู่ที่มาตรฐาน การหรี่แสงยังใช้งานได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu saatlerin dışında Overbright Standart’ta kalır. Karartma yine de çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поза цими годинами Overbright залишається на рівні «Стандарт». Затемнення працює й надалі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngoài khung giờ này, Overbright giữ ở mức Tiêu chuẩn. Làm tối vẫn hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这些时段以外，Overbright保持标准。调暗功能仍可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這些時段以外，Overbright會維持在「標準」。調暗功能仍可使用。"
          }
        }
      }
    },
