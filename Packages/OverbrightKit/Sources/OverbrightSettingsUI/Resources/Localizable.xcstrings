        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit „Szczyt” sięga tego, na co pozwala macOS; zużywa więcej energii, a macOS może go obniżyć, gdy wyświetlacz się nagrzeje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Peak goes up to what macOS allows; it uses more power, and macOS may lower it when the display gets warm."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Peak goes up to what macOS allows; it uses more power, and macOS may lower it when the display gets warm."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Peak goes up to what macOS allows; it uses more power, and macOS may lower it when the display gets warm."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предел «Пик» доходит до уровня, который разрешает macOS: расход энергии выше, и macOS может снизить его, когда дисплей нагревается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit „Špičkový“ ide až na úroveň, ktorú macOS dovolí; spotrebuje viac energie a macOS ho môže znížiť, keď sa displej zahreje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omejitev »Vrh« gre do ravni, ki jo dovoli macOS; porabi več energije, macOS pa jo lahko zniža, ko se zaslon segreje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topp går upp till vad macOS tillåter – den drar mer ström och macOS kan sänka den när skärmen blir varm."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
