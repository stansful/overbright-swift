    "This display can’t be calibrated right now. Check its verdict in Settings ▸ Displays." : {
      "comment" : "Calibration: shown when no calibration could start",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن معايرة هذه الشاشة الآن. تحقق من تقييمها في الإعدادات ◂ شاشات العرض."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ara no es pot calibrar aquesta pantalla. Consulta’n la valoració a Configuració ▸ Pantalles."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento monitor teď nelze kalibrovat. Zkontrolujte jeho stav v Nastavení ▸ Monitory."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne skærm kan ikke kalibreres lige nu. Tjek dens status under Indstillinger ▸ Skærme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Display kann gerade nicht kalibriert werden. Prüfe seine Bewertung unter Einstellungen ▸ Displays."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η οθόνη δεν μπορεί να βαθμονομηθεί αυτήν τη στιγμή. Ελέγξτε την αξιολόγησή της στις Ρυθμίσεις ▸ Οθόνες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora mismo no se puede calibrar esta pantalla. Consulta su estado en Ajustes ▸ Pantallas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä näyttöä ei voi kalibroida juuri nyt. Tarkista sen arvio kohdassa Asetukset ▸ Näytöt."
