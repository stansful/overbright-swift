    "%@: %@ works. It will be used from now on." : {
      "comment" : "Self-test: summary of a display after a clean pass; the arguments are the display’s name and the method’s name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: الطريقة \"%2$@\" تعمل. وستُستخدم من الآن فصاعدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: el mètode “%2$@” funciona i a partir d’ara es farà servir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: metoda „%2$@“ funguje. Od teď se bude používat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@ virker. Den bruges fra nu af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: „%2$@“ funktioniert und wird ab jetzt verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: η μέθοδος «%2$@» λειτουργεί. Θα χρησιμοποιείται από τώρα και στο εξής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ works. It will be used from now on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: el método “%2$@” funciona. Se usará a partir de ahora."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: menetelmä ”%2$@” toimii, ja sitä käytetään tästä lähtien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : « %2$@ » fonctionne. Cette méthode sera désormais utilisée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בצג %1$@: השיטה ״%2$@״ עובדת. מעכשיו ייעשה בה שימוש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: “%2$@” काम करता है। अब से इसी का इस्तेमाल होगा।"
