    "This display responds in linear light. Overbright can now use more of its range." : {
      "comment" : "Calibration: result, the display works in linear light",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This display responds in linear light. Overbright can now use more of its range."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta pantalla respon en llum lineal. Ara l’Overbright pot aprofitar més el seu marge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento monitor má lineární odezvu. Overbright teď může využít větší část jeho rozsahu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne skærm reagerer lineært på lys. Overbright kan nu bruge mere af lysreserven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Display reagiert linear. Overbright kann jetzt mehr von seiner Reserve nutzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η οθόνη αποκρίνεται σε γραμμικό φως. Το Overbright μπορεί τώρα να χρησιμοποιεί μεγαλύτερο μέρος του εύρους της."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pantalla responde en luz lineal. Ahora Overbright puede aprovechar más su margen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä näyttö reagoi lineaarisessa valossa. Overbright voi nyt käyttää enemmän sen kirkkausvarasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet écran répond en lumière linéaire. Overbright peut maintenant utiliser une plus grande part de sa marge."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
