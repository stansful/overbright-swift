          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten wyświetlacz reaguje liniowo. Overbright może teraz wykorzystać większą część jego zapasu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta tela responde em luz linear. Agora o Overbright pode usar mais da margem dela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este monitor responde em luz linear. O Overbright pode agora usar mais da sua margem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest afișaj răspunde liniar. Overbright poate folosi acum o parte mai mare din rezerva sa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этого дисплея линейный отклик. Теперь Overbright может использовать больший запас яркости."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento displej má lineárnu odozvu. Overbright teraz môže využiť väčšiu časť jeho rozsahu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta zaslon ima linearen odziv. Overbright lahko zdaj uporabi večji del njegovega razpona."
          }
        },
        "sv" : {
