    "Fill Light is left out of screenshots where macOS allows. Some screen-sharing apps may still show it." : {
      "comment" : "Settings ▸ Fill Light: note at the end of the pane",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fill Light is left out of screenshots where macOS allows. Some screen-sharing apps may still show it."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fill Light is left out of screenshots where macOS allows. Some screen-sharing apps may still show it."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osvětlení obličeje se nezobrazuje na snímcích obrazovky, pokud to macOS umožňuje. Některé aplikace pro sdílení obrazovky ho přesto mohou zobrazit."
