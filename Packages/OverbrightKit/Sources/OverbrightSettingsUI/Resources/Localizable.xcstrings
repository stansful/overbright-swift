    "A one-minute check that makes the numbers exact and lets Overbright use the right amount of range on this display." : {
      "comment" : "Settings ▸ Displays: footnote of Calibration",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فحص مدته دقيقة واحدة يجعل الأرقام دقيقة ويتيح لـ Overbright استخدام القدر المناسب من الهامش على هذه الشاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una comprovació d’un minut que fa que els valors siguin exactes i permet que l’Overbright faci servir el marge adequat en aquesta pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minutová kontrola, která zpřesní hodnoty a díky které Overbright využije na tomto monitoru správnou rezervu jasu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et tjek på et minut, der gør tallene præcise og lader Overbright bruge den rigtige del af lysreserven på denne skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine einminütige Prüfung, die die Werte genau macht und Overbright auf diesem Display die passende Reserve nutzen lässt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας έλεγχος ενός λεπτού που κάνει τις τιμές ακριβείς και επιτρέπει στο Overbright να χρησιμοποιεί το σωστό περιθώριο σε αυτήν την οθόνη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una comprobación de un minuto que hace exactos los valores y permite a Overbright usar el margen adecuado en esta pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minuutin tarkistus, joka tekee luvuista tarkkoja ja antaa Overbrightin käyttää oikean määrän tämän näytön kirkkausvarasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une vérification d’une minute qui rend les valeurs exactes et permet à Overbright d’utiliser la bonne marge sur cet écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בדיקה של דקה אחת שהופכת את הערכים למדויקים ומאפשרת ל-Overbright להשתמש בכמות הנכונה של טווח בצג הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक मिनट की जाँच, जिससे संख्याएँ सटीक हो जाती हैं और Overbright इस डिस्प्ले पर सही मात्रा में रेंज इस्तेमाल कर पाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednominutna provjera koja čini brojke točnima i omogućuje aplikaciji Overbright da na ovom zaslonu koristi pravu količinu rezerve."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyperces ellenőrzés, amely pontossá teszi a számokat, és lehetővé teszi, hogy az Overbright a megfelelő tartalékot használja ezen a kijelzőn."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemeriksaan satu menit yang membuat angka menjadi akurat dan memungkinkan Overbright menggunakan jumlah rentang yang tepat di layar ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un controllo di un minuto che rende esatti i valori e permette a Overbright di usare il margine giusto su questo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1分間の確認で数値が正確になり、Overbrightがこのディスプレイの余力を適切に使えるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1분간 확인하면 수치가 정확해지고 Overbright가 이 디스플레이에서 적절한 범위를 사용할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semakan seminit yang menjadikan nombor tepat dan membolehkan Overbright menggunakan jumlah julat yang betul pada paparan ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kontroll på ett minutt som gjør tallene nøyaktige og lar Overbright bruke riktig mengde lysreserve på denne skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een controle van een minuut die de waarden exact maakt en Overbright de juiste hoeveelheid bereik op dit beeldscherm laat gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minutowa kontrola, dzięki której wartości są dokładne, a Overbright używa odpowiedniego zapasu jasności tego wyświetlacza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma verificação de um minuto que deixa os valores exatos e permite que o Overbright use a margem certa nesta tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma verificação de um minuto que torna os valores exatos e permite ao Overbright usar a margem certa neste monitor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O verificare de un minut care face valorile exacte și permite aplicației Overbright să folosească rezerva potrivită pe acest afișaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Минутная проверка: значения станут точными, а Overbright будет использовать подходящий запас яркости этого дисплея."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minútová kontrola, ktorá spresní hodnoty a vďaka ktorej Overbright využije na tomto displeji správnu rezervu jasu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enominutno preverjanje, ki natančno določi vrednosti in omogoči, da Overbright na tem zaslonu uporabi pravo rezervo svetlosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kontroll på en minut som gör siffrorna exakta och låter Overbright använda rätt del av ljusreserven på den här skärmen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตรวจสอบหนึ่งนาทีที่ทำให้ตัวเลขแม่นยำ และช่วยให้ Overbright ใช้ช่วงได้อย่างเหมาะสมบนจอภาพนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayıları kesinleştiren ve Overbright’ın bu ekranda doğru miktarda pay kullanmasını sağlayan bir dakikalık bir denetim."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хвилинна перевірка: значення стануть точними, а Overbright використовуватиме відповідний запас яскравості цього дисплея."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một lần kiểm tra dài một phút giúp các con số chính xác và cho phép Overbright dùng đúng lượng dải sáng trên màn hình này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需一分钟的检查，即可使数值更准确，并让Overbright在此显示器上使用合适的余量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一分鐘的檢查，可讓數值更精確，並讓Overbright在此顯示器上使用適當的亮度餘裕。"
          }
        }
      }
    },
