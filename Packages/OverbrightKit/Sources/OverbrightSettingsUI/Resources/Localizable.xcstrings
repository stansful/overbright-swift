        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les réglages de « %@ » reviennent à leur valeur par défaut, y compris le calibrage des écrans."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל ההגדרות ב״%@״ יחזרו לברירת המחדל, כולל כיול הצגים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” की हर सेटिंग अपने डिफ़ॉल्ट पर लौट आएगी, डिस्प्ले कैलिब्रेशन समेत।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sve postavke odjeljka “%@” vraćaju se na standardne vrijednosti, uključujući kalibraciju zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ panel minden beállítása visszaáll az alapértelmezettre, a kijelzők kalibrálásával együtt."
