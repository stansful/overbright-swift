          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Межа «Пік» сягає рівня, який дозволяє macOS: витрата енергії вища, і macOS може знизити її, коли дисплей нагрівається."
          }
        },
        "vi" : {
          "stringUnit" : {
