    "Right-click or Control-click the icon for the menu." : {
      "comment" : "Settings ▸ General: footnote of Clicking the icon",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على الأيقونة بزر الماوس الأيمن أو مع الضغط على مفتاح Control لفتح القائمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per obrir el menú, fes clic amb el botó dret a la icona o fes‑hi clic mentre mantens premuda la tecla de control."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabídku otevřete kliknutím na ikonu pravým tlačítkem nebo se stisknutou klávesou Control."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højreklik eller ctrl-klik på symbolet for at åbne menuen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke mit der rechten Maustaste oder bei gedrückter Control-Taste auf das Symbol, um das Menü zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάντε δεξί κλικ ή Control-κλικ στο εικονίδιο για το μενού."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic con el botón derecho o Control + clic en el icono para ver el menú."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa valikko klikkaamalla kuvaketta oikealla painikkeella tai control-klikkaamalla sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur l’icône avec le bouton droit ou en maintenant la touche Contrôle enfoncée pour afficher le menu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לפתיחת התפריט, יש ללחוץ לחיצה ימנית על הצלמית, או ללחוץ עליה תוך החזקת Control."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेन्यू के लिए आइकन पर राइट-क्लिक या कंट्रोल-क्लिक करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za izbornik kliknite ikonu desnom tipkom ili uz pritisnutu tipku Control."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A menü megjelenítéséhez kattintson az ikonra a jobb gombbal vagy a Control billentyűt lenyomva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik kanan atau Control-klik ikon untuk membuka menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic con il tasto destro o Control-clic sull’icona per il menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューを表示するには、アイコンを右クリックするか、Controlキーを押しながらクリックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴를 보려면 아이콘을 오른쪽 클릭하거나 Control-클릭하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik kanan atau Control-klik ikon untuk menu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyreklikk eller Kontroll-klikk på symbolet for å åpne menyen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik met de rechtermuisknop of Control-klik op het symbool voor het menu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij ikonę prawym przyciskiem lub z klawiszem Control, aby otworzyć menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito ou com a tecla Control pressionada no ícone para ver o menu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
