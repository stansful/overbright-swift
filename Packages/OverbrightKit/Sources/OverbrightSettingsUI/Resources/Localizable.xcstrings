        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕没有变亮，因此Overbright将保留安全的默认值。“设置”▸“高级”中的“运行自检…”会显示macOS报告的内容。"
          }
