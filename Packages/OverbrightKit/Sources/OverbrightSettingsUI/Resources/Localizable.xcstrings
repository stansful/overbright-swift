    "Every display goes back to its color profile. This also clears changes made by other color apps." : {
      "comment" : "Settings ▸ Advanced: text of the question before Reset Display Colors",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Every display goes back to its color profile. This also clears changes made by other color apps."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totes les pantalles tornen al seu perfil de color. Això també elimina els canvis fets per altres apps de color."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny monitory se vrátí ke svému barevnému profilu. Tím se zruší i změny provedené jinými aplikacemi pro barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle skærme vender tilbage til deres farveprofil. Det rydder også ændringer, som andre farveapps har lavet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Display kehrt zu seinem Farbprofil zurück. Dadurch werden auch Änderungen anderer Farb-Apps entfernt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε οθόνη επιστρέφει στο προφίλ χρωμάτων της. Έτσι διαγράφονται επίσης οι αλλαγές που έκαναν άλλες εφαρμογές χρωμάτων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pantalla volverá a su perfil de color. Esto también borra los cambios hechos por otras apps de color."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki näytöt palaavat väriprofiiliinsa. Tämä poistaa myös muiden väriappien tekemät muutokset."
