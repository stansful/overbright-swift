          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "במשטח מגע Force Touch: ב״סטנדרט״ ובכל אחת מהרמות המוגדרות מראש."
          }
        },
        "hi" : {
          "stringUnit" : {
