        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มความสว่างเพิ่มเติมเฉพาะเมื่อใกล้ความสว่างเต็มที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
