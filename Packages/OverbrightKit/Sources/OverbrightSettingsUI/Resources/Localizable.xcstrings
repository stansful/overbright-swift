    "This display responds in linear light. Overbright can now use more of its range." : {
      "comment" : "Calibration: result, the display works in linear light",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستجيب هذه الشاشة بضوء خطي. يمكن لـ Overbright الآن استخدام جزء أكبر من نطاقها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta pantalla respon en llum lineal. Ara l’Overbright pot aprofitar més el seu marge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento monitor má lineární odezvu. Overbright teď může využít větší část jeho rozsahu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne skærm reagerer lineært på lys. Overbright kan nu bruge mere af lysreserven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Display reagiert linear. Overbright kann jetzt mehr von seiner Reserve nutzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η οθόνη αποκρίνεται σε γραμμικό φως. Το Overbright μπορεί τώρα να χρησιμοποιεί μεγαλύτερο μέρος του εύρους της."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pantalla responde en luz lineal. Ahora Overbright puede aprovechar más su margen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä näyttö reagoi lineaarisessa valossa. Overbright voi nyt käyttää enemmän sen kirkkausvarasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet écran répond en lumière linéaire. Overbright peut maintenant utiliser une plus grande part de sa marge."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצג הזה מגיב באור ליניארי. מעכשיו Overbright יכול להשתמש ביותר מהטווח שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह डिस्प्ले लीनियर रोशनी में प्रतिक्रिया देता है। अब Overbright इसकी ज़्यादा रेंज इस्तेमाल कर सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj zaslon reagira linearno. Overbright sada može koristiti veći dio njegove rezerve."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a kijelző lineárisan reagál. Az Overbright mostantól nagyobb részt használhat a tartalékából."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar ini merespons dalam cahaya linear. Overbright kini dapat menggunakan lebih banyak rentangnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo schermo risponde in luce lineare. Ora Overbright può usare una parte maggiore del suo margine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このディスプレイはリニアに反応します。Overbrightはより広い範囲を使用できるようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 디스플레이는 선형으로 반응합니다. 이제 Overbright가 더 넓은 범위를 사용할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paparan ini bertindak balas dalam cahaya linear. Overbright kini boleh menggunakan lebih banyak julatnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne skjermen reagerer i lineært lys. Overbright kan nå bruke mer av lysreserven."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit beeldscherm reageert in lineair licht. Overbright kan nu meer van het bereik gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten wyświetlacz reaguje liniowo. Overbright może teraz wykorzystać większą część jego zapasu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta tela responde em luz linear. Agora o Overbright pode usar mais da margem dela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este monitor responde em luz linear. O Overbright pode agora usar mais da sua margem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest afișaj răspunde liniar. Overbright poate folosi acum o parte mai mare din rezerva sa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этого дисплея линейный отклик. Теперь Overbright может использовать больший запас яркости."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento displej má lineárnu odozvu. Overbright teraz môže využiť väčšiu časť jeho rozsahu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta zaslon ima linearen odziv. Overbright lahko zdaj uporabi večji del njegovega razpona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här skärmen svarar linjärt på ljus. Overbright kan nu använda mer av ljusreserven."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จอภาพนี้ตอบสนองแบบเชิงเส้น ตอนนี้ Overbright ใช้ช่วงของจอได้มากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ekran doğrusal ışıkla yanıt veriyor. Overbright artık aralığının daha fazlasını kullanabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей дисплей має лінійний відгук. Тепер Overbright може використовувати більший запас яскравості."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màn hình này phản hồi theo ánh sáng tuyến tính. Giờ đây Overbright có thể dùng nhiều dải sáng hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此显示器为线性响应。Overbright现在可以使用更大的范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此顯示器以線性光反應。Overbright現在可以使用更多亮度餘裕。"
          }
        }
      }
    },
