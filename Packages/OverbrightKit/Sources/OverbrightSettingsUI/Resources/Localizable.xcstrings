    "When it’s hidden, open Overbright from Finder or Spotlight to see Settings." : {
      "comment" : "Settings ▸ General: footnote of Show menu bar icon",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما تكون مخفية، افتح Overbright من فايندر أو الباحث لرؤية الإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan està oculta, obre l’Overbright des del Finder o l’Spotlight per veure la configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je skrytá, otevřete Overbright z Finderu nebo pomocí Spotlightu a zobrazí se Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når det er skjult, kan du åbne Overbright fra Finder eller Spotlight for at se indstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es ausgeblendet ist, öffne Overbright über den Finder oder Spotlight, um die Einstellungen zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι κρυφό, ανοίξτε το Overbright από το Finder ή το Spotlight για να δείτε τις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está oculto, abre Overbright desde el Finder o Spotlight para ver los ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun se on kätkettynä, avaa Overbright Finderista tai Spotlightista, niin näet asetukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu’elle est masquée, ouvrez Overbright depuis le Finder ou Spotlight pour afficher les réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהצלמית מוסתרת, יש לפתוח את Overbright מ-Finder או מ-Spotlight כדי לראות את ההגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब यह छिपा हो, तो सेटिंग देखने के लिए Finder या Spotlight से Overbright खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je skrivena, otvorite Overbright iz Findera ili Spotlighta da biste vidjeli postavke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha rejtett, a beállítások eléréséhez nyissa meg az Overbrightot a Finderből vagy a Spotlightból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat disembunyikan, buka Overbright dari Finder atau Spotlight untuk melihat Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando è nascosta, apri Overbright dal Finder o da Spotlight per vedere le impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示の場合は、FinderまたはSpotlightからOverbrightを開くと設定が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이콘이 가려져 있으면 Finder 또는 Spotlight에서 Overbright를 열어 설정을 보십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila ia disembunyikan, buka Overbright daripada Finder atau Spotlight untuk melihat Seting."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når det er skjult, åpner du Overbright fra Finder eller Spotlight for å se Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het symbool verborgen is, open je Overbright vanuit de Finder of Spotlight om de instellingen te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ikona jest ukryta, otwórz Overbright z Findera lub ze Spotlight, aby zobaczyć ustawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ele estiver oculto, abra o Overbright pelo Finder ou pelo Spotlight para ver os ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando estiver oculto, abra o Overbright a partir do Finder ou do Spotlight para ver as Definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este ascunsă, deschideți Overbright din Finder sau Spotlight pentru a vedea configurările."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если значок скрыт, откройте Overbright из Finder или Spotlight, чтобы попасть в настройки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je skrytá, otvorte Overbright z Findera alebo zo Spotlightu a zobrazia sa Nastavenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je skrita, odprite Overbright iz Finderja ali Spotlighta, da vidite nastavitve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När den är gömd öppnar du Overbright från Finder eller Spotlight för att se inställningarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อไอคอนถูกซ่อน ให้เปิด Overbright จาก Finder หรือ Spotlight เพื่อดูการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizliyken Ayarlar’ı görmek için Overbright’ı Finder’dan veya Spotlight’tan açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо значок приховано, відкрийте Overbright із Finder або Spotlight, щоб перейти до параметрів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi biểu tượng bị ẩn, hãy mở Overbright từ Finder hoặc Spotlight để xem Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图标隐藏时，从访达或聚焦打开Overbright即可查看设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖像隱藏時，從Finder或Spotlight打開Overbright來查看設定。"
          }
        }
      }
    },
    "When it’s off, the panel shows only the built-in display. External displays keep their levels; adjust them below or in the menu." : {
      "comment" : "Settings ▸ Displays: footnote of Show external displays in the panel",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند إيقاف هذا الخيار، تعرض اللوحة الشاشة المضمنة فقط. وتحتفظ الشاشات الخارجية بمستوياتها؛ يمكنك ضبطها أدناه أو من القائمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan aquesta opció està desactivada, el tauler només mostra la pantalla integrada. Les pantalles externes mantenen el seu nivell; ajusta‑les més avall o al menú."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je tato volba vypnutá, panel zobrazuje jen vestavěný monitor. Externí monitory si zachovají své úrovně; můžete je upravit níže nebo v nabídce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når indstillingen er slået fra, viser panelet kun den indbyggede skærm. Eksterne skærme beholder deres niveauer; juster dem nedenfor eller i menuen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Option deaktiviert ist, zeigt das Panel nur das integrierte Display an. Externe Displays behalten ihre Stufen; passe sie unten oder im Menü an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν η επιλογή είναι απενεργοποιημένη, το πάνελ εμφανίζει μόνο την ενσωματωμένη οθόνη. Οι εξωτερικές οθόνες διατηρούν τα επίπεδά τους. Μπορείτε να τα ρυθμίσετε παρακάτω ή στο μενού."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si esta opción está desactivada, el panel solo muestra la pantalla integrada. Las pantallas externas mantienen su nivel; ajústalas más abajo o en el menú."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on pois päältä, paneelissa näkyy vain sisäinen näyttö. Ulkoiset näytöt säilyttävät tasonsa; niitä voi säätää alempana tai valikossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est désactivée, le panneau n’affiche que l’écran intégré. Les écrans externes conservent leur niveau ; réglez-les ci-dessous ou dans le menu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהאפשרות כבויה, הלוח מציג רק את הצג המובנה. הצגים החיצוניים שומרים על הרמות שלהם; אפשר לכוונן אותן למטה או בתפריט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब यह सेटिंग बंद हो, तो पैनल सिर्फ़ बिल्टइन डिस्प्ले दिखाता है। बाहरी डिस्प्ले अपने स्तर बनाए रखते हैं; आप उन्हें नीचे या मेन्यू में ऐडजस्ट कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad je ova postavka isključena, ploča prikazuje samo ugrađeni zaslon. Vanjski zasloni zadržavaju svoje razine; možete ih podesiti u nastavku ili u izborniku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ki van kapcsolva, a panelen csak a beépített kijelző jelenik meg. A külső kijelzők megtartják a szintjüket; ezeket alább vagy a menüben állíthatja be."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat dimatikan, panel hanya menampilkan layar internal. Layar eksternal mempertahankan levelnya; sesuaikan di bawah atau di menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando questa opzione è disattivata, il pannello mostra solo lo schermo integrato. Gli schermi esterni mantengono il proprio livello; regolali qui sotto o nel menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフの場合は、パネルには内蔵ディスプレイのみが表示されます。外部ディスプレイのレベルは維持され、下の設定またはメニューで調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 옵션을 끄면 패널에 내장 디스플레이만 표시됩니다. 외장 디스플레이는 레벨을 그대로 유지하며, 아래 또는 메뉴에서 조절할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila ia dimatikan, panel hanya menunjukkan paparan terbina dalam. Paparan luaran mengekalkan tahap masing-masing; laraskannya di bawah atau dalam menu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når innstillingen er av, viser panelet bare den innebygde skjermen. Eksterne skjermer beholder nivåene sine; du kan justere dem nedenfor eller i menyen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit is uitgeschakeld, toont het paneel alleen het ingebouwde beeldscherm. Externe beeldschermen behouden hun niveau; pas ze hieronder of in het menu aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ta opcja jest wyłączona, panel pokazuje tylko wbudowany wyświetlacz. Wyświetlacze zewnętrzne zachowują swoje poziomy; możesz je regulować poniżej lub w menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando esta opção estiver desativada, o painel mostra somente a tela integrada. As telas externas mantêm seus níveis; ajuste-as abaixo ou no menu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando esta opção estiver desativada, o painel mostra apenas o monitor integrado. Os monitores externos mantêm o seu nível; ajuste‑os mais abaixo ou no menu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când opțiunea este dezactivată, panoul arată doar afișajul integrat. Afișajele externe își păstrează nivelurile; ajustați‑le mai jos sau din meniu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выключено, в панели показан только встроенный дисплей. Внешние дисплеи сохраняют свои уровни; их можно настроить ниже или в меню."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď je táto funkcia vypnutá, panel zobrazuje len vstavaný displej. Externé displeje si zachovajú svoje úrovne; môžete ich upraviť nižšie alebo v menu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je ta možnost izklopljena, plošča prikazuje samo vgrajeni zaslon. Zunanji zasloni ohranijo svoje ravni; prilagodite jih lahko spodaj ali v meniju."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När inställningen är av visar panelen bara den inbyggda skärmen. Externa skärmar behåller sina nivåer; justera dem nedan eller i menyn."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อปิดตัวเลือกนี้ แผงจะแสดงเฉพาะจอภาพในตัวเครื่อง จอภาพภายนอกจะคงระดับของตัวเองไว้ ปรับได้ที่ด้านล่างหรือในเมนู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ayar kapalıyken panel yalnızca yerleşik ekranı gösterir. Harici ekranlar düzeylerini korur; bunları aşağıda veya menüde ayarlayabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо цей параметр вимкнено, на панелі показано лише вбудований дисплей. Зовнішні дисплеї зберігають свої рівні; їх можна налаштувати нижче або в меню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tắt tùy chọn này, bảng điều khiển chỉ hiển thị màn hình tích hợp. Các màn hình ngoài vẫn giữ mức riêng; bạn có thể điều chỉnh chúng ở bên dưới hoặc trong menu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时，面板仅显示内建显示器。外接显示器会保持各自的级别；你可以在下方或菜单中调整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉時，面板只會顯示內建顯示器。外接顯示器會保留各自的等級；你可以在下方或選單中調整。"
          }
        }
      }
    },
