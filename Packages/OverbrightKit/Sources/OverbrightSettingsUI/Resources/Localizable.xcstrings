    "Lights your face on video calls with a glowing frame around the screen." : {
      "comment" : "Settings ▸ Fill Light: footnote of the Fill Light switch",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lights your face on video calls with a glowing frame around the screen."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il·lumina la teva cara a les videotrucades amb un marc lluminós al voltant de la pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
