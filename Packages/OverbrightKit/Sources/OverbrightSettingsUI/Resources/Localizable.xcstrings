    "OLED displays get a lower Safe limit and pause extra brightness when idle." : {
      "comment" : "Settings ▸ Displays: footnote of Display type",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "OLED displays get a lower Safe limit and pause extra brightness when idle."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pantalles OLED tenen un límit “Segur” més baix i posen en pausa la brillantor extra quan no hi ha activitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitory OLED mají nižší limit „Bezpečný“ a při nečinnosti se extra jas pozastaví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På OLED-skærme er grænsen Sikker lavere, og ekstra lysstyrke sættes på pause ved inaktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED-Displays erhalten eine niedrigere Grenze „Sicher“ und pausieren die Zusatzhelligkeit bei Inaktivität."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι οθόνες OLED έχουν χαμηλότερο όριο «Ασφαλές» και θέτουν σε παύση την επιπλέον φωτεινότητα όταν δεν χρησιμοποιούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pantallas OLED tienen un límite “Seguro” más bajo y pausan el brillo extra cuando están inactivas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED-näytöillä ”Turvallinen”-raja on matalampi, ja lisäkirkkaus jää tauolle, kun Macia ei käytetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les écrans OLED ont une limite « Sécurité » plus basse et mettent la luminosité supplémentaire en pause en cas d’inactivité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "OLED displays get a lower Safe limit and pause extra brightness when idle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "OLED displays get a lower Safe limit and pause extra brightness when idle."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED zasloni imaju nižu sigurnu granicu i pauziraju dodatnu svjetlinu kad miruju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az OLED-kijelzők alacsonyabb „Biztonságos” határt kapnak, és tétlenség esetén szüneteltetik az extra fényerőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "OLED displays get a lower Safe limit and pause extra brightness when idle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli schermi OLED hanno un limite “Sicuro” più basso e mettono in pausa la luminosità extra quando sono inattivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
