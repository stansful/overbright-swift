    "Choose what Overbright does in each Focus in Focus settings: leave it alone, turn it off, or turn it on at a level." : {
      "comment" : "Settings ▸ Automations: the Focus note; “Focus” is macOS’s own name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choose what Overbright does in each Focus in Focus settings: leave it alone, turn it off, or turn it on at a level."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choose what Overbright does in each Focus in Focus settings: leave it alone, turn it off, or turn it on at a level."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nastavení Soustředění zvolte, co Overbright v jednotlivých režimech soustředění udělá: nechá vše být, vypne se, nebo se zapne na zvolené úrovni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg i indstillingerne til Fokus, hvad Overbright gør i hver fokusfunktion: lader den være, slår den fra eller slår den til på et bestemt niveau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege in den Systemeinstellungen unter „Fokus“ fest, was Overbright in jedem Fokus tut: nichts ändern, ausschalten oder mit einer bestimmten Stufe einschalten."
          }
        },
        "el" : {
          "stringUnit" : {
