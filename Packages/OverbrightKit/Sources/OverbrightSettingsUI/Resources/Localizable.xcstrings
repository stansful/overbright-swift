          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjermene går tilbake til Standard. Åpne Overbright igjen fra Finder eller Spotlight."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je beeldschermen gaan terug naar ‘Standaard’. Open Overbright opnieuw vanuit de Finder of Spotlight."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlacze wrócą do poziomu „Standard”. Overbright możesz ponownie otworzyć z Findera lub ze Spotlight."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas telas voltam ao Padrão. Abra o Overbright de novo pelo Finder ou pelo Spotlight."
          }
        },
        "pt-PT" : {
