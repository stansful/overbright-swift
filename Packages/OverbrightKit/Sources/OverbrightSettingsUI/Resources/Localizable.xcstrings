    "OLED displays get a lower Safe limit and pause extra brightness when idle." : {
      "comment" : "Settings ▸ Displays: footnote of Display type",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحصل شاشات OLED على حد \"آمن\" أقل، وتتوقف الإضاءة الإضافية مؤقتًا عند الخمول."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pantalles OLED tenen un límit “Segur” més baix i posen en pausa la brillantor extra quan no hi ha activitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitory OLED mají nižší limit „Bezpečný“ a při nečinnosti se extra jas pozastaví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På OLED-skærme er grænsen Sikker lavere, og ekstra lysstyrke sættes på pause ved inaktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED-Displays erhalten eine niedrigere Grenze „Sicher“ und pausieren die Zusatzhelligkeit bei Inaktivität."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι οθόνες OLED έχουν χαμηλότερο όριο «Ασφαλές» και θέτουν σε παύση την επιπλέον φωτεινότητα όταν δεν χρησιμοποιούνται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pantallas OLED tienen un límite “Seguro” más bajo y pausan el brillo extra cuando están inactivas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED-näytöillä ”Turvallinen”-raja on matalampi, ja lisäkirkkaus jää tauolle, kun Macia ei käytetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les écrans OLED ont une limite « Sécurité » plus basse et mettent la luminosité supplémentaire en pause en cas d’inactivité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בצגי OLED מגבלת ״בטוח״ נמוכה יותר, והבהירות הנוספת מושהית כשאין פעילות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED डिस्प्ले की “सुरक्षित” सीमा कम होती है और निष्क्रिय होने पर अतिरिक्त ब्राइटनेस पॉज़ हो जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED zasloni imaju nižu sigurnu granicu i pauziraju dodatnu svjetlinu kad miruju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az OLED-kijelzők alacsonyabb „Biztonságos” határt kapnak, és tétlenség esetén szüneteltetik az extra fényerőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar OLED mendapat batas Aman yang lebih rendah dan menjeda kecerahan ekstra saat tidak aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli schermi OLED hanno un limite “Sicuro” più basso e mettono in pausa la luminosità extra quando sono inattivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLEDディスプレイでは“安全”の上限が低くなり、操作がないときは追加の輝度が一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED 디스플레이는 ‘안전’ 한도가 더 낮으며 유휴 상태일 때 추가 밝기가 일시 정지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paparan OLED mendapat had Selamat yang lebih rendah dan menjeda kecerahan tambahan apabila melahu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED-skjermer får en lavere «Trygg»-grense og setter ekstra lysstyrke på pause når de ikke er i bruk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED-beeldschermen krijgen een lagere limiet ‘Veilig’ en pauzeren extra helderheid als ze inactief zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlacze OLED mają niższy limit „Bezpieczny” i wstrzymują dodatkową jasność podczas bezczynności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telas OLED têm um limite “Seguro” mais baixo e pausam o brilho extra quando ficam inativas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os monitores OLED têm um limite “Seguro” mais baixo e colocam o brilho extra em pausa quando estão inativos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișajele OLED au o limită „Sigur” mai mică și pun pe pauză luminozitatea suplimentară când sunt inactive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У OLED-дисплеев предел «Безопасно» ниже, а при простое дополнительная яркость приостанавливается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displeje OLED majú nižší limit „Bezpečný“ a pri nečinnosti sa extra jas pozastaví."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasloni OLED imajo nižjo omejitev »Varno«, ob nedejavnosti pa se dodatna svetlost začasno ustavi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På OLED-skärmar är gränsen Säker lägre och extra ljusstyrka pausas vid inaktivitet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จอภาพ OLED จะมีขีดจำกัด “ปลอดภัย” ที่ต่ำกว่า และหยุดพักความสว่างเพิ่มเติมเมื่อไม่มีการใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED ekranlarda Güvenli sınırı daha düşüktür ve boşta kalındığında ek parlaklık duraklatılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED-дисплеї мають нижчу межу «Безпечно», а під час простою додаткова яскравість призупиняється."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màn hình OLED có giới hạn An toàn thấp hơn và tạm dừng độ sáng bổ sung khi không có thao tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED显示器的“安全”上限较低，并会在闲置时暂停额外亮度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OLED顯示器的「安全」上限較低，且閒置時會暫停額外亮度。"
          }
        }
      }
    },
