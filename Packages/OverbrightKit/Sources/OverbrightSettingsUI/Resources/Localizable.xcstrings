        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ograniczenia dotyczą tylko dodatkowej jasności. Przyciemnianie poniżej minimum działa zawsze, ponieważ oszczędza energię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses limites param apenas o brilho extra. O escurecimento abaixo do mínimo sempre funciona, porque economiza energia."
