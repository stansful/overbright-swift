    "Use this if colors look wrong after another app quit." : {
      "comment" : "Settings ▸ Advanced: footnote of Reset Display Colors",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم هذا إذا بدت الألوان غير صحيحة بعد إنهاء تطبيق آخر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes servir això si els colors es veuen malament després que s’hagi tancat una altra app."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte, pokud barvy po ukončení jiné aplikace nevypadají správně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug dette, hvis farverne ser forkerte ud, efter at en anden app er afsluttet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende dies, wenn die Farben nach dem Beenden einer anderen App falsch aussehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε το αν τα χρώματα φαίνονται λάθος αφού τερματιστεί κάποια άλλη εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsalo si los colores se ven mal después de cerrar otra app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä tätä, jos värit näyttävät väärältä toisen apin lopettamisen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez cette option si les couleurs semblent anormales après la fermeture d’une autre app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר להשתמש בזה אם הצבעים נראים לא תקינים אחרי שיישום אחר נסגר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर किसी दूसरे ऐप के बंद होने के बाद रंग ग़लत दिखें, तो इसका इस्तेमाल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristite ovo ako boje izgledaju neispravno nakon zatvaranja druge aplikacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkor használja, ha egy másik app kilépése után hibásak a színek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan ini jika warna tampak salah setelah app lain ditutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usalo se i colori sembrano errati dopo la chiusura di un’altra app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のAppを終了した後に色がおかしい場合に使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱을 종료한 후 색상이 이상하게 보이면 사용하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan ini jika warna kelihatan salah selepas app lain keluar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk dette hvis fargene ser feil ut etter at en annen app er avsluttet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik dit als kleuren er verkeerd uitzien nadat een andere app is gestopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj tej opcji, jeśli kolory wyglądają nieprawidłowo po zakończeniu innej aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use se as cores parecerem erradas depois que outro app for encerrado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use esta opção se as cores parecerem incorretas depois de outra aplicação ter sido encerrada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosiți această opțiune dacă culorile arată greșit după închiderea altei aplicații."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
