    "Dims every display to your last dim level, or brings them back." : {
      "comment" : "Settings ▸ Shortcuts: footnote of Dim Below Minimum On or Off",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dims every display to your last dim level, or brings them back."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenua totes les pantalles fins a l’últim nivell d’atenuació o les torna al seu nivell."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
