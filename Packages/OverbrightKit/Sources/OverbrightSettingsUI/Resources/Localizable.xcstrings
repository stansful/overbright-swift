    "How color table changes behave in screenshots. No code was copied." : {
      "comment" : "Settings ▸ About ▸ Acknowledgments: what Overbright learned from MonitorControl",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "How color table changes behave in screenshots. No code was copied."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com es comporten els canvis a la taula de colors a les captures de pantalla. No s’ha copiat cap codi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak se změny tabulky barev projevují na snímcích obrazovky. Žádný kód nebyl zkopírován."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan ændringer i farvetabellen opfører sig på skærmbilleder. Der blev ikke kopieret kode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie sich Änderungen der Farbtabelle auf Bildschirmfotos auswirken. Es wurde kein Code kopiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πώς συμπεριφέρονται οι αλλαγές στον πίνακα χρωμάτων στα στιγμιότυπα οθόνης. Δεν αντιγράφηκε κώδικας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo se comportan los cambios en la tabla de colores en las capturas de pantalla. No se ha copiado código."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miten väritaulukon muutokset käyttäytyvät näyttökuvissa. Koodia ei kopioitu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le comportement des modifications de la table des couleurs dans les captures d’écran. Aucun code n’a été copié."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "How color table changes behave in screenshots. No code was copied."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "How color table changes behave in screenshots. No code was copied."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako se promjene tablice boja ponašaju na slikama zaslona. Kod nije kopiran."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogyan viselkednek a színtábla módosításai a képernyőfotókon. Kódot nem másoltunk."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
