          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je menijska vrstica polna ali macOS skrije ikono, odprite Overbright iz Finderja ali Spotlighta, da vidite nastavitve. V nastavitvah Menijska vrstica preverite, ali je Overbright vklopljen pod »Dovoljeno v menijski vrstici«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "If the menu bar is full or macOS hides the icon, open Overbright from Finder or Spotlight to see Settings. In Menu Bar settings, check that Overbright is turned on under Allow in the Menu Bar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "If the menu bar is full or macOS hides the icon, open Overbright from Finder or Spotlight to see Settings. In Menu Bar settings, check that Overbright is turned on under Allow in the Menu Bar."
          }
        },
        "tr" : {
