    "A one-minute check makes sure extra brightness is right for %@." : {
      "comment" : "Panel: the one-time calibration tip; the placeholder is a display name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتأكد فحص مدته دقيقة واحدة من أن الإضاءة الإضافية مناسبة للشاشة \"%@\"."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una comprovació d’un minut garanteix que la brillantor extra sigui correcta per a %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minutová kontrola ověří, že je extra jas pro monitor „%@“ nastavený správně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et tjek på et minut sikrer, at ekstra lysstyrke passer til %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine einminütige Prüfung stellt sicher, dass die Zusatzhelligkeit für „%@“ richtig ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας έλεγχος ενός λεπτού διασφαλίζει ότι η επιπλέον φωτεινότητα είναι σωστή για την οθόνη «%@»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
