            "value" : "Change the display preset in Displays settings and back, or log out. If another color app was running, quit it. Settings ▸ Advanced ▸ Reset Display Colors can also help."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promijenite podešenje zaslona u odjeljku Zasloni u Postavkama sustava pa ga vratite ili se odjavite. Ako je bila pokrenuta druga aplikacija za boje, zatvorite je. Može pomoći i “Resetiraj boje zaslona…” u odjeljku Postavke ▸ Napredno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Change the display preset in Displays settings and back, or log out. If another color app was running, quit it. Settings ▸ Advanced ▸ Reset Display Colors can also help."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Change the display preset in Displays settings and back, or log out. If another color app was running, quit it. Settings ▸ Advanced ▸ Reset Display Colors can also help."
          }
        },
        "it" : {
