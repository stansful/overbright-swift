    "How do I get back to normal right away?" : {
      "comment" : "Help: question",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف أعود إلى الوضع العادي فورًا؟"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com puc tornar a la normalitat de seguida?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak okamžitě vrátit běžný jas?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan kommer jeg straks tilbage til det normale?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie komme ich sofort zum Normalzustand zurück?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πώς επανέρχομαι αμέσως στην κανονική φωτεινότητα;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo vuelvo a la normalidad al instante?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miten palaan heti normaaliin?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment revenir immédiatement à la normale ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איך חוזרים מיד למצב הרגיל?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैं तुरंत सामान्य स्थिति में कैसे लौटूँ?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako se odmah vratiti na normalnu svjetlinu?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogyan térhetek vissza azonnal a normál fényerőhöz?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagaimana cara langsung kembali normal?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come torno subito alla normalità?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すぐに通常の状態に戻すには?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즉시 원래대로 되돌리려면 어떻게 해야 합니까?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagaimanakah saya kembali normal dengan segera?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvordan kommer jeg tilbake til det normale med en gang?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe ga ik meteen terug naar normaal?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak od razu wrócić do normalnej jasności?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como volto ao normal imediatamente?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como volto imediatamente ao normal?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cum revin imediat la normal?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как сразу вернуть обычную яркость?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako okamžite vrátiť bežný jas?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako takoj vrniti običajno svetlost?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur kommer jag tillbaka till det normala direkt?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะกลับสู่ปกติทันทีได้อย่างไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemen normale nasıl dönerim?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Як одразу повернути звичайну яскравість?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm sao để trở lại bình thường ngay lập tức?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何立即恢复正常？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何立即恢復正常？"
          }
        }
      }
    },
    "If the menu bar is full or macOS hides the icon, open Overbright from Finder or Spotlight to see Settings. In Menu Bar settings, check that Overbright is turned on under Allow in the Menu Bar." : {
      "comment" : "Help: answer about a hidden menu bar icon",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان شريط القوائم ممتلئًا أو كان macOS يخفي الأيقونة، فافتح Overbright من فايندر أو الباحث لرؤية الإعدادات. وفي إعدادات \"شريط القوائم\"، تأكد من تشغيل Overbright ضمن \"السماح في شريط القوائم\"."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la barra de menús és plena o el macOS n’amaga la icona, obre l’Overbright des del Finder o l’Spotlight per veure la configuració. A la secció Barra de menús de la configuració del sistema, comprova que l’Overbright estigui activat a “Permet a la barra de menús”."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud je řádek nabídek plný nebo macOS ikonu skrývá, otevřete Overbright z Finderu nebo pomocí Spotlightu a zobrazí se Nastavení. V nastavení Řádek nabídek zkontrolujte, že je Overbright zapnutý v seznamu Povolit v řádku nabídek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis menulinjen er fuld, eller macOS skjuler symbolet, kan du åbne Overbright fra Finder eller Spotlight for at se indstillingerne. Tjek i indstillingerne til Menulinje, at Overbright er slået til under “Tillad på menulinjen”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Menüleiste voll ist oder macOS das Symbol ausblendet, öffne Overbright über den Finder oder Spotlight, um die Einstellungen zu sehen. Prüfe in den Systemeinstellungen unter „Menüleiste“, ob Overbright bei „In Menüleiste erlauben“ aktiviert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν η γραμμή μενού είναι γεμάτη ή το macOS κρύβει το εικονίδιο, ανοίξτε το Overbright από το Finder ή το Spotlight για να δείτε τις Ρυθμίσεις. Στις ρυθμίσεις «Γραμμή μενού», ελέγξτε ότι το Overbright είναι ενεργοποιημένο στην ενότητα «Να επιτρέπεται στη γραμμή μενού»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la barra de menús está llena o macOS oculta el icono, abre Overbright desde el Finder o Spotlight para ver los ajustes. En los ajustes de “Barra de menús”, comprueba que Overbright esté activado en “Permitir en la barra de menús”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos valikkorivi on täynnä tai macOS piilottaa kuvakkeen, avaa Overbright Finderista tai Spotlightista, niin näet asetukset. Tarkista Valikkorivi-asetuksista, että Overbright on päällä kohdassa ”Salli valikkorivillä”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la barre des menus est pleine ou si macOS masque l’icône, ouvrez Overbright depuis le Finder ou Spotlight pour afficher les réglages. Dans les réglages Barre des menus, vérifiez qu’Overbright est activé sous « Autoriser dans la barre des menus »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם שורת התפריטים מלאה או שמערכת macOS מסתירה את הצלמית, יש לפתוח את Overbright מ-Finder או מ-Spotlight כדי לראות את ההגדרות. בהגדרות ״שורת התפריטים״ יש לוודא ש-Overbright מופעל תחת ״הצגה בשורת התפריטים״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर मेन्यू बार भरा हुआ है या macOS आइकन छिपा देता है, तो सेटिंग देखने के लिए Finder या Spotlight से Overbright खोलें। मेन्यू बार सेटिंग में देखें कि “मेन्यू बार में अनुमति दें” के अंतर्गत Overbright चालू है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako je traka s izbornicima puna ili macOS skriva ikonu, otvorite Overbright iz Findera ili Spotlighta da biste vidjeli postavke. U odjeljku Traka s izbornicima u Postavkama sustava provjerite je li Overbright uključen pod “Dozvoli u traci s izbornicima”."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a menüsor megtelt, vagy a macOS elrejti az ikont, a beállítások eléréséhez nyissa meg az Overbrightot a Finderből vagy a Spotlightból. A Rendszerbeállítások Menüsor részében ellenőrizze, hogy az Overbright be van-e kapcsolva az „Engedélyezés a menüsoron” alatt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika bar menu penuh atau macOS menyembunyikan ikonnya, buka Overbright dari Finder atau Spotlight untuk melihat Pengaturan. Di pengaturan Bar Menu, pastikan Overbright dinyalakan di bawah “Izinkan di Bar Menu”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la barra dei menu è piena o macOS nasconde l’icona, apri Overbright dal Finder o da Spotlight per vedere le impostazioni. Nelle impostazioni “Barra dei menu”, verifica che Overbright sia attivo in “Consenti nella barra dei menu”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーがいっぱいの場合や、macOSによってアイコンが非表示になっている場合は、FinderまたはSpotlightからOverbrightを開くと設定が表示されます。“メニューバー”設定の“メニューバーに追加することを許可”で、Overbrightがオンになっていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대가 가득 찼거나 macOS가 아이콘을 가리는 경우 Finder 또는 Spotlight에서 Overbright를 열면 설정이 표시됩니다. ‘메뉴 막대’ 설정의 ‘메뉴 막대에서 허용’에서 Overbright가 켜져 있는지 확인하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika bar menu penuh atau macOS menyembunyikan ikon, buka Overbright daripada Finder atau Spotlight untuk melihat Seting. Dalam seting Bar Menu, pastikan Overbright dihidupkan di bawah “Benarkan dalam Bar Menu”."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis menylinjen er full eller macOS skjuler symbolet, åpner du Overbright fra Finder eller Spotlight for å se Innstillinger. I Menylinje-innstillingene kontrollerer du at Overbright er slått på under «Tillat i menylinjen»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de menubalk vol is of macOS het symbool verbergt, open je Overbright vanuit de Finder of Spotlight om de instellingen te zien. Controleer in de instellingen voor ‘Menubalk’ of Overbright is ingeschakeld bij ‘Sta toe in de menubalk’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli pasek menu jest zapełniony lub macOS ukrywa ikonę, otwórz Overbright z Findera lub ze Spotlight, aby zobaczyć ustawienia. W ustawieniach „Pasek menu” sprawdź, czy Overbright jest włączony na liście „Pozwalaj na pasku menu”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a barra de menus estiver cheia ou o macOS ocultar o ícone, abra o Overbright pelo Finder ou pelo Spotlight para ver os ajustes. Nos ajustes de Barra de Menus, verifique se o Overbright está ativado em Permitir na Barra de Menus."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a barra de menus estiver cheia ou o macOS ocultar o ícone, abra o Overbright a partir do Finder ou do Spotlight para ver as Definições. Nas definições da Barra de menus, confirme que o Overbright está ativado em “Permitir na barra de menus”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă bara de meniu este plină sau macOS ascunde pictograma, deschideți Overbright din Finder sau Spotlight pentru a vedea configurările. În secțiunea Bară de meniu din Configurări sistem, verificați dacă Overbright este activat la „Permiteți în bara de meniu”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если строка меню заполнена или macOS скрывает значок, откройте Overbright из Finder или Spotlight, чтобы попасть в настройки. В разделе «Строка меню» Системных настроек проверьте, что Overbright включён в списке «Разрешить в строке меню»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak je lišta plná alebo macOS ikonu skrýva, otvorte Overbright z Findera alebo zo Spotlightu a zobrazia sa Nastavenia. V nastaveniach Lišta skontrolujte, či je Overbright zapnuté v časti Povoliť položky v lište."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če je menijska vrstica polna ali macOS skrije ikono, odprite Overbright iz Finderja ali Spotlighta, da vidite nastavitve. V nastavitvah Menijska vrstica preverite, ali je Overbright vklopljen pod »Dovoljeno v menijski vrstici«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om menyraden är full eller om macOS döljer symbolen öppnar du Overbright från Finder eller Spotlight för att se inställningarna. Kontrollera i inställningarna för Menyrad att Overbright är påslagen under ”Tillåt i menyraden”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากแถบเมนูเต็มหรือ macOS ซ่อนไอคอนไว้ ให้เปิด Overbright จาก Finder หรือ Spotlight เพื่อดูการตั้งค่า ในการตั้งค่าแถบเมนู ให้ตรวจสอบว่าเปิด Overbright ไว้ใต้ “อนุญาตในแถบเมนู”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğu doluysa ya da macOS simgeyi gizliyorsa Ayarlar’ı görmek için Overbright’ı Finder’dan veya Spotlight’tan açın. Menü Çubuğu ayarlarında, “Menü Çubuğunda İzin Ver” altında Overbright’ın açık olduğunu denetleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо смуга меню заповнена або macOS приховує значок, відкрийте Overbright із Finder чи Spotlight, щоб перейти до параметрів. У розділі «Смуга меню» Системних параметрів перевірте, що Overbright увімкнено у списку «Дозволити на смузі меню»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu thanh menu đã đầy hoặc macOS ẩn biểu tượng, hãy mở Overbright từ Finder hoặc Spotlight để xem Cài đặt. Trong cài đặt Thanh menu, hãy kiểm tra xem Overbright đã được bật trong mục “Cho phép trong thanh menu” chưa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果菜单栏已满或macOS隐藏了图标，请从访达或聚焦打开Overbright以查看设置。在“菜单栏”设置的“允许在菜单栏显示”中，确认Overbright已开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果選單列已滿或macOS隱藏了圖像，請從Finder或Spotlight打開Overbright來查看設定。在「選單列」設定中，確認「在選單列中允許」下方的Overbright已開啟。"
          }
        }
      }
    },
