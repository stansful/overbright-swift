    "The built-in display isn’t in use, and external displays are hidden." : {
      "comment" : "Panel: sentence in place of the cards when the built-in display is not in use (lid closed) and Settings hides external displays from the panel",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشاشة المضمنة غير مستخدمة، والشاشات الخارجية مخفية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla integrada no està en ús i les pantalles externes estan ocultes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vestavěný monitor se nepoužívá a externí monitory jsou skryté."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den indbyggede skærm er ikke i brug, og eksterne skærme er skjult."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das integrierte Display wird nicht verwendet und externe Displays sind ausgeblendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ενσωματωμένη οθόνη δεν χρησιμοποιείται και οι εξωτερικές οθόνες είναι κρυφές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla integrada no está en uso y las pantallas externas están ocultas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisäinen näyttö ei ole käytössä ja ulkoiset näytöt on kätketty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran intégré n’est pas utilisé et les écrans externes sont masqués."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצג המובנה אינו בשימוש, והצגים החיצוניים מוסתרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिल्टइन डिस्प्ले इस्तेमाल में नहीं है और बाहरी डिस्प्ले छिपे हुए हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugrađeni zaslon nije u uporabi, a vanjski su zasloni skriveni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beépített kijelző nincs használatban, a külső kijelzők pedig el vannak rejtve."
          }
