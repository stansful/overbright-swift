    "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once." : {
      "comment" : "Help: answer about Back to Standard; the placeholder is the live key caps of its shortcut",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prem %@ o tria “Desactiva l’Overbright”. Si l’Overbright deixa de respondre, força’n la sortida: el macOS restaura les pantalles immediatament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiskněte %@ nebo zvolte „Vypnout Overbright“. Pokud Overbright přestane reagovat, vynuťte jeho ukončení: macOS monitory okamžitě obnoví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på %@, eller vælg “Slå Overbright fra”. Hvis Overbright holder op med at svare, så brug “Afbryd” i Apple-menuen: macOS gendanner straks dine skærme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke %@ oder wähle „Overbright ausschalten“. Falls Overbright nicht mehr reagiert, verwende „Sofort beenden“: macOS stellt deine Displays umgehend wieder her."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa %@ o elige “Desactivar Overbright”. Si Overbright deja de responder, fuerza su salida: macOS restaurará tus pantallas al instante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur %@ ou choisissez « Désactiver Overbright ». Si Overbright ne répond plus, forcez-le à quitter : macOS restaure immédiatement vos écrans."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pritisnite %@ ili odaberite “Isključi Overbright”. Ako Overbright prestane reagirati, prisilno ga zatvorite: macOS odmah vraća vaše zaslone."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi %@ o scegli “Disattiva Overbright”. Se Overbright non risponde più, forzane l’uscita: macOS ripristina subito i tuoi schermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på %@, eller velg «Slå av Overbright». Hvis Overbright slutter å svare, kan du tvangsavslutte den – macOS gjenoppretter skjermene med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk op %@ of kies ‘Schakel Overbright uit’. Als Overbright niet meer reageert, gebruik dan ‘Forceer stop’: macOS herstelt je beeldschermen meteen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij %@ lub wybierz „Wyłącz Overbright”. Jeśli Overbright przestanie odpowiadać, użyj polecenia „Wymuś koniec”: macOS od razu przywróci wyświetlacze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione %@ ou escolha “Desativar Overbright”. Se o Overbright parar de responder, force o encerramento dele: o macOS restaura suas telas imediatamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima %@ ou escolha “Desativar o Overbright”. Se o Overbright deixar de responder, use “Forçar saída”: o macOS restaura imediatamente os monitores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apăsați %@ sau alegeți „Dezactivați Overbright”. Dacă Overbright nu mai răspunde, forțați închiderea: macOS vă restabilește imediat afișajele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите %@ или выберите «Выключить Overbright». Если Overbright перестанет отвечать, завершите его принудительно: macOS сразу восстановит дисплеи."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stlačte %@ alebo vyberte „Vypnúť Overbright“. Ak Overbright prestane reagovať, vynútene ho ukončite: macOS displeje okamžite obnoví."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pritisnite %@ ali izberite »Izklopi Overbright«. Če se Overbright preneha odzivati, ga prisilno zaprite: macOS takoj obnovi vaše zaslone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på %@ eller välj ”Stäng av Overbright”. Om Overbright slutar svara tvångsavslutar du den – macOS återställer dina skärmar direkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть %@ або виберіть «Вимкнути Overbright». Якщо Overbright перестане відповідати, завершіть його примусово: macOS одразу відновить дисплеї."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        }
      }
    },
