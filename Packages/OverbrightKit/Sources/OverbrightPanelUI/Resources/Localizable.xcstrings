          "stringUnit" : {
            "state" : "translated",
            "value" : "Grenze „Sicher“ erreicht: Wähle „Spitze“ für mehr Helligkeit"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτεύχθηκε το όριο «Ασφαλές»: για περισσότερη φωτεινότητα, επιλέξτε «Αιχμή»"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Límite “Seguro” alcanzado: para más brillo, elige “Pico”"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turvallinen raja saavutettu: valitse ”Huippu” saadaksesi lisää"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de sécurité atteinte : choisissez « Pic » pour plus de luminosité"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״בטוח״ הגיע למגבלה: לבהירות רבה יותר יש לבחור ״שיא״"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“सुरक्षित” सीमा तक पहुँच गया: ज़्यादा ब्राइटनेस के लिए “पीक” चुनें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosegnuta je sigurna granica: za više odaberite “Vršno”"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Biztonságos” határ elérve: ha több fényt szeretne, válassza a „Csúcs” értéket"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batas Aman tercapai: pilih Puncak agar lebih terang"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite “Sicuro” raggiunto: per più luminosità, scegli “Picco”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“安全”の上限に到達: さらに明るくするには“ピーク”を選択"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘안전’ 한도 도달: 더 밝게 하려면 ‘피크’ 선택"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Had Selamat dicapai: pilih Puncak untuk lebih cerah"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trygg grense er nådd: velg «Topp» for mer"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limiet ‘Veilig’ bereikt: kies ‘Piek’ voor meer"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osiągnięto limit „Bezpieczny”: wybierz „Szczyt”, aby było jaśniej"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite “Seguro” atingido: para mais brilho, escolha “Pico”"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite “Seguro” atingido: escolha “Pico” para mais brilho"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita „Sigur” a fost atinsă: pentru mai multă lumină, alegeți „Vârf”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достигнут предел «Безопасно»: чтобы было ярче, выберите «Пик»"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosiahnutý limit „Bezpečný“: ak chcete viac, zvoľte „Špičkový“"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosežena omejitev »Varno«: za več izberite »Vrh«"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gränsen Säker är nådd – välj Topp för mer"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถึงขีดจำกัด “ปลอดภัย” แล้ว: เลือก “ขีดสุด” เพื่อให้สว่างขึ้นอีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenli sınırına ulaşıldı: daha fazlası için Tepe’yi seçin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Досягнуто межі «Безпечно»: щоб було яскравіше, виберіть «Пік»"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã đạt giới hạn An toàn: chọn Đỉnh để sáng hơn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已达到“安全”上限：若要更亮，请选择“峰值”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已達「安全」上限：選擇「峰值」可更亮"
          }
        }
      }
    },
