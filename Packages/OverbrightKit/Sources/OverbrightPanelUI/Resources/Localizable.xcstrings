    "None of your displays can show extra brightness right now." : {
      "comment" : "Panel: sentence above the cards when no display can show extra brightness",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تستطيع أي من شاشاتك عرض إضاءة إضافية الآن."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ara cap de les teves pantalles no pot mostrar brillantor extra."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádný z vašich monitorů teď nedokáže zobrazit extra jas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen af dine skærme kan vise ekstra lysstyrke lige nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keines deiner Displays kann gerade Zusatzhelligkeit anzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καμία από τις οθόνες σας δεν μπορεί να δείξει επιπλέον φωτεινότητα αυτήν τη στιγμή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora mismo ninguna de tus pantallas puede mostrar brillo extra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikään näytöistäsi ei voi näyttää lisäkirkkautta juuri nyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun de vos écrans ne peut afficher de luminosité supplémentaire pour le moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כרגע אף אחד מהצגים שלך לא יכול להציג בהירות נוספת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी आपका कोई भी डिस्प्ले अतिरिक्त ब्राइटनेस नहीं दिखा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nijedan vaš zaslon trenutačno ne može prikazati dodatnu svjetlinu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelenleg egyik kijelzője sem tud extra fényerőt megjeleníteni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ini tidak ada layar Anda yang dapat menampilkan kecerahan ekstra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento nessuno dei tuoi schermi può mostrare la luminosità extra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、追加の輝度を使用できるディスプレイはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 추가 밝기를 표시할 수 있는 디스플레이가 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada paparan anda yang boleh menunjukkan kecerahan tambahan sekarang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen av skjermene dine kan vise ekstra lysstyrke akkurat nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen van je beeldschermen kan op dit moment extra helderheid tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żaden z Twoich wyświetlaczy nie może teraz pokazać dodatkowej jasności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No momento, nenhuma das suas telas pode exibir brilho extra."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neste momento, nenhum dos seus monitores consegue mostrar brilho extra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Momentan, niciunul dintre afișajele dvs. nu poate afișa luminozitate suplimentară."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
