          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokud je zapnutý extra jas, nemohou nejjasnější místa obrazu HDR přesáhnout zjasněnou bílou. Overbright se pozastavuje u videa na celou obrazovku a u přehrávačů videa; další aplikace přidáte v Nastavení ▸ Automatizace."
          }
        },
