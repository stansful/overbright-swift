        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक मिनट की जाँच से पक्का होता है कि %@ के लिए अतिरिक्त ब्राइटनेस सही है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednominutna provjera osigurava da je dodatna svjetlina ispravno podešena za zaslon “%@”."
          }
        },
        "hu" : {
