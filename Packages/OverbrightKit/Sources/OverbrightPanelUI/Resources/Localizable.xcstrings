        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień ustawienie wstępne wyświetlacza w ustawieniach „Wyświetlacze”, a potem przywróć poprzednie, albo wyloguj się. Jeśli działała inna aplikacja do kolorów, zakończ ją. Pomóc może też Ustawienia ▸ Zaawansowane ▸ Wyzeruj kolory wyświetlaczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Change the display preset in Displays settings and back, or log out. If another color app was running, quit it. Settings ▸ Advanced ▸ Reset Display Colors can also help."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
