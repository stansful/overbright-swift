          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre la luminosità extra è attiva, le alte luci HDR non possono superare il bianco potenziato. Overbright va in pausa con i video a tutto schermo e con i player video; aggiungi altre app in Impostazioni ▸ Automazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
