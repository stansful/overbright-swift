    "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once." : {
      "comment" : "Help: answer about Back to Standard; the placeholder is the live key caps of its shortcut",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Press %@, or choose Turn Off Overbright. If Overbright stops responding, Force Quit it: macOS restores your displays at once."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiskněte %@ nebo zvolte „Vypnout Overbright“. Pokud Overbright přestane reagovat, vynuťte jeho ukončení: macOS monitory okamžitě obnoví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på %@, eller vælg “Slå Overbright fra”. Hvis Overbright holder op med at svare, så brug “Afbryd” i Apple-menuen: macOS gendanner straks dine skærme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke %@ oder wähle „Overbright ausschalten“. Falls Overbright nicht mehr reagiert, verwende „Sofort beenden“: macOS stellt deine Displays umgehend wieder her."
          }
        },
        "el" : {
          "stringUnit" : {
