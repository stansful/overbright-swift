    "Use extra brightness on this OLED display?" : {
      "comment" : "Panel: title of the alert shown before extra brightness turns on for an OLED display",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد استخدام الإضاءة الإضافية على شاشة OLED هذه؟"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols fer servir la brillantor extra en aquesta pantalla OLED?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používat extra jas na tomto monitoru OLED?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du bruge ekstra lysstyrke på denne OLED-skærm?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusatzhelligkeit auf diesem OLED-Display verwenden?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να χρησιμοποιηθεί επιπλέον φωτεινότητα σε αυτήν την οθόνη OLED;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Usar brillo extra en esta pantalla OLED?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetäänkö lisäkirkkautta tällä OLED-näytöllä?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser la luminosité supplémentaire sur cet écran OLED ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להשתמש בבהירות נוספת בצג ה-OLED הזה?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस OLED डिस्प्ले पर अतिरिक्त ब्राइटनेस इस्तेमाल करें?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristiti dodatnu svjetlinu na ovom OLED zaslonu?"
          }
