    "For the most light, turn your display brightness all the way up first; Overbright adds to it." : {
      "comment" : "Panel ▸ Display card: help tag of the readout",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لأكبر قدر من الضوء، ارفع إضاءة الشاشة إلى أقصاها أولًا، إذ يضيف Overbright إليها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per obtenir tanta llum com sigui possible, primer apuja del tot la brillantor de la pantalla; l’Overbright hi afegeix llum."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro co nejvíc světla nejdřív nastavte jas monitoru na maximum; Overbright přidá světlo navíc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skru først helt op for skærmens lysstyrke for at få mest lys. Overbright lægger lys oven i."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für maximales Licht stelle zuerst die Displayhelligkeit ganz hoch; Overbright erhöht sie zusätzlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για όσο το δυνατόν περισσότερο φως, ανεβάστε πρώτα τη φωτεινότητα της οθόνης στο μέγιστο. Το Overbright προσθέτει φως πάνω σε αυτήν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para obtener la máxima luz, sube primero el brillo de la pantalla del todo; Overbright se suma a él."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat eniten valoa, kun nostat ensin näytön kirkkauden täysille – Overbright lisää valoa sen päälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un maximum de lumière, montez d’abord la luminosité de l’écran au maximum ; Overbright s’y ajoute."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לקבלת מרב האור, יש להגביר קודם את בהירות הצג עד הסוף; Overbright מוסיף עליה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे ज़्यादा रोशनी के लिए पहले डिस्प्ले की ब्राइटनेस पूरी बढ़ाएँ; Overbright उसमें और जोड़ता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za najviše svjetla najprije povećajte svjetlinu zaslona do kraja; Overbright dodaje svjetlo povrh nje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A legtöbb fényért először állítsa a kijelző fényerejét maximumra; az Overbright ehhez ad hozzá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agar paling terang, maksimalkan dulu kecerahan layar; Overbright menambah di atasnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per avere più luce possibile, porta prima la luminosità dello schermo al massimo; Overbright si aggiunge a essa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も明るくするには、まず輝度を最大にしてください。Overbrightはそこに上乗せします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대한 밝게 하려면 먼저 밝기를 끝까지 높이십시오. Overbright는 그 위에 밝기를 더합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk paling cerah, maksimumkan kecerahan paparan dahulu; Overbright menambah di atasnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få mest mulig lys ved å skru lysstyrken på skjermen helt opp først – Overbright legger til mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet voor het meeste licht eerst de helderheid van je beeldscherm helemaal omhoog; Overbright voegt daar licht aan toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby uzyskać jak najwięcej światła, najpierw ustaw maksymalną jasność wyświetlacza; Overbright dodaje światło ponad nią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ter o máximo de luz, aumente primeiro o brilho da tela até o fim; o Overbright acrescenta luz a ele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para obter o máximo de luz, ponha primeiro o brilho do monitor no máximo; o Overbright acrescenta luz a esse brilho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru cât mai multă lumină, setați mai întâi luminozitatea afișajului la maximum; Overbright adaugă peste ea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы было как можно ярче, сначала поднимите яркость дисплея до максимума: Overbright добавляет свет поверх неё."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre čo najviac svetla najprv nastavte jas displeja na maximum; Overbright pridáva navyše."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za čim več svetlobe najprej nastavite najvišjo svetlost zaslona; Overbright doda še več."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höj först skärmens ljusstyrka hela vägen för mest ljus. Overbright lägger till ljus ovanpå."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อให้ได้แสงมากที่สุด ให้เพิ่มความสว่างของจอภาพจนสุดก่อน Overbright จะเพิ่มต่อจากนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fazla ışık için önce ekran parlaklığını sonuna kadar açın; Overbright bunun üstüne ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб було якомога яскравіше, спершу підніміть яскравість дисплея до максимуму: Overbright додає світло поверх неї."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để sáng nhất, trước hết hãy tăng độ sáng màn hình lên tối đa; Overbright cộng thêm vào đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要获得最大亮度，请先将显示器亮度调到最高；Overbright会在此基础上增加亮度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要取得最大亮度，請先將顯示器亮度調到最高；Overbright會在此基礎上增加亮度。"
          }
        }
      }
    },
