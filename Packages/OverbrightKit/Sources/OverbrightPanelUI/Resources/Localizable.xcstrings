        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Change the display preset in Displays settings and back, or log out. If another color app was running, quit it. Settings ▸ Advanced ▸ Reset Display Colors can also help."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смените набор настроек дисплея в разделе «Дисплеи» Системных настроек, а затем верните прежний. Или завершите сеанс. Если было запущено другое приложение для настройки цвета, завершите его. Также может помочь кнопка «Сбросить цвета дисплеев…» в разделе Настройки ▸ Дополнительно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nastaveniach Displeje zmeňte predvoľbu displeja a potom ju vráťte späť, prípadne sa odhláste. Ak bola spustená iná apka na úpravu farieb, ukončite ju. Pomôcť môže aj Nastavenia ▸ Rozšírené ▸ Resetovať farby displejov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V nastavitvah Zasloni spremenite prednastavitev zaslona in jo nato vrnite nazaj ali pa se odjavite. Če je bila odprta druga aplikacija za barve, jo zaprite. Pomaga lahko tudi Nastavitve ▸ Napredno ▸ Ponastavi barve zaslonov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Change the display preset in Displays settings and back, or log out. If another color app was running, quit it. Settings ▸ Advanced ▸ Reset Display Colors can also help."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Change the display preset in Displays settings and back, or log out. If another color app was running, quit it. Settings ▸ Advanced ▸ Reset Display Colors can also help."
          }
        },
