    "Dims a display, or every display, below the macOS minimum." : {
      "comment" : "Shortcuts app: description of Dim Displays.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعتّم شاشة واحدة أو كل الشاشات دون الحد الأدنى في macOS."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenua una pantalla, o totes, per sota del mínim del macOS."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ztmaví jeden nebo všechny monitory pod minimum macOS."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dæmper én skærm eller alle skærme under minimum i macOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dunkelt ein Display oder alle Displays unter das macOS-Minimum ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χαμηλώνει μία ή όλες τις οθόνες κάτω από το ελάχιστο του macOS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atenúa una pantalla, o todas, por debajo del mínimo de macOS."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Himmentää yhden tai kaikki näytöt alle macOS:n minimin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assombrit un écran, ou tous les écrans, sous le minimum de macOS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעמעם צג אחד, או את כל הצגים, מתחת למינימום של macOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी एक डिस्प्ले या सभी डिस्प्ले को macOS के न्यूनतम से नीचे डिम करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatamnjuje jedan ili sve zaslone ispod minimuma macOS-a."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy vagy az összes kijelzőt a macOS minimuma alá sötétíti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meredupkan satu layar, atau semua layar, di bawah minimum macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscura uno schermo, o tutti, sotto il minimo di macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
