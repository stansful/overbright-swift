    "Turns Overbright off at once. Your levels are kept for next time." : {
      "comment" : "Shortcuts app: description of Back to Standard.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف Overbright فورًا. وتُحفظ مستوياتك للمرة القادمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva l’Overbright a l’instant. Els teus nivells es conserven per a la propera vegada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okamžitě vypne Overbright. Úrovně zůstanou uložené na příště."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår Overbright fra med det samme. Dine niveauer gemmes til næste gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet Overbright sofort aus. Deine Stufen bleiben für das nächste Mal erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποιεί αμέσως το Overbright. Τα επίπεδά σας διατηρούνται για την επόμενη φορά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva Overbright al instante. Tus niveles se conservan para la próxima vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laittaa Overbrightin heti pois päältä. Tasosi säilyvät seuraavaa kertaa varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactive Overbright immédiatement. Vos niveaux sont conservés pour la prochaine fois."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מכבה את Overbright מיד. הרמות נשמרות לפעם הבאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright को तुरंत बंद करता है। आपके स्तर अगली बार के लिए बने रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmah isključuje Overbright. Vaše razine čuvaju se za sljedeći put."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azonnal kikapcsolja az Overbrightot. A szintek megmaradnak a következő alkalomra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsung mematikan Overbright. Level Anda disimpan untuk lain kali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva subito Overbright. I tuoi livelli vengono conservati per la prossima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すぐにOverbrightをオフにします。レベルは次回のために保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즉시 Overbright를 끕니다. 레벨은 다음을 위해 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mematikan Overbright serta-merta. Tahap anda disimpan untuk lain kali."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår av Overbright med en gang. Nivåene dine tas vare på til neste gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakelt Overbright meteen uit. Je niveaus worden bewaard voor de volgende keer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od razu wyłącza Overbright. Poziomy zostają zachowane na następny raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativa o Overbright imediatamente. Seus níveis são mantidos para a próxima vez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativa o Overbright de imediato. Os níveis são guardados para a próxima vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivează imediat Overbright. Nivelurile dvs. sunt păstrate pentru data viitoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сразу выключает Overbright. Уровни сохраняются до следующего раза."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okamžite vypne Overbright. Úrovne zostanú uložené na budúce."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takoj izklopi Overbright. Ravni se ohranijo za naslednjič."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stänger av Overbright direkt. Dina nivåer sparas till nästa gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิด Overbright ทันที ระดับของคุณจะถูกเก็บไว้สำหรับครั้งถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright’ı hemen kapatır. Düzeyleriniz bir sonraki sefer için korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одразу вимикає Overbright. Рівні зберігаються до наступного разу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt Overbright ngay lập tức. Các mức của bạn được giữ cho lần sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即关闭Overbright。你的级别会保留到下次使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即關閉Overbright。你的等級會保留到下次使用。"
          }
        }
      }
    },
    "Turns Overbright off. Your displays return to Standard." : {
      "comment" : "Shortcuts app: description of Turn Off Overbright.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
