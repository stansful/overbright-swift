    "Sets the extra brightness of a display, or of every display. Each display stops at its own limit." : {
      "comment" : "Shortcuts app: description of Set Extra Brightness.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sets the extra brightness of a display, or of every display. Each display stops at its own limit."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la brillantor extra d’una pantalla o de totes. Cada pantalla s’atura al seu propi límit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaví extra jas jednoho nebo všech monitorů. Každý monitor se zastaví na svém vlastním limitu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstiller ekstra lysstyrke for én skærm eller for alle skærme. Hver skærm stopper ved sin egen grænse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
