    "Tells whether Overbright is on, and the level of each display." : {
      "comment" : "Shortcuts app: description of Get Overbright State.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعلمك بما إذا كان Overbright قيد التشغيل، وبمستوى كل شاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica si l’Overbright està activat i el nivell de cada pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zjistí, jestli je Overbright zapnutý, a úroveň každého monitoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortæller, om Overbright er slået til, og hvilket niveau hver skærm har."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt an, ob Overbright eingeschaltet ist und welche Stufe jedes Display hat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενημερώνει αν το Overbright είναι ενεργό και ποιο είναι το επίπεδο κάθε οθόνης."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica si Overbright está activado y el nivel de cada pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kertoo, onko Overbright päällä, ja kunkin näytön tason."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique si Overbright est activé, ainsi que le niveau de chaque écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציין אם Overbright פועל, ואת הרמה של כל צג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बताता है कि Overbright चालू है या नहीं, और हर डिस्प्ले का स्तर क्या है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Javlja je li Overbright uključen i razinu svakog zaslona."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megmondja, hogy be van-e kapcsolva az Overbright, és mi az egyes kijelzők szintje."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberi tahu apakah Overbright menyala, dan level setiap layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica se Overbright è attivo e il livello di ogni schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbrightがオンかどうかと、各ディスプレイのレベルを返します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overbright가 켜져 있는지와 각 디스플레이의 레벨을 알려 줍니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberitahu sama ada Overbright hidup, dan tahap setiap paparan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forteller om Overbright er på, og nivået på hver skjerm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geeft aan of Overbright is ingeschakeld en wat het niveau van elk beeldscherm is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informuje, czy Overbright jest włączony, oraz podaje poziom każdego wyświetlacza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informa se o Overbright está ativado e o nível de cada tela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica se o Overbright está ativado e o nível de cada monitor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arată dacă Overbright este activat și nivelul fiecărui afișaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщает, включён ли Overbright и какой уровень у каждого дисплея."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zistí, či je Overbright zapnuté, a úroveň každého displeja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pove, ali je Overbright vklopljen, in raven vsakega zaslona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar om Overbright är på och vilken nivå varje skärm har."
          }
        },
        "th" : {
