    "Sets the extra brightness of a display, or of every display. Each display stops at its own limit." : {
      "comment" : "Shortcuts app: description of Set Extra Brightness.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيّن الإضاءة الإضافية لشاشة واحدة أو لكل الشاشات. وتتوقف كل شاشة عند حدها الخاص."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la brillantor extra d’una pantalla o de totes. Cada pantalla s’atura al seu propi límit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaví extra jas jednoho nebo všech monitorů. Každý monitor se zastaví na svém vlastním limitu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstiller ekstra lysstyrke for én skærm eller for alle skærme. Hver skærm stopper ved sin egen grænse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt die Zusatzhelligkeit eines Displays oder aller Displays fest. Dabei hält jedes Display seine eigene Grenze ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορίζει την επιπλέον φωτεινότητα μίας ή όλων των οθονών. Κάθε οθόνη σταματά στο δικό της όριο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el brillo extra de una pantalla o de todas. Cada pantalla se detiene en su propio límite."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asettaa yhden tai kaikkien näyttöjen lisäkirkkauden. Kukin näyttö pysähtyy omaan rajaansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Règle la luminosité supplémentaire d’un écran ou de tous les écrans. Chaque écran s’arrête à sa propre limite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מגדיר את הבהירות הנוספת של צג אחד, או של כל הצגים. כל צג נעצר במגבלה שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी एक डिस्प्ले या सभी डिस्प्ले की अतिरिक्त ब्राइटनेस सेट करता है। हर डिस्प्ले अपनी सीमा पर रुकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavlja dodatnu svjetlinu jednog ili svih zaslona. Svaki se zaslon zaustavlja na vlastitoj granici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beállítja egy vagy az összes kijelző extra fényerejét. Minden kijelző a saját határánál áll meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengatur kecerahan ekstra satu layar, atau semua layar. Setiap layar berhenti di batasnya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta la luminosità extra di uno schermo o di tutti. Ogni schermo si ferma al proprio limite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1台またはすべてのディスプレイの追加の輝度を設定します。各ディスプレイはそれぞれの上限で止まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하나 또는 모든 디스플레이의 추가 밝기를 설정합니다. 각 디스플레이는 자체 한도에서 멈춥니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menetapkan kecerahan tambahan satu paparan, atau setiap paparan. Setiap paparan berhenti pada hadnya sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angir ekstra lysstyrke for én skjerm eller for alle skjermer. Hver skjerm stopper ved sin egen grense."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelt de extra helderheid van één of alle beeldschermen in. Elk beeldscherm stopt bij zijn eigen limiet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia dodatkową jasność jednego lub wszystkich wyświetlaczy. Każdy wyświetlacz zatrzymuje się na własnym limicie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define o brilho extra de uma tela ou de todas. Cada tela para no próprio limite."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define o brilho extra de um monitor ou de todos. Cada monitor para no seu próprio limite."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setează luminozitatea suplimentară a unui afișaj sau a tuturor afișajelor. Fiecare afișaj se oprește la propria limită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задаёт дополнительную яркость одного или всех дисплеев. Каждый дисплей останавливается на своём пределе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaví extra jas jedného alebo všetkých displejov. Každý displej sa zastaví na svojom vlastnom limite."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavi dodatno svetlost enega ali vseh zaslonov. Vsak zaslon se ustavi pri svoji omejitvi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställer in extra ljusstyrka för en skärm eller för alla skärmar. Varje skärm stannar vid sin egen gräns."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งค่าความสว่างเพิ่มเติมของจอภาพหนึ่งจอหรือทุกจอ จอภาพแต่ละจอจะหยุดที่ขีดจำกัดของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ekranın ya da tüm ekranların ek parlaklığını ayarlar. Her ekran kendi sınırında durur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задає додаткову яскравість одного або всіх дисплеїв. Кожен дисплей зупиняється на своїй межі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt độ sáng bổ sung cho một hoặc mọi màn hình. Mỗi màn hình dừng ở giới hạn riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
