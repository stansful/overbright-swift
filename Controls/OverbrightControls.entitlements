<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WidgetKit extensions must be sandboxed (ARCHITECTURE.md §7.7, D18). Nothing else: no network, no App Group. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The state channel (D25): read the app's own preferences domain (needs no Team ID). -->
	<key>com.apple.security.temporary-exception.shared-preference.read-only</key>
	<array>
		<string>app.overbright.Overbright</string>
	</array>
</dict>
</plist>
